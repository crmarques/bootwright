---
extends: default

rules:
  line-length: disable
  braces: disable
  comments:
    require-starting-space: true
    min-spaces-from-content: 1
  comments-indentation: disable
  octal-values: disable
  truthy:
    check-keys: false
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1

ignore: |
  .github/
