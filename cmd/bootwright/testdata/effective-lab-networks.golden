apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-networks
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: networks-01
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
      interfaceAttachments:
        - interface: enp1s0
          attachmentRef: lab-guests
        - interface: enp2s0
          attachmentRef: lab-secondary
        - interface: enp3s0
          attachmentRef: lab-routed
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: networks-01.lab.example.test
      - name: ip
        address: 198.51.100.21/24
        interface: enp1s0
      - name: routed
        address: 192.0.2.141/25
        interface: enp3s0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: networks-02
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
      interfaceAttachments:
        - interface: enp1s0
          attachmentRef: lab-guests
        - interface: enp2s0
          attachmentRef: lab-secondary
        - interface: enp3s0
          attachmentRef: lab-routed
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: networks-02.lab.example.test
      - name: ip
        address: 198.51.100.22/24
        interface: enp1s0
      - name: routed
        address: 192.0.2.142/25
        interface: enp3s0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: networks-03
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
      interfaceAttachments:
        - interface: enp1s0
          attachmentRef: lab-guests
        - interface: enp2s0
          attachmentRef: lab-secondary
        - interface: enp3s0
          attachmentRef: lab-routed
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: networks-03.lab.example.test
      - name: ip
        address: 198.51.100.23/24
        interface: enp1s0
      - name: routed
        address: 192.0.2.143/25
        interface: enp3s0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: networks-04
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
      interfaceAttachments:
        - interface: enp1s0
          attachmentRef: lab-guests
        - interface: enp2s0
          attachmentRef: lab-secondary
        - interface: enp3s0
          attachmentRef: lab-routed
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: networks-04.lab.example.test
      - name: ip
        address: 198.51.100.24/24
        interface: enp1s0
      - name: routed
        address: 192.0.2.144/25
        interface: enp3s0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: networks-05
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
      interfaceAttachments:
        - interface: enp1s0
          attachmentRef: lab-guests
        - interface: enp2s0
          attachmentRef: lab-secondary
        - interface: enp3s0
          attachmentRef: lab-routed
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: networks-05.lab.example.test
      - name: ip
        address: 198.51.100.25/24
        interface: enp1s0
      - name: routed
        address: 192.0.2.145/25
        interface: enp3s0
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  machineNetwork:
    - cidr: 198.51.100.0/24
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: enp1s0
        state: up
        type: ethernet
      - ipv4:
          enabled: false
        ipv6:
          enabled: false
        mtu: 1500
        name: enp2s0
        state: up
        type: ethernet
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: enp3s0
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: enp1s0
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-libvirt
spec:
  libvirt:
    machineRef: controller
    uri: qemu:///system
    capacityReserve:
      cpu: 4
      memoryMiB: 8192
      diskGiB: 40
    bmcEmulation:
      bindAddress: 127.0.0.1
      certificateRef: lab-bmc-tls
      port: 8000
      auth:
        credentialsRef: lab-bmc-credentials
    machineProfiles:
      - name: master
        cpu: 8
        memoryMiB: 16384
        diskGiB: 120
        tpm: {}
  networkAttachments:
    - name: lab-guests
      libvirt:
        bridge: virbr-lab
        management: managed
        address: 198.51.100.1/24
        forward: nat
    - name: lab-secondary
      libvirt:
        bridge: virbr-secondary
        management: managed
        address: 203.0.113.1/24
        forward: none
    - name: lab-routed
      libvirt:
        bridge: virbr-routed
        management: managed
        address: 192.0.2.129/25
        forward: none
---
apiVersion: bootwright.io/v1alpha1
kind: Proxy
metadata:
  name: lab-proxy
spec:
  management: managed
  machineRef: controller
  implementation: squid
  bindAddress: 192.0.2.1
  port: 3128
  endpoints:
    - name: ip
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: OpenShiftCluster
metadata:
  name: networks
spec:
  distribution:
    type: openshift
    release:
      version: 4.21.15
      channel: stable-4.21
  install:
    mode: connected
    platform:
      baremetal:
        provisioningNetwork: disabled
    proxy:
      direct: {}
    ntp:
      - serverRef: lab-ntp
        endpointRef: ip
    endpoints:
      api:
        address: 198.51.100.10
        interfaceNetworks: []
        source:
          type: installer
      api-int:
        address: 198.51.100.10
        source:
          type: installer
      ingress:
        address: 198.51.100.11
        interfaceNetworks: []
        source:
          type: installer
    agent:
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
    pullSecretRef: openshift-pull-secret
    nodeSSH:
      keyPairRef: networks-cluster-admin-ssh-key
    additionalTrustBundleRefs: []
  networking:
    ovnKubernetesConfig:
      gatewayConfig:
        routingViaHost: true
        ipForwarding: Global
    secondaryNetworks:
      - name: workloads
        topology: Localnet
        uplink:
          bridge: br-workloads
          interface: enp2s0
        ipam:
          mode: Disabled
        namespaceSelector:
          matchLabels:
            network.example.test/workloads: enabled
    clusterNetwork:
      - cidr: 10.128.0.0/14
        hostPrefix: 23
    serviceNetwork:
      - 172.30.0.0/16
  nodes:
    - name: master-0
      fqdn: master-0.networks.lab.example.test
      role: controlPlane
      machineRef: networks-01
    - name: master-1
      fqdn: master-1.networks.lab.example.test
      role: controlPlane
      machineRef: networks-02
    - name: master-2
      fqdn: master-2.networks.lab.example.test
      role: controlPlane
      machineRef: networks-03
    - name: worker-0
      fqdn: worker-0.networks.lab.example.test
      role: worker
      machineRef: networks-04
    - name: worker-1
      fqdn: worker-1.networks.lab.example.test
      role: worker
      machineRef: networks-05
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddonBinding
metadata:
  name: metallb
spec:
  clusterRef: networks
  packages:
    nmstate:
      subscription:
        channel: example-channel
        startingCSV: kubernetes-nmstate-operator.v0.0.0
        source: redhat-operators
        sourceNamespace: openshift-marketplace
      timeout: 30m
    metallb:
      subscription:
        channel: example-channel
        startingCSV: metallb-operator.v0.0.0
        source: redhat-operators
        sourceNamespace: openshift-marketplace
      timeout: 30m
      pools:
        - name: routed-services
          addresses:
            - 192.0.2.160-192.0.2.167
          autoAssign: true
          l2:
            interface: enp3s0
        - name: services
          addresses:
            - 198.51.100.128-198.51.100.135
          autoAssign: true
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: controller.lab.example.test
      dnsNames:
        - controller.lab.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-credentials
spec:
  type: usernamePassword
  source:
    generated:
      username: admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: localhost
      dnsNames:
        - localhost
      ipAddresses:
        - 127.0.0.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: networks-cluster-admin-ssh-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: networks-cluster-admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: openshift-pull-secret
spec:
  type: dockerConfigJson
  source:
    contextStore: {}
