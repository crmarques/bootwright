implementation: storage-ceph-host-v1
content-digest: 69f54edb5b8407831dc5d5701259f488923a8e79cfca82d0ac148f8bd51aef9e
automation-formats: bootwright.native-plan-v1, ceph-crypto-policy-v1, ceph-device-identities-v1, ceph-host-route-v2, ceph-package-artifacts-v1, ceph-package-complete-v1, ceph-package-decision-v1, ceph-runtime-profile-v3
request-schema:
  cluster struct ceph.ClusterScope
  cluster.ansiblePackageVersion string
  cluster.auxiliary []struct ceph.AuxiliaryReference omitempty
  cluster.auxiliary[].image string
  cluster.auxiliary[].name string
  cluster.bootstrap string
  cluster.callHome string
  cluster.cephadm struct ceph.Tool
  cluster.cephadm.packageVersion string
  cluster.cephadm.path string
  cluster.cluster string
  cluster.clusterKeyRef string
  cluster.clusterNetworks []string
  cluster.clusterSSHTransport string
  cluster.clusterSSHUser string
  cluster.config map[string]map[string]string omitempty
  cluster.controller string
  cluster.fsid string omitempty
  cluster.hosts []struct ceph.Host
  cluster.hosts[].address string
  cluster.hosts[].devices []struct ceph.Device
  cluster.hosts[].devices[].path string
  cluster.hosts[].devices[].rotational bool omitempty
  cluster.hosts[].devices[].serial string
  cluster.hosts[].devices[].sizeBytes int64
  cluster.hosts[].hostKeyRef string omitempty
  cluster.hosts[].knownHosts string omitempty
  cluster.hosts[].labels []string
  cluster.hosts[].location map[string]string
  cluster.hosts[].machine string
  cluster.hosts[].name string
  cluster.hosts[].port int
  cluster.hosts[].sshKeyRef string
  cluster.hosts[].user string
  cluster.image string
  cluster.monIP string
  cluster.nfsGaneshaPackageVersion string omitempty
  cluster.owner string omitempty
  cluster.packageRepository string
  cluster.packages *struct ceph.PackageRequest omitempty
  cluster.packages.licenseAccepted bool
  cluster.packages.packageRepositoryTrustBundleRef string omitempty
  cluster.packages.sources []struct ceph.PackageSource
  cluster.packages.sources[].certificateRef string
  cluster.packages.sources[].host string
  cluster.packages.sources[].media string
  cluster.packages.sources[].mediaSHA256 string omitempty
  cluster.packages.sources[].mediaSize int64 omitempty
  cluster.packages.sources[].profile string
  cluster.packages.sources[].publicationPath string
  cluster.packages.sources[].url string
  cluster.packages.version string
  cluster.publicNetworks []string
  cluster.registry string
  cluster.registryRef string
  cluster.registryTrustBundleRef string omitempty
  cluster.release string
  cluster.services []opaque
  cluster.version string
  host string
  version string
evidence-schema:
  cephadmSHA256 string
  devices []struct ceph.HostDevice
  devices[].deviceID string
  devices[].path string
  devices[].serial string
  fsid string
  gid int
  host string
  image string
  imageID string
  label string
  owner string
  planDigest string
  policySHA256 string
  ready bool
  removed bool
  request string
  route bool
  specializations []string omitempty
  uid int
  version string
