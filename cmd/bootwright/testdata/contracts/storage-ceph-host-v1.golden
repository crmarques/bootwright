  cluster.pool.crushRule string
  cluster.pool.minSize int
  cluster.pool.name string
  cluster.pool.pgNum int
  cluster.pool.size int
  cluster.publicNetworks []string
  cluster.registry string
  cluster.registryRef string
  cluster.services []opaque
  cluster.version string
  host string
  version string
