  cluster.cluster string
  cluster.clusterKeyRef string
  cluster.clusterNetworks []string
  cluster.clusterSSHTransport string
  cluster.clusterSSHUser string
  cluster.config map[string]map[string]string omitempty
  cluster.controller string
  cluster.fsid string omitempty
  cluster.hosts []struct ceph.Host
  cluster.hosts[].address string
  cluster.hosts[].devices []struct ceph.Device
  cluster.hosts[].devices[].path string
  cluster.hosts[].devices[].serial string
  cluster.hosts[].devices[].sizeBytes int64
  cluster.hosts[].hostKeyRef string omitempty
  cluster.hosts[].knownHosts string omitempty
  cluster.hosts[].labels []string
  cluster.hosts[].location map[string]string
  cluster.hosts[].machine string
  cluster.hosts[].name string
  cluster.hosts[].port int
  cluster.hosts[].sshKeyRef string
  cluster.hosts[].user string
  cluster.image string
  cluster.monIP string
