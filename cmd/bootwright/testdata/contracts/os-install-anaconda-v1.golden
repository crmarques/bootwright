implementation: os-install-anaconda-v1
content-digest: dc7aefb84228e396864c4e4587ffbc9acc9eb3d89e4df1540630af031368f3c9
request-version: os-install-anaconda-v1
automation-formats: none
mark-formats: /.bootwright-boot-handoff, bootwright.bootISO, bootwright.owner
proof-ids: .bootwright-tree-identity, /etc/bootwright/cloud-init-instance, /etc/bootwright/registration.json, /etc/bootwright/root-wwn, /etc/bootwright/update.json, bootwright.media, bootwright.seed
fixed-places: .bootwright-satellite.pem.tmp, /etc/bootwright, /etc/rhsm/ca/bootwright-satellite.pem, /run/bootwright, /var/lib/bootwright-hosted, bootwright-network-apply.service
effect-pins:
  os
  private
  public
  /etc/bootwright/install-marker.json
  /etc/bootwright/host-key.pub
  /etc/bootwright/network.yml
  /etc/bootwright/network-marker.json
  300
  proved-installation-disk-boot,replay-safe-unread-registration,bond-permanent-lower-links
  verified-media-default
  prove-physical-target-before-boot-and-media-writes
  private-guestinfo-clone
  pinned-pushed-iso
  anaconda-home-partition-policy
  subscription-package-source
  explicit-repository-proxy-policy
  power-cycled-guest-removal
  linux-discovered-root-installer-guard
  @@BOOTWRIGHT_INSTALLER_UUID@@
request-identity:
  identity.context
  identity.object
  identity.block
  identity.profile
  hostname
  markerPath
  hostKeyPath
  network.documentPath
  network.markerPath
  private.path
  image.path
  target.domain
  target.uri
  target.hardware.rootDevice
  target.hardware.serialNumber
  target.hardware.sizeBytes
  target.hardware.wwn
  placement.machine
