  provider string
  rootVolumeRef *struct substrate.VolumeRef omitempty
  rootVolumeRef.firmware bool omitempty
  rootVolumeRef.storageId string omitempty
  rootVolumeRef.volumeId string omitempty
  version string
evidence-schema:
  absent bool
  addresses []string
  manufacturer string
  model string
  postcondition bool
  power string
  request string
  rootVolume *struct substrate.RootVolumeProof omitempty
  rootVolume.sizeBytes int64
  rootVolume.storageId string
  rootVolume.volumeId string
  rootVolume.wwn string
  serial string
  uuid string
