implementation: substrate-host-libvirt-v1
content-digest: 851ddd4c810c5dd66d8a95e3ceaa91e323f568ea9da0ab54f76904c0b7ae55e3
request-version: substrate-host-libvirt-v3
automation-formats: https://bootwright.io/substrate/v1
mark-formats: Bootwright carrier reload, Bootwright owned VLAN carrier, Bootwright owned VLAN refusal, Bootwright owned readiness barrier, Bootwright owned routing, Description=Bootwright managed network firewall, bootwright.io.context, bootwright.io.network, bootwright.io.provider, bootwright.io.role, bootwright.substrate.libvirt.connection-v1, device-bootwright-, device-bootwright-%s, https://bootwright.io/substrate/v1
proof-ids: none
fixed-places: /etc/bootwright/routing, 90-bootwright-%s-%s-vlan-carrier.conf
effect-pins:
  podman,libvirt-client,libvirt-daemon,libvirt-daemon-driver-network,libvirt-daemon-driver-qemu,libvirt-daemon-driver-storage-core,qemu-img,qemu-kvm-core,swtpm,swtpm-tools
  /var/lib/libvirt/images/bootwright
  bootwright
  virtqemud.service,virtnetworkd.service,virtstoraged.service
  bridge-use-claim
  vlan-refusal-v2
  nm-trunk-legs-v1
  routing-table-v1
  nm-unfrozen-connections-v1
  routing-ruleset-file-v1
  nm-carrier-policy-v1
  /etc/NetworkManager/conf.d
request-identity:
  identity.context
  identity.object
  identity.block
  uri
  poolName
  poolPath
  networks[].name
  networks[].bridge
  firewallReadyUnit
  vlanRefusalUnit
  trunks[].bridge
  trunks[].name
  trunks[].uuid
  legs[].name
  legs[].device
  legs[].uuid
  routing.unit
request-schema:
  firewallReadyUnit string
  identity struct libvirt.Identity
  identity.block string
  identity.context string
  identity.object string
  legs []struct libvirt.Leg omitempty
  legs[].address string
  legs[].device string
  legs[].forward string
  legs[].name string
  legs[].network string
  legs[].trunk string
  legs[].uuid string
  legs[].vlan int
  networks []struct libvirt.Network
  networks[].address string omitempty
  networks[].bridge string
  networks[].forward string omitempty
  networks[].managed bool
  networks[].mtu int omitempty
  networks[].name string
  packages []string
  placement struct machine.Placement
  placement.address string omitempty
  placement.connection string
  placement.knownHostsRef string omitempty
  placement.machine string
  placement.port int omitempty
  placement.privateKeyRef string omitempty
  placement.user string omitempty
  poolName string
  poolPath string
  provisioned bool
  refusedPrefixes []string omitempty
  routing *struct libvirt.Routing omitempty
  routing.forwarding bool
  routing.keptPrefixes []string
  routing.managedDevices []string
  routing.natPrefixes []string
  routing.routed []struct libvirt.RoutedPair
  routing.routed[].from string
  routing.routed[].to string
  routing.unit string
  services []string
  trunks []struct libvirt.Trunk omitempty
  trunks[].bridge string
  trunks[].mac string
  trunks[].name string
  trunks[].uuid string
  uri string
  version string
  vlanRefusalUnit string omitempty
evidence-schema:
  absent bool
  carrierPolicy struct libvirt.CarrierPolicyEvidence
  carrierPolicy.answered bool
  carrierPolicy.definition bool
  carrierPolicy.name string
  carrierPolicy.owned bool
  carrierPolicy.present bool
  connections []struct libvirt.ConnectionEvidence
  connections[].active bool
  connections[].answered bool
  connections[].definition bool
  connections[].device string
  connections[].name string
  connections[].owned bool
  connections[].present bool
  connections[].role string
  connections[].zone string
  connectionsAnswered bool
  directory *bool
  firewallReady struct libvirt.FirewallReadyEvidence
  firewallReady.answered bool
  firewallReady.enabled bool
  firewallReady.name string
  firewallReady.owned bool
  firewallReady.present bool
  firewallReady.ready bool
  firewallReady.state string
  hypervisor bool
  networkManager bool
  networks []struct libvirt.NetworkEvidence
  networks[].answered bool
  networks[].autostart bool
  networks[].bridge bool
  networks[].definition bool
  networks[].managed bool
  networks[].mtu int omitempty
  networks[].name string
  networks[].owned bool
  networks[].state string
  pool string
  poolAnswered bool
  poolAutostart bool
  poolOwned bool
  postcondition bool
  request string
  routing struct libvirt.RoutingEvidence
  routing.answered bool
  routing.enabled bool
  routing.forwarding bool
  routing.loaded bool
  routing.name string
  routing.owned bool
  routing.present bool
  routing.state string
  routing.table string
  services []struct libvirt.ServiceEvidence
  services[].enabled bool
  services[].name string
  services[].state string
  unfrozenConnections []string
  uri bool
  vlanRefusal struct libvirt.VLANRefusalEvidence
  vlanRefusal.answered bool
  vlanRefusal.enabled bool
  vlanRefusal.name string
  vlanRefusal.owned bool
  vlanRefusal.present bool
  vlanRefusal.routes []string
  vlanRefusal.state string
