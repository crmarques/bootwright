implementation: substrate-host-libvirt-v1
content-digest: a76e61d117017004b7289d64b6be5d431bdb02a89462a53a401f0410d0509ed4
request-version: substrate-host-libvirt-v1
automation-formats: https://bootwright.io/substrate/v1
mark-formats: Bootwright owned VLAN refusal, Bootwright owned readiness barrier, Description=Bootwright managed network firewall, https://bootwright.io/substrate/v1
proof-ids: none
fixed-places: none
effect-pins:
  libvirt-client,libvirt-daemon,libvirt-daemon-driver-network,libvirt-daemon-driver-qemu,libvirt-daemon-driver-storage-core,qemu-img,qemu-kvm-core,swtpm,swtpm-tools
  /var/lib/libvirt/images/bootwright
  bootwright
  virtqemud.service,virtnetworkd.service,virtstoraged.service
  bridge-use-claim
  vlan-refusal-v1
request-identity:
  identity.context
  identity.object
  identity.block
  uri
  poolName
  poolPath
  networks[].name
  networks[].bridge
  firewallReadyUnit
  vlanRefusalUnit
request-schema:
  firewallReadyUnit string
  identity struct libvirt.Identity
  identity.block string
  identity.context string
  identity.object string
  networks []struct libvirt.Network
  networks[].address string omitempty
  networks[].bridge string
  networks[].forward string omitempty
  networks[].managed bool
  networks[].mtu int omitempty
  networks[].name string
  packages []string
  placement struct machine.Placement
  placement.address string omitempty
  placement.connection string
  placement.knownHostsRef string omitempty
  placement.machine string
  placement.port int omitempty
  placement.privateKeyRef string omitempty
  placement.user string omitempty
  poolName string
  poolPath string
  provisioned bool
  refusedPrefixes []string omitempty
  services []string
  uri string
  version string
  vlanRefusalUnit string omitempty
evidence-schema:
  absent bool
  directory *bool
  firewallReady struct libvirt.FirewallReadyEvidence
  firewallReady.answered bool
  firewallReady.enabled bool
  firewallReady.name string
  firewallReady.owned bool
  firewallReady.present bool
  firewallReady.ready bool
  firewallReady.state string
  hypervisor bool
  networks []struct libvirt.NetworkEvidence
  networks[].answered bool
  networks[].autostart bool
  networks[].bridge bool
  networks[].definition bool
  networks[].managed bool
  networks[].mtu int omitempty
  networks[].name string
  networks[].owned bool
  networks[].state string
  pool string
  poolAnswered bool
  poolAutostart bool
  poolOwned bool
  postcondition bool
  request string
  services []struct libvirt.ServiceEvidence
  services[].enabled bool
  services[].name string
  services[].state string
  uri bool
  vlanRefusal struct libvirt.VLANRefusalEvidence
  vlanRefusal.answered bool
  vlanRefusal.enabled bool
  vlanRefusal.name string
  vlanRefusal.owned bool
  vlanRefusal.present bool
  vlanRefusal.routes []string
  vlanRefusal.state string
