implementation: storage-ceph-core-v3
content-digest: bb5739d38bd37607aa86c3f1e2a70dd61f2ef96b3cab3ffd778a207128f05556
automation-formats: -custody-v1, ceph-bootstrap-recovery-v1, ceph-bootstrap-state-v1, ceph-client-auth-v1, ceph-cluster-device-identities-v1, ceph-dashboard-port-attempt-v1, ceph-dashboard-port-repair-v1, ceph-dashboard-redeploy-v1, ceph-dashboard-user-v1, ceph-device-identities-v1, ceph-filesystem-attempt-v1, ceph-host-cache-v1, ceph-native-teardown-v1, ceph-osd-device-intent-v1, ceph-policy-attempt-v1, ceph-pool-attempt-v2, ceph-rbd-image-attempt-v1, ceph-registry-v1, ceph-runtime-profile-v3, ceph-service-inputs-v1, ceph-subvolume-attempt-v1, ceph-subvolume-group-attempt-v1, ceph-tunnel-custody-v1, ceph-tunnel-redeploy-v1, ceph-tunnel-relabel-v1, ceph-tunnel-stage-v1, ceph-tunnel-v2
request-schema:
  action string
  ansiblePackageVersion string
  bootstrap string
  callHome string
  cephadm struct ceph.Tool
  cephadm.packageVersion string
  cephadm.path string
  client *struct ceph.Client omitempty
  client.access string
  client.name string
  client.pool string
  cluster string
  clusterKeyRef string
  clusterNetworks []string
  clusterSSHTransport string
  clusterSSHUser string
  config map[string]map[string]string omitempty
  controller string
  delegated []struct ceph.DelegatedService omitempty
  delegated[].hosts []string
  delegated[].name string
  filesystem *struct ceph.Filesystem omitempty
  filesystem.activeCount int
  filesystem.dataPools []string
  filesystem.defaultDataPool string
  filesystem.groups []struct ceph.FilesystemGroup
  filesystem.groups[].gid int
  filesystem.groups[].mode string
  filesystem.groups[].name string
  filesystem.groups[].pool string
  filesystem.groups[].sizeBytes int64
  filesystem.groups[].uid int
  filesystem.mdsService string
  filesystem.metadataPool string
  filesystem.name string
  filesystem.standbyCountWanted int
  filesystem.standbyReplay bool
  fsid string omitempty
  hosts []struct ceph.Host
  hosts[].address string
  hosts[].devices []struct ceph.Device
  hosts[].devices[].path string
  hosts[].devices[].serial string
  hosts[].devices[].sizeBytes int64
  hosts[].hostKeyRef string omitempty
  hosts[].knownHosts string omitempty
  hosts[].labels []string
  hosts[].location map[string]string
  hosts[].machine string
  hosts[].name string
  hosts[].port int
  hosts[].sshKeyRef string
  hosts[].user string
  image string
  monIP string
  nfsGaneshaPackageVersion string omitempty
  owner string omitempty
  packageRepository string
  packages *struct ceph.PackageRequest omitempty
  packages.licenseAccepted bool
  packages.sources []struct ceph.PackageSource
  packages.sources[].certificateRef string
  packages.sources[].host string
  packages.sources[].media string
  packages.sources[].mediaSHA256 string omitempty
  packages.sources[].mediaSize int64 omitempty
  packages.sources[].profile string
  packages.sources[].publicationPath string
  packages.sources[].url string
  packages.version string
  policy *struct ceph.Policy omitempty
  policy.deviceClass string
  policy.failureDomain string
  policy.name string
  policy.root string
  policy.rule string
  policy.size int
  pool *struct ceph.Pool omitempty
  pool.application string
  pool.autoscale struct ceph.PoolAutoscale
  pool.autoscale.bulk bool
  pool.autoscale.maxPGs int
  pool.autoscale.minPGs int
  pool.autoscale.mode string
  pool.autoscale.targetBytes int64
  pool.autoscale.targetRatio string
  pool.compression struct ceph.PoolCompression
  pool.compression.algorithm string
  pool.compression.maxBlob int64
  pool.compression.minBlob int64
  pool.compression.mode string
  pool.compression.requiredRatio string
  pool.crushRule string
  pool.erasure *struct ceph.PoolErasure omitempty
  pool.erasure.codingChunks int
  pool.erasure.dataChunks int
  pool.erasure.deviceClass string
  pool.erasure.failureDomain string
  pool.erasure.plugin string
  pool.erasure.profile string
  pool.erasure.profileDefaults map[string]string
  pool.erasure.root string
  pool.erasure.stripeUnit int
  pool.erasure.technique string
  pool.filesystem string
  pool.minSize int
  pool.name string
  pool.overwrites bool
  pool.pgNum int
  pool.quota struct ceph.PoolQuota
  pool.quota.maxBytes int64
  pool.quota.maxObjects int64
  pool.role string
  pool.size int
  pool.type string
  publicNetworks []string
  rbd *struct ceph.RBDImage omitempty
  rbd.dataPool string
  rbd.features []string
  rbd.name string
  rbd.pool string
  rbd.sizeBytes int64
  registry string
  registryRef string
  release string
  services []opaque
  subvolume *struct ceph.Subvolume omitempty
  subvolume.filesystem string
  subvolume.gid int
  subvolume.group string
  subvolume.mode string
  subvolume.name string
  subvolume.pool string
  subvolume.sizeBytes int64
  subvolume.uid int
  version string
evidence-schema:
  action string
  client string
  dashboard struct ceph.DashboardEvidence
  dashboard.certificateSHA256 string
  dashboard.reachable bool
  dashboard.url string
  exists bool
  fsid string
  health string
  hosts []string
  mgrActive string
  mgrStandbys []string
  monAddrs []struct ceph.MonitorAddress
  monAddrs[].address string
  monAddrs[].host string
  monitors []string
  osds []struct ceph.OSDEvidence
  osds[].host string
  osds[].id int
  osds[].path string
  osds[].uuid string
  owned bool
  owner string
  partial bool
  ready bool
  removed bool
  request string
  resource struct ceph.ResourceEvidence
  resource.id string
  resource.path string
  version string
