automation-formats: none
request-schema:
  bindings []struct ceph.SMBBinding
  bindings[].path string
  bindings[].secretRef string
  cluster string
  clusterIDs []string omitempty
  controller string
  id string
  images []struct ceph.SMBImage omitempty
  images[].image string
  images[].name string
  machines []string
  native opaque
  object string
  resourceType string
  scope opaque omitempty
  service *struct ceph.SMBService omitempty
  service.clustered bool
  service.hosts []string
  service.name string
  version string
evidence-schema:
  daemons []struct ceph.SMBDaemon
  daemons[].host string
  daemons[].name string
  daemons[].service string
  exists bool
  fsid string
  owned bool
  owner string
  partial bool
  ready bool
  removed bool
  request string
  resource string
  version string
