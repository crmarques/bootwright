request-schema:
  bindings []struct ceph.ServiceBinding
  bindings[].path string
  bindings[].secretRef string
  bindings[].serviceRef string
  cluster string
  controller string
  document opaque
  gateway struct ceph.SignOnGateway
  gateway.count int64
  gateway.endpoint string omitempty
  gateway.grafana bool omitempty
  gateway.hosts []string
  gateway.port int64
  gateway.virtualIP string omitempty
  hostSecretRefs []string
  image string
  machines []string
  object string
  provider struct ceph.SignOnProvider
  provider.issuerURL string
  provider.name string
  provider.trustBundle bool
  version string
evidence-schema:
  action string
  client string
  daemons []struct ceph.UnitDaemon
  daemons[].host string
  daemons[].name string
  daemons[].service string
  dashboard struct ceph.DashboardEvidence
  dashboard.certificateSHA256 string
  dashboard.reachable bool
  dashboard.url string
  endpoint struct ceph.EndpointEvidence
  endpoint.certificateSHA256 string
  endpoint.reachable bool
  exists bool
  fsid string
  health string
  hosts []string
  incarnation string
  inventory *struct ceph.InventoryEvidence omitempty
  inventory.omitted int
  inventory.osds []struct ceph.OSDEvidence
  inventory.osds[].host string
  inventory.osds[].id int
  inventory.osds[].path string
  inventory.osds[].uuid string
  inventory.pools []struct ceph.PoolEvidence
  inventory.pools[].applications []string
  inventory.pools[].autoscale string
  inventory.pools[].maxBytes int64
  inventory.pools[].maxObjects int64
  inventory.pools[].minSize int
  inventory.pools[].name string
  inventory.pools[].size int
  inventory.pools[].type string
  mgrActive string
  mgrStandbys []string
  monAddrs []struct ceph.MonitorAddress
  monAddrs[].address string
  monAddrs[].host string
  monitors []string
  osds []struct ceph.OSDEvidence
  osds[].host string
  osds[].id int
  osds[].path string
  osds[].uuid string
  owned bool
  owner string
  partial bool
  pool *struct ceph.PoolEvidence omitempty
  pool.applications []string
  pool.autoscale string
  pool.maxBytes int64
  pool.maxObjects int64
  pool.minSize int
  pool.name string
  pool.size int
  pool.type string
  readiness struct ceph.ReadinessEvidence
  readiness.checks []string
  readiness.filesystems []string
  readiness.license string
  readiness.pgs struct ceph.PGEvidence
  readiness.pgs.clean int64
  readiness.pgs.total int64
  readiness.pools []string
  readiness.scoped []string
  readiness.unnamed bool
  ready bool
  removed bool
  request string
  resource struct ceph.ResourceEvidence
  resource.id string
  resource.path string
  specializations []string omitempty
  sso string
  stretch *struct ceph.StretchEvidence omitempty
  stretch.enabled bool
  stretch.stage string
  version string
