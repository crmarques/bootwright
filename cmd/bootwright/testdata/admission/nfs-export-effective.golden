apiVersion: bootwright.io/v1alpha1
kind: StorageNFSExport
metadata:
  name: acceptance-nfs
spec:
  clusterRef: ceph-multidc-01
  serviceID: acceptance-nfs
  filesystemRef: odf-cephfs
  native:
    access_type: RO
    clients:
      - access_type: RW
        addresses:
          - 192.0.2.0/24
        squash: root_squash
    fsal:
      cmount_path: /
      fs_name: odf-cephfs
      name: CEPH
    path: /
    protocols:
      - 4
    pseudo: /acceptance
    security_label: true
    squash: no_root_squash
    transports:
      - TCP
