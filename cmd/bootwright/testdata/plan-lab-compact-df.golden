  {
    "id": "addon-fdf-compact",
    "stage": "add-ons",
    "dependencies": [
      "ceph-consumer-compact-storage",
      "cluster-install-compact",
      "cluster-media-compact"
    ],
    "impacts": [
      "install-addon fdf compact"
    ],
    "request": {
      "binding": "compact-data-foundation",
      "budgetSeconds": 3600,
      "cluster": "compact",
      "descriptor": "",
      "package": "fdf",
      "placement": {
        "connection": "local",
        "machine": "controller"
      },
      "placementNamespaces": [],
      "producedInputs": [
        {
          "kind": "OpenShiftCluster",
          "object": "compact",
          "output": "kubeconfig"
        },
        {
          "kind": "CephConsumer",
          "object": "compact-storage",
          "output": "external-details"
        }
      ],
      "program": {
        "checks": [
          {
            "csvSucceeded": {
              "csv": "odf-operator.v4.20.0",
              "namespace": "openshift-storage",
              "subscription": "odf-operator"
            }
          },
          {
            "statusPhase": {
              "apiVersion": "ocs.openshift.io/v1",
              "kind": "StorageCluster",
              "name": "ocs-external-storagecluster",
              "namespace": "openshift-storage",
              "namespaced": true,
              "path": "",
              "values": [
                "Ready"
              ]
            }
          },
          {
            "condition": {
              "apiVersion": "ocs.openshift.io/v1",
              "kind": "StorageCluster",
              "name": "ocs-external-storagecluster",
              "namespace": "openshift-storage",
              "namespaced": true,
              "status": "True",
              "type": "ReconcileComplete"
            }
          },
          {
            "statusPhase": {
              "apiVersion": "noobaa.io/v1alpha1",
              "kind": "NooBaa",
              "name": "noobaa",
              "namespace": "openshift-storage",
              "namespaced": true,
              "path": "",
              "values": [
                "Ready"
              ]
            }
          },
          {
            "resourceExists": {
              "apiVersion": "storage.k8s.io/v1",
              "kind": "StorageClass",
              "name": "ocs-external-storagecluster-ceph-rbd",
              "namespace": "",
              "namespaced": false
            }
          },
          {
            "resourceExists": {
              "apiVersion": "storage.k8s.io/v1",
              "kind": "StorageClass",
              "name": "ocs-external-storagecluster-cephfs",
              "namespace": "",
              "namespaced": false
            }
          },
          {
            "resourceExists": {
              "apiVersion": "storage.k8s.io/v1",
              "kind": "StorageClass",
              "name": "openshift-storage.noobaa.io",
              "namespace": "",
              "namespaced": false
            }
          },
          {
            "resourceExists": {
              "apiVersion": "storage.k8s.io/v1",
              "kind": "StorageClass",
              "name": "ocs-external-storagecluster-ceph-rgw",
              "namespace": "",
              "namespaced": false
            }
          },
          {
            "statusPhase": {
              "apiVersion": "operators.coreos.com/v1alpha1",
              "kind": "CatalogSource",
              "name": "isf-data-foundation-catalog",
              "namespace": "openshift-marketplace",
              "namespaced": true,
              "path": "status.connectionState.lastObservedState",
              "values": [
                "READY"
              ]
            }
