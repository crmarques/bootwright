apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: physical-3-nodes-ceph
spec:
  domains:
    base: metal.example.test
    machines: metal.example.test
    clusters: metal.example.test
    containerClusters: metal.example.test
    storageClusters: metal.example.test
  storageClusters:
    - ceph-lab
  remoteMachinesAccessKey:
    keyRef: bootwright-machine-key
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Entitlement
metadata:
  name: ibm-ceph
spec:
  type: ibm-storage-ceph
  registry:
    url: cp.icr.io
    credentialsRef: ibm-registry
  license:
    accept: true
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  capabilities:
    - container-runtime
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.metal.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: metal-01
spec:
  capabilities:
    - ceph-node
  substrate:
    providerRef: lab-metal
  hardware:
    eraseOnRemoval:
      method: logicalOverwrite
      targets:
        - deviceName: /dev/disk/by-id/wwn-0x6000000000000001
          wwn: "0x6000000000000001"
          serialNumber: SYNTHETIC-ROOT-01
          sizeBytes: 53687091200
        - deviceName: /dev/disk/by-id/wwn-0x5000000000000001
          wwn: "0x5000000000000001"
          serialNumber: SYNTHETIC-CEPH-01
          sizeBytes: 107374182400
    nics:
      - name: eno1
        macAddress: 52:54:00:9a:1b:01
    management:
      bmc:
        address: https://bmc-01.metal.example.test/redfish/v1/Systems/1
        protocol: redfish
        credentialsRef: lab-bmc-credentials
        tls:
          verify: true
          trustBundleRef: lab-bmc-ca
        virtualMedia:
          tls:
            trust: import-certificate
            removeCertificateAfterBoot: false
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      hostKeyRef: metal-01-host-key
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
      rootDeviceHints:
        deviceName: /dev/disk/by-id/wwn-0x6000000000000001
  proxy:
    direct: {}
  network:
    configRef: lab-metal
    attachmentRef: lab-metal
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: metal-01.metal.example.test
      - name: ip
        address: 198.51.100.11/24
        interface: eno1
    interfaceBinding:
      - nicRef: eno1
        interfaceName: eno1
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: metal-02
spec:
  capabilities:
    - ceph-node
  substrate:
    providerRef: lab-metal
  hardware:
    eraseOnRemoval:
      method: logicalOverwrite
      targets:
        - deviceName: /dev/disk/by-id/wwn-0x6000000000000002
          wwn: "0x6000000000000002"
          serialNumber: SYNTHETIC-ROOT-02
          sizeBytes: 53687091200
        - deviceName: /dev/disk/by-id/wwn-0x5000000000000002
          wwn: "0x5000000000000002"
          serialNumber: SYNTHETIC-CEPH-02
          sizeBytes: 107374182400
    nics:
      - name: eno1
        macAddress: 52:54:00:9a:1b:02
    management:
      bmc:
        address: https://bmc-02.metal.example.test/redfish/v1/Systems/1
        protocol: redfish
        credentialsRef: lab-bmc-credentials
        tls:
          verify: true
          trustBundleRef: lab-bmc-ca
        virtualMedia:
          tls:
            trust: import-certificate
            removeCertificateAfterBoot: false
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      hostKeyRef: metal-02-host-key
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
      rootDeviceHints:
        deviceName: /dev/disk/by-id/wwn-0x6000000000000002
  proxy:
    direct: {}
  network:
    configRef: lab-metal
    attachmentRef: lab-metal
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: metal-02.metal.example.test
      - name: ip
        address: 198.51.100.12/24
        interface: eno1
    interfaceBinding:
      - nicRef: eno1
        interfaceName: eno1
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: metal-03
spec:
  capabilities:
    - ceph-node
  substrate:
    providerRef: lab-metal
  hardware:
    eraseOnRemoval:
      method: logicalOverwrite
      targets:
        - deviceName: /dev/disk/by-id/wwn-0x6000000000000003
          wwn: "0x6000000000000003"
          serialNumber: SYNTHETIC-ROOT-03
          sizeBytes: 53687091200
        - deviceName: /dev/disk/by-id/wwn-0x5000000000000003
          wwn: "0x5000000000000003"
          serialNumber: SYNTHETIC-CEPH-03
          sizeBytes: 107374182400
    nics:
      - name: eno1
        macAddress: 52:54:00:9a:1b:03
    management:
      bmc:
        address: https://bmc-03.metal.example.test/redfish/v1/Systems/1
        protocol: redfish
        credentialsRef: lab-bmc-credentials
        tls:
          verify: true
          trustBundleRef: lab-bmc-ca
        virtualMedia:
          tls:
            trust: import-certificate
            removeCertificateAfterBoot: false
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      hostKeyRef: metal-03-host-key
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
      rootDeviceHints:
        deviceName: /dev/disk/by-id/wwn-0x6000000000000003
  proxy:
    direct: {}
  network:
    configRef: lab-metal
    attachmentRef: lab-metal
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: metal-03.metal.example.test
      - name: ip
        address: 198.51.100.13/24
        interface: eno1
    interfaceBinding:
      - nicRef: eno1
        interfaceName: eno1
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: MachineImage
metadata:
  name: rhel-9-8-boot
spec:
  bootMedia: local-media:rhel-9.8-x86_64-boot.iso
---
apiVersion: bootwright.io/v1alpha1
kind: MachineInstallProfile
metadata:
  name: rhel-9-8
spec:
  os:
    family: rhel
    version: "9.8"
    architecture: x86_64
  installer:
    anaconda:
      imageRef: rhel-9-8-boot
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
      packageSource:
        hostedTree:
          fromMedia: local-media:rhel-9.8-x86_64-dvd.iso
          artifactServerEndpoint:
            serverRef: lab-artifacts
            endpointRef: ip-http
  customizations:
    localization:
      language: en_US.UTF-8
      formats: en_US.UTF-8
      keyboard: us
      timezone: Etc/UTC
    ssh:
      passwordAuthentication: false
    packages:
      install:
        - chrony
      excludeDocs: true
      installWeakDeps: false
    services:
      enabled:
        - chronyd
        - sshd
    security:
      selinux:
        mode: enforcing
  proxy:
    direct: {}
  ntp:
    - serverRef: lab-ntp
      endpointRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-metal
spec:
  machineNetwork:
    - cidr: 198.51.100.0/24
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        name: eno1
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          next-hop-address: 198.51.100.1
          next-hop-interface: eno1
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-metal
spec:
  baremetal:
    boot:
      method: redfishVirtualMedia
    defaults:
      bmc:
        credentialsRef: lab-bmc-credentials
        tls:
          verify: true
          trustBundleRef: lab-bmc-ca
        virtualMedia:
          tls:
            trust: import-certificate
            removeCertificateAfterBoot: false
  networkAttachments:
    - name: lab-metal
      baremetal: {}
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: StorageCluster
metadata:
  name: ceph-lab
spec:
  type: ceph
  management: managed
  ceph:
    distribution: ibm
    release: 9.9.2.0
    packageVersion: 20.2.2-349.el9cp
    image:
      base: cp.icr.io/cp/ibm-ceph/ceph-9-rhel10
      version: v9.9.2-26947
    ibm:
      callHome: enabled
      packages:
        source: vendor
    entitlementRef: ibm-ceph
    cephadm:
      addressRef: ip
      ansible:
        packageVersion: 5.0.3-1.el9cp
      clusterSSH:
        user: bootwright
        keyRef: ceph-cluster-key
        transport: verified-tunnel
      bootstrap:
        node: metal-01
        addressRef: ip
    networks:
      publicCIDRs:
        - 198.51.100.0/24
    config:
      global:
        osd_pool_default_min_size: "2"
        osd_pool_default_size: "2"
      osd:
        osd_memory_target: "4294967296"
        osd_memory_target_autotune: "false"
    services:
      - service_type: mon
        placement:
          label: ceph-core
          count: 3
      - service_type: mgr
        placement:
          label: ceph-core
          count: 2
      - service_type: osd
        service_id: data-1
        placement:
          hosts:
            - metal-01.metal.example.test
        spec:
          data_devices:
            paths:
              - /dev/disk/by-id/wwn-0x5000000000000001
      - service_type: osd
        service_id: data-2
        placement:
          hosts:
            - metal-02.metal.example.test
        spec:
          data_devices:
            paths:
              - /dev/disk/by-id/wwn-0x5000000000000002
      - service_type: osd
        service_id: data-3
        placement:
          hosts:
            - metal-03.metal.example.test
        spec:
          data_devices:
            paths:
              - /dev/disk/by-id/wwn-0x5000000000000003
      - service_type: mds
        service_id: files
        placement:
          label: ceph-core
          count: 1
    topology:
      nodes:
        - name: metal-01
          fqdn: metal-01.metal.example.test
          machineRef: metal-01
          labels:
            - ceph-core
        - name: metal-02
          fqdn: metal-02.metal.example.test
          machineRef: metal-02
          labels:
            - ceph-core
        - name: metal-03
          fqdn: metal-03.metal.example.test
          machineRef: metal-03
          labels:
            - ceph-core
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePlacementPolicy
metadata:
  name: ssd-hosts
spec:
  clusterRef: ceph-lab
  ruleName: ssd-hosts
  crushDeviceClass: ssd
  replicated:
    size: 2
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: cephfs-data
spec:
  clusterRef: ceph-lab
  type: replicated
  role: cephfs-data
  replicated:
    size: 2
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: cephfs-metadata
spec:
  clusterRef: ceph-lab
  type: replicated
  role: cephfs-metadata
  replicated:
    size: 2
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: rbd-data
spec:
  clusterRef: ceph-lab
  type: replicated
  role: rbd
  replicated:
    size: 2
    minSize: 2
  autoscale:
    mode: on
---
apiVersion: bootwright.io/v1alpha1
kind: StorageRBDImage
metadata:
  name: rbd-disk
spec:
  clusterRef: ceph-lab
  poolRef: rbd-data
  sizeBytes: 1073741824
---
apiVersion: bootwright.io/v1alpha1
kind: StorageClient
metadata:
  name: rbd-canary
spec:
  clusterRef: ceph-lab
  poolRef: rbd-data
  access: read-write
---
apiVersion: bootwright.io/v1alpha1
kind: StorageFilesystem
metadata:
  name: files
spec:
  clusterRef: ceph-lab
  mdsServiceRef: mds.files
  metadataPoolRef: cephfs-metadata
  dataPoolRefs:
    - name: cephfs-data
      default: true
---
apiVersion: bootwright.io/v1alpha1
kind: StorageSubvolume
metadata:
  name: docs
spec:
  clusterRef: ceph-lab
  filesystemRef: files
  sizeBytes: 1073741824
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-ca
spec:
  type: caBundle
  source:
    generated:
      commonName: artifact-ca.metal.example.test
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      issuerRef: artifact-server-ca
      commonName: controller.metal.example.test
      dnsNames:
        - controller.metal.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 365
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: bootwright-machine-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: bootwright-machine-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: ceph-cluster-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: ceph-cluster-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: ibm-registry
spec:
  type: usernamePassword
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-ca
spec:
  type: caBundle
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-credentials
spec:
  type: usernamePassword
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: metal-01-host-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: metal-01-host-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: metal-02-host-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: metal-02-host-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: metal-03-host-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: metal-03-host-key
