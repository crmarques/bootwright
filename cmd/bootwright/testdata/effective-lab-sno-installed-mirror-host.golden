apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-sno-installed-mirror-host
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  remoteMachinesAccessKey:
    keyRef: bootwright-machine-key
  mirror:
    artifacts:
      serverRef: mirror-artifacts
      endpointRef: ip
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: mirror
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: mirror
      nics:
        - nicRef: enp1s0
          segmentRef: lab-guests
  hardware:
    nics:
      - name: enp1s0
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
    installProfileRef: rhel-9-8-mirror
    install:
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
  proxy:
    direct: {}
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: mirror.lab.example.test
      - name: ip
        address: 198.51.100.20
        interface: enp1s0
    interfaceMatches:
      - interface: enp1s0
        nicRef: enp1s0
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: sno-01
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: sno
      nics:
        - nicRef: enp1s0
          segmentRef: lab-guests
  hardware:
    nics:
      - name: enp1s0
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: sno-01.lab.example.test
      - name: ip
        address: 198.51.100.21
        interface: enp1s0
    interfaceMatches:
      - interface: enp1s0
        nicRef: enp1s0
---
apiVersion: bootwright.io/v1alpha1
kind: MachineImage
metadata:
  name: rhel-9-8-boot
spec:
  bootMedia: local-media:rhel-9.8-x86_64-boot.iso
---
apiVersion: bootwright.io/v1alpha1
kind: MachineInstallProfile
metadata:
  name: rhel-9-8-mirror
spec:
  os:
    family: rhel
    version: "9.8"
    architecture: x86_64
  installer:
    anaconda:
      imageRef: rhel-9-8-boot
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
      packageSource:
        hostedTree:
          fromMedia: local-media:rhel-9.8-x86_64-dvd.iso
          artifactServerEndpoint:
            serverRef: lab-artifacts
            endpointRef: ip-http
  customizations:
    localization:
      language: en_US.UTF-8
      formats: en_US.UTF-8
      keyboard: us
      timezone: Etc/UTC
    ssh:
      passwordAuthentication: false
    packages:
      install:
        - chrony
        - podman
        - qemu-guest-agent
      excludeDocs: true
      installWeakDeps: false
    services:
      enabled:
        - chronyd
        - qemu-guest-agent
        - sshd
    security:
      selinux:
        mode: enforcing
      firewall:
        enabled: false
  proxy:
    direct: {}
  ntp:
    - serverRef: lab-ntp
      endpointRef: ip
  updates:
    policy: none
---
apiVersion: bootwright.io/v1alpha1
kind: Network
metadata:
  name: lab-guests
spec:
  provided: false
  description: The guest network lab-libvirt defines on its host.
  mtu: 1500
  ipv4:
    cidr: 198.51.100.0/24
    gateway: 198.51.100.1
  libvirt:
    providerRef: lab-libvirt
    bridge: virbr-lab
    forward: nat
    hostAddress: 198.51.100.1
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: enp1s0
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: enp1s0
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-libvirt
spec:
  libvirt:
    machineRef: controller
    uri: qemu:///system
    capacityReserve:
      cpu: 1
      memoryMiB: 2048
      diskGiB: 10
    bmcEmulation:
      bindAddress: 127.0.0.1
      certificateRef: lab-bmc-tls
      port: 8000
      auth:
        credentialsRef: lab-bmc-credentials
    machineProfiles:
      - name: mirror
        cpu: 2
        memoryMiB: 4096
        diskGiB: 40
        tpm: {}
      - name: sno
        cpu: 8
        memoryMiB: 16384
        diskGiB: 120
        tpm: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Proxy
metadata:
  name: lab-proxy
spec:
  management: managed
  machineRef: controller
  implementation: squid
  bindAddress: 192.0.2.1
  port: 3128
  endpoints:
    - name: ip
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: mirror-artifacts
spec:
  management: managed
  machineRef: mirror
  bindAddress: 198.51.100.20
  retention: persistent
  tls:
    secretRef: mirror-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 443
  endpoints:
    - name: ip
      listenerRef: https
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: OpenShiftCluster
metadata:
  name: sno
spec:
  distribution:
    type: openshift
    release:
      version: 4.21.15
      channel: stable-4.21
  install:
    mode: connected
    platform:
      none: {}
    proxy:
      direct: {}
    ntp:
      - serverRef: lab-ntp
        endpointRef: ip
    endpoints:
      api:
        address: 198.51.100.21
        interfaceNetworks: []
        source:
          type: node
      api-int:
        address: 198.51.100.21
        source:
          type: node
      ingress:
        address: 198.51.100.21
        interfaceNetworks: []
        source:
          type: node
    agent:
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
    pullSecretRef: openshift-pull-secret
    nodeSSH:
      keyPairRef: sno-cluster-admin-ssh-key
    additionalTrustBundleRefs: []
  networking:
    clusterNetwork:
      - cidr: 10.128.0.0/14
        hostPrefix: 23
    serviceNetwork:
      - 172.30.0.0/16
  nodes:
    - name: master-0
      fqdn: master-0.sno.lab.example.test
      role: controlPlane
      machineRef: sno-01
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: controller.lab.example.test
      dnsNames:
        - controller.lab.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: bootwright-machine-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: bootwright-machine-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-credentials
spec:
  type: usernamePassword
  source:
    generated:
      username: admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: localhost
      dnsNames:
        - localhost
      ipAddresses:
        - 127.0.0.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: mirror-ca
spec:
  type: caBundle
  source:
    generated:
      commonName: Lab mirror authority
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: mirror-tls
spec:
  type: tlsCertificate
  source:
    generated:
      issuerRef: mirror-ca
      commonName: mirror.lab.example.test
      ipAddresses:
        - 198.51.100.20
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: openshift-pull-secret
spec:
  type: dockerConfigJson
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: sno-cluster-admin-ssh-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: sno-cluster-admin
