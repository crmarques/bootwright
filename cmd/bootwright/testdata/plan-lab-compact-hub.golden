[
  {
    "id": "artifact-server-lab-artifacts",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-artifacts-lab-artifacts",
      "create-path /var/lib/bootwright-services/lab-compact-hub/artifact-server/lab-artifacts",
      "open-listener 192.0.2.1:8080",
      "open-listener 192.0.2.1:8443"
    ]
  },
  {
    "id": "controller-prerequisites",
    "stage": "controller",
    "dependencies": [],
    "impacts": [
      "install-host-package iputils",
      "install-host-package libvirt-client",
      "install-host-package libvirt-daemon",
      "install-host-package libvirt-daemon-driver-network",
      "install-host-package libvirt-daemon-driver-qemu",
      "install-host-package libvirt-daemon-driver-storage-core",
      "install-host-package nmstate",
      "install-host-package qemu-img",
      "install-host-package qemu-kvm",
      "install-host-package swtpm",
      "install-host-package swtpm-tools",
      "publish-target-client helm latest",
      "publish-target-client openshift-clients 4.21.15",
      "publish-target-client openshift-install 4.21.15"
    ]
  },
  {
    "id": "dns-lab-dns",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-dns-lab-dns",
      "create-path /var/lib/bootwright-services/lab-compact-hub/dns/lab-dns",
      "open-listener 192.0.2.1:53"
    ]
  },
  {
    "id": "ntp-lab-ntp",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-ntp-lab-ntp",
      "create-path /var/lib/bootwright-services/lab-compact-hub/ntp/lab-ntp",
      "open-listener 192.0.2.1:123"
    ]
  },
  {
    "id": "proxy-lab-proxy",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-proxy-lab-proxy",
      "create-path /var/lib/bootwright-services/lab-compact-hub/proxy/lab-proxy",
      "open-listener 192.0.2.1:3128"
    ]
  },
  {
    "id": "substrate-host-lab-libvirt",
    "stage": "substrates",
    "dependencies": [],
    "impacts": [
      "create-bridge virbr-lab",
      "create-libvirt-network bootwright-lab-compact-hub-lab-guests",
      "create-libvirt-pool bootwright-lab-compact-hub-lab-libvirt-vmedia",
      "create-path /var/lib/libvirt/images/bootwright/lab-compact-hub/providers/lab-libvirt/vmedia"
    ]
  },
  {
    "id": "cluster-media-compact",
    "stage": "clusters",
    "dependencies": [
      "artifact-server-lab-artifacts"
    ],
    "impacts": [
      "create-path /var/lib/bootwright-clusters/lab-compact-hub/compact",
      "publish-content /var/lib/bootwright-services/lab-compact-hub/artifact-server/lab-artifacts/public/private/clusters/compact"
    ]
  },
  {
    "id": "machine-compact-01",
    "stage": "machines",
    "dependencies": [
      "substrate-host-lab-libvirt"
    ],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-bmc-compact-01",
      "create-disk /var/lib/libvirt/images/bootwright/lab-compact-hub/machines/compact-01/root.qcow2",
      "create-libvirt-domain bootwright-lab-compact-hub-compact-01",
      "create-path /var/lib/libvirt/images/bootwright/lab-compact-hub/machines/compact-01",
      "open-listener 127.0.0.1:8000"
    ]
  },
  {
    "id": "machine-compact-02",
    "stage": "machines",
    "dependencies": [
      "substrate-host-lab-libvirt"
    ],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-bmc-compact-02",
      "create-disk /var/lib/libvirt/images/bootwright/lab-compact-hub/machines/compact-02/root.qcow2",
      "create-libvirt-domain bootwright-lab-compact-hub-compact-02",
      "create-path /var/lib/libvirt/images/bootwright/lab-compact-hub/machines/compact-02",
      "open-listener 127.0.0.1:8001"
    ]
  },
  {
    "id": "machine-compact-03",
    "stage": "machines",
    "dependencies": [
      "substrate-host-lab-libvirt"
    ],
    "impacts": [
      "create-container-unit bootwright-lab-compact-hub-bmc-compact-03",
      "create-disk /var/lib/libvirt/images/bootwright/lab-compact-hub/machines/compact-03/root.qcow2",
      "create-libvirt-domain bootwright-lab-compact-hub-compact-03",
      "create-path /var/lib/libvirt/images/bootwright/lab-compact-hub/machines/compact-03",
      "open-listener 127.0.0.1:8002"
    ]
  },
  {
    "id": "cluster-install-compact",
    "stage": "clusters",
    "dependencies": [
      "cluster-media-compact",
      "dns-lab-dns",
      "machine-compact-01",
      "machine-compact-02",
      "machine-compact-03",
      "ntp-lab-ntp"
    ],
    "impacts": [
      "install-cluster compact-01",
      "install-cluster compact-02",
      "install-cluster compact-03",
      "power-on compact-01",
      "power-on compact-02",
      "power-on compact-03"
    ]
  },
  {
