apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: libvirt-2x4-nodes-ceph-multisite
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  storageClusters:
    - primary
    - secondary
  remoteMachinesAccessKey:
    keyRef: bootwright-machine-key
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Entitlement
metadata:
  name: ibm-ceph
spec:
  type: ibmStorageCeph
  registry:
    url: cp.icr.io
    credentialsRef: ibm-registry
  license:
    accept: true
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: client
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: client
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
  proxy:
    direct: {}
  network:
    configRef: primary
    attachmentRef: primary
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: client.lab.example.test
      - name: ip
        address: 198.51.100.30/24
        interface: enp1s0
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: primary-01
spec:
  substrate:
