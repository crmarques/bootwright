      - name: ip
        address: 198.51.100.11/24
        interface: enp1s0
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
