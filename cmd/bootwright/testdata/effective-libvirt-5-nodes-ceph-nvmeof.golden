  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
  proxy:
    direct: {}
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: rhel-05.lab.example.test
      - name: ip
        address: 198.51.100.15/24
