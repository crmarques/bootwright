---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: rhel-04
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: gateway
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      ntp:
        - serverRef: lab-ntp
