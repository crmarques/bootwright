    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: rhel-02.lab.example.test
      - name: ip
        address: 198.51.100.12/24
        interface: enp1s0
  access:
    ssh:
      addressRef: ip
