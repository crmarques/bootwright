  clusterRef: ceph-multidc-01
  placementPolicyRef: stretch-datacenter
  type: replicated
  role: rbd
  application: rbd
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: odf-hub-multidc-02-rbd
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: stretch-datacenter
  type: replicated
  role: rbd
  application: rbd
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: odf-ocp-multidc-01-rbd
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: stretch-datacenter
  type: replicated
  role: rbd
  application: rbd
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: odf-ocp-multidc-02-rbd
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: stretch-datacenter
  type: replicated
  role: rbd
  application: rbd
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: odf-rgw
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: stretch-datacenter
  type: replicated
  role: rgw
  application: rgw
---
apiVersion: bootwright.io/v1alpha1
kind: StorageFilesystem
metadata:
  name: odf-cephfs
spec:
  clusterRef: ceph-multidc-01
  metadataPoolRef: odf-cephfs-metadata
  dataPoolRefs:
    - name: odf-cephfs-data
      default: true
  mds:
    activeCount: 2
    standbyReplay: false
    placement:
      hosts:
        - node-01
        - node-02
        - node-03
        - node-04
        - node-05
        - node-06
  subvolumeGroups: []
---
apiVersion: bootwright.io/v1alpha1
kind: StorageObjectGateway
metadata:
  name: odf-rgw-all
spec:
  clusterRef: ceph-multidc-01
  serviceID: odf.all
  placement:
    hosts:
      - node-01
      - node-02
      - node-03
      - node-04
      - node-05
      - node-06
    countPerHost: 1
  frontendPort: 8080
  config: {}
  endpoint:
    dnsLabel: rgw
    scheme: https
    port: 443
    tls:
      secretRef: ceph-multidc-01-rgw-all-tls
    ingresses:
      - name: ha
        address: 198.51.100.59
        prefixLength: 25
        virtualInterfaceNetworks:
          - 198.51.100.0/25
        placement:
          hosts:
            - node-01
            - node-02
            - node-03
            - node-04
            - node-05
            - node-06
        firstVirtualRouterID: 43
---
apiVersion: bootwright.io/v1alpha1
kind: StorageExport
metadata:
  name: ceph-multidc-01-odf-hub-multidc-01
spec:
  type: dataFoundation
  clusterRef: ceph-multidc-01
  dataFoundation:
    rbdPoolRef: odf-hub-multidc-01-rbd
    filesystemRef: odf-cephfs
    objectGatewayRef: odf-rgw-all
---
apiVersion: bootwright.io/v1alpha1
kind: StorageExport
metadata:
