apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: fusion-data-foundation
spec:
  provides:
    - dataFoundation
  requires: []
  inputs:
    - name: external-storage
      resourceKind: StorageExport
      required: true
      effects:
        - storageExportAttachment: {}
    - name: ibm-entitlement
      secretType: token
      required: true
      effects:
        - globalPullSecretMerge:
            registry: cp.icr.io
            username: cp
  olm:
    namespace:
      name: openshift-storage
      management: managed
      labels:
        openshift.io/cluster-monitoring: "true"
    operatorGroup:
      name: openshift-storage
      targetNamespaces:
        - openshift-storage
    catalogSource:
      name: isf-data-foundation-catalog
      image: icr.io/cpopen/isf-data-foundation-catalog@sha256:2222222222222222222222222222222222222222222222222222222222222222
      displayName: IBM Fusion Data Foundation Catalog
      publisher: IBM
      grpcPodConfig:
        securityContextConfig: restricted
    subscription:
      name: odf-operator
      package: odf-operator
      channel: stable-4.99
      source: isf-data-foundation-catalog
      sourceNamespace: openshift-marketplace
      installPlanApproval: Automatic
    customResources: []
  readiness:
    timeout: 45m
    checks:
      - csvSucceeded:
          namespace: openshift-storage
          subscription: odf-operator
      - condition:
          apiVersion: ocs.openshift.io/v1
          kind: CephCluster
          name: ocs-external-storagecluster
          namespace: openshift-storage
          condition:
            type: Available
            status: "True"
  steps: []
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: nmstate
spec:
  provides:
    - nmstate
  requires: []
  inputs: []
  olm:
    namespace:
      name: openshift-nmstate
      management: managed
      labels: {}
    operatorGroup:
      name: openshift-nmstate
      targetNamespaces:
        - openshift-nmstate
    subscription:
      name: kubernetes-nmstate-operator
      package: kubernetes-nmstate-operator
      channel: stable
      source: redhat-operators
      sourceNamespace: openshift-marketplace
      installPlanApproval: Automatic
    customResources:
      - apiVersion: nmstate.io/v1
        kind: NMState
        metadata:
          name: nmstate
  readiness:
    timeout: 30m
    checks:
      - csvSucceeded:
          namespace: openshift-nmstate
          subscription: kubernetes-nmstate-operator
      - resourceExists:
          apiVersion: nmstate.io/v1
          kind: NMState
          name: nmstate
      - condition:
          apiVersion: apps/v1
          kind: Deployment
          name: nmstate-webhook
          namespace: openshift-nmstate
          condition:
            type: Available
            status: "True"
  steps: []
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: openshift-virtualization
spec:
  provides:
    - kubevirt
  requires: []
  inputs: []
  olm:
    namespace:
      name: openshift-cnv
      management: managed
      labels:
        openshift.io/cluster-monitoring: "true"
    operatorGroup:
      name: kubevirt-hyperconverged-group
      targetNamespaces:
        - openshift-cnv
    subscription:
      name: hco-operatorhub
      package: kubevirt-hyperconverged
      channel: stable
      source: redhat-operators
      sourceNamespace: openshift-marketplace
      installPlanApproval: Automatic
    customResources:
      - apiVersion: hco.kubevirt.io/v1beta1
        kind: HyperConverged
        metadata:
          name: kubevirt-hyperconverged
          namespace: openshift-cnv
  readiness:
    timeout: 30m
    checks:
      - csvSucceeded:
          namespace: openshift-cnv
          subscription: hco-operatorhub
      - condition:
          apiVersion: hco.kubevirt.io/v1beta1
          kind: HyperConverged
          name: kubevirt-hyperconverged
          namespace: openshift-cnv
          condition:
            type: Available
            status: "True"
  steps: []
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: virtual-cluster-network
spec:
  provides: []
  requires:
    - nmstate
  inputs: []
  manifestSet:
    manifests:
      - path: manifests/virtual-cluster-network-namespace.yaml
      - path: manifests/virtual-cluster-network-nncp.yaml
      - path: manifests/virtual-cluster-machine-cudn.yaml
      - path: manifests/virtual-cluster-ceph-public-cudn.yaml
  readiness:
    timeout: 5m
    checks:
      - condition:
          apiVersion: nmstate.io/v1
          kind: NodeNetworkConfigurationPolicy
          name: multidc-virtual-cluster-localnet
          condition:
            type: Available
            status: "True"
      - resourceExists:
          apiVersion: k8s.ovn.org/v1
          kind: ClusterUserDefinedNetwork
          name: multidc-virtual-cluster-machine
      - resourceExists:
          apiVersion: k8s.cni.cncf.io/v1
          kind: NetworkAttachmentDefinition
          name: multidc-virtual-cluster-machine
          namespace: bootwright-multidc-virtual-clusters
      - resourceExists:
          apiVersion: k8s.ovn.org/v1
          kind: ClusterUserDefinedNetwork
          name: multidc-virtual-cluster-ceph-public
      - resourceExists:
          apiVersion: k8s.cni.cncf.io/v1
          kind: NetworkAttachmentDefinition
          name: multidc-virtual-cluster-ceph-public
          namespace: bootwright-multidc-virtual-clusters
  steps: []
---
