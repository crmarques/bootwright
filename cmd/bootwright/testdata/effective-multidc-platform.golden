      - 192.0.2.0/24
      - 198.51.100.0/24
      - 203.0.113.0/24
  network:
    configRef: ceph-network
    attachmentRef: ceph-network
    installAddressRef: ssh
    addresses:
      - name: fqdn
        address: storage-a-01.example.com
      - name: ssh
        address: 198.51.100.1/25
        interface: bond0.200
      - name: cluster
        address: 203.0.113.1/24
        interface: bond0.300
    interfaceBinding:
      - nicRef: eth0
        interfaceName: eth0
      - nicRef: eth1
        interfaceName: eth1
      - nicRef: eth2
        interfaceName: eth2
      - nicRef: eth3
        interfaceName: eth3
    overrides: {}
  access:
    ssh:
      addressRef: ssh
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
