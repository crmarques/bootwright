apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-services
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  capabilities:
    - container-runtime
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Proxy
metadata:
  name: lab-proxy
spec:
  management: managed
  machineRef: controller
  implementation: squid
  bindAddress: 192.0.2.1
  port: 3128
  endpoints:
    - name: ip
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: controller.lab.example.test
      dnsNames:
        - controller.lab.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 3650
