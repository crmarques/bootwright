apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-vsphere-standalone
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  remoteMachinesAccessKey:
    keyRef: bootwright-machine-key
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: {}
  proxy:
    direct: {}
  network:
    addresses:
      - name: ip
        address: 192.0.2.1
      - name: fqdn
        address: controller.lab.example.test
  access:
    local: {}
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: rhel-clone
spec:
  hardware:
    providerRef: vcenter
    profileRef: clone
    nics:
      - name: ens192
        segmentRef: guests
  os:
    install:
      profileRef: rhel-clone
      hostKeyRef: rhel-clone-host-key
  proxy:
    direct: {}
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: ip
        address: 198.51.100.12
        interface: ens192
      - name: fqdn
        address: rhel-clone.lab.example.test
    interfaceMatches:
      - interface: ens192
        nicRef: ens192
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: rhel-iso
spec:
  hardware:
    providerRef: vcenter
    profileRef: iso
    nics:
      - name: ens192
        segmentRef: guests
  os:
    install:
      profileRef: rhel-iso-profile
      hostKeyRef: rhel-iso-host-key
  proxy:
    direct: {}
  network:
    configRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: ip
        address: 198.51.100.11
        interface: ens192
      - name: fqdn
        address: rhel-iso.lab.example.test
    interfaceMatches:
      - interface: ens192
        nicRef: ens192
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: MachineImage
metadata:
  name: rhel-9-8-boot
spec:
  bootMedia: local-media:rhel-9.8-x86_64-boot.iso
---
apiVersion: bootwright.io/v1alpha1
kind: MachineInstallProfile
metadata:
  name: rhel-clone
spec:
  os:
    family: rhel
    version: "9.8"
    architecture: x86_64
  installer:
    templateClone:
      seed:
        cloudInit:
          growRootFilesystem: true
  customizations:
    services:
      enabled:
        - sshd
  proxy:
    direct: {}
  updates:
    policy: none
---
apiVersion: bootwright.io/v1alpha1
kind: MachineInstallProfile
metadata:
  name: rhel-iso-profile
spec:
  os:
    family: rhel
    version: "9.8"
    architecture: x86_64
  installer:
    anaconda:
      imageRef: rhel-9-8-boot
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
      packageSource:
        hostedTree:
          fromMedia: local-media:rhel-9.8-x86_64-dvd.iso
          artifactServerEndpoint:
            serverRef: lab-artifacts
            endpointRef: ip-http
  customizations:
    services:
      enabled:
        - sshd
  proxy:
    direct: {}
  updates:
    policy: none
---
apiVersion: bootwright.io/v1alpha1
kind: Network
metadata:
  name: lab-guests
spec:
  provided: true
  mtu: 1500
  ipv4:
    cidr: 198.51.100.0/24
    gateway: 198.51.100.1
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: ens192
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: ens192
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: vcenter
spec:
  vsphere:
    vcenters:
      - server: vcenter.example.test
        port: 443
        credentialsRef: vcenter-login
        trustBundleRef: vcenter-ca
    placements:
      - name: lab
        server: vcenter.example.test
        datacenter: /Lab
        computeCluster: /Lab/host/Compute
        datastore: /Lab/datastore/Guests
        folder: /Lab/vm/Guests
        resourcePool: /Lab/host/Compute/Resources
    machineProfiles:
      - name: iso
        cpu: 4
        memoryMiB: 8192
        diskGiB: 60
        placementRef: lab
        dataDisks:
          - name: data
            sizeGiB: 16
      - name: clone
        cpu: 4
        memoryMiB: 8192
        diskGiB: 60
        template: /Lab/vm/Templates/rhel-9-8
        placementRef: lab
  segments:
    - name: guests
      untaggedNetworkRef: lab-guests
      mtu: 1500
      vsphere:
        portgroup: /Lab/network/Guests
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: controller.lab.example.test
      dnsNames:
        - controller.lab.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: bootwright-machine-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: bootwright-machine-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: rhel-clone-host-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: rhel-clone-host-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: rhel-iso-host-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: rhel-iso-host-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: vcenter-ca
spec:
  type: caBundle
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: vcenter-login
spec:
  type: usernamePassword
  source:
    contextStore: {}
