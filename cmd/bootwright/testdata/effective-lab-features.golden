apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-features
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: features-01
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: features-01.lab.example.test
      - name: ip
        address: 198.51.100.21/24
        interface: enp1s0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: features-02
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: features-02.lab.example.test
      - name: ip
        address: 198.51.100.22/24
        interface: enp1s0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: features-03
spec:
  substrate:
    providerRef: lab-libvirt
    libvirt:
      profileRef: master
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: features-03.lab.example.test
      - name: ip
        address: 198.51.100.23/24
        interface: enp1s0
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  machineNetwork:
    - cidr: 198.51.100.0/24
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: enp1s0
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: enp1s0
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-libvirt
spec:
  libvirt:
    machineRef: controller
    uri: qemu:///system
    capacityReserve:
      cpu: 4
      memoryMiB: 8192
      diskGiB: 40
    bmcEmulation:
      bindAddress: 127.0.0.1
      certificateRef: lab-bmc-tls
      port: 8000
      auth:
        credentialsRef: lab-bmc-credentials
    machineProfiles:
      - name: master
        cpu: 8
        memoryMiB: 16384
        diskGiB: 120
        tpm: {}
  networkAttachments:
    - name: lab-guests
      libvirt:
        bridge: virbr-lab
        management: managed
        address: 198.51.100.1/24
        forward: nat
---
apiVersion: bootwright.io/v1alpha1
kind: Proxy
metadata:
  name: lab-proxy
spec:
  management: managed
  machineRef: controller
  implementation: squid
  bindAddress: 192.0.2.1
  port: 3128
  endpoints:
    - name: ip
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: Registry
metadata:
  name: lab-mirror
spec:
  management: external
  url: mirror.example.test
  credentialsRef: mirror-credentials
  trustBundleRef: mirror-ca
---
apiVersion: bootwright.io/v1alpha1
kind: OpenShiftCluster
metadata:
  name: features
spec:
  distribution:
    type: openshift
    release:
      version: 4.21.15
      channel: stable-4.21
  install:
    mode: connected
    platform:
      baremetal:
        provisioningNetwork: disabled
    proxy:
      proxyRef: lab-proxy
      endpointRef: ip
      noProxy:
        - "*.lab.example.test"
    ntp:
      - serverRef: lab-ntp
        endpointRef: ip
    registries:
      mirror:
        registryRef: lab-mirror
      imageDigestSources:
        - source: quay.io/openshift-release-dev/ocp-release
          mirrors:
            - mirror.example.test/ocp-release
        - source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
          mirrors:
            - mirror.example.test/ocp-v4.0-art-dev
    endpoints:
      api:
        address: 198.51.100.10
        interfaceNetworks: []
        source:
          type: installer
      api-int:
        address: 198.51.100.10
        source:
          type: installer
      ingress:
        address: 198.51.100.11
        interfaceNetworks: []
        source:
          type: installer
    agent:
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
    pullSecretRef: openshift-pull-secret
    nodeSSH:
      keyPairRef: features-cluster-admin-ssh-key
    additionalTrustBundleRefs:
      - mirror-ca
  networking:
    clusterNetwork:
      - cidr: 10.128.0.0/14
        hostPrefix: 23
    serviceNetwork:
      - 172.30.0.0/16
  security:
    diskEncryption:
      unlock:
        tpm2: {}
      roles:
        - controlPlane
  nodes:
    - name: master-0
      fqdn: master-0.features.lab.example.test
      role: controlPlane
      machineRef: features-01
    - name: master-1
      fqdn: master-1.features.lab.example.test
      role: controlPlane
      machineRef: features-02
    - name: master-2
      fqdn: master-2.features.lab.example.test
      role: controlPlane
      machineRef: features-03
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: controller.lab.example.test
      dnsNames:
        - controller.lab.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: features-cluster-admin-ssh-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: features-cluster-admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-credentials
spec:
  type: usernamePassword
  source:
    generated:
      username: admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: localhost
      dnsNames:
        - localhost
      ipAddresses:
        - 127.0.0.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: mirror-ca
spec:
  type: caBundle
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: mirror-credentials
spec:
  type: dockerConfigJson
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: openshift-pull-secret
spec:
  type: dockerConfigJson
  source:
    contextStore: {}
