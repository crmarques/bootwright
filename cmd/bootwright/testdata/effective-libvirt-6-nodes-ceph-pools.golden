      - name: ip
        address: 198.51.100.12/24
        interface: nic0
      - name: cluster-ip
        address: 203.0.113.12/24
        interface: nic1
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
