apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: libvirt-6-nodes-ceph-pools
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  storageClusters:
    - ceph-lab
  remoteMachinesAccessKey:
    keyRef: bootwright-machine-key
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Entitlement
metadata:
  name: ibm-ceph
spec:
  type: ibm-storage-ceph
  registry:
    url: cp.icr.io
    credentialsRef: ibm-registry
  license:
    accept: true
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  capabilities:
    - container-runtime
    - libvirt
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: rhel-01
spec:
  capabilities:
    - ceph-node
  substrate:
    providerRef: lab-libvirt
    profileRef: mon-mgr
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
      rootDeviceHints:
        deviceName: /dev/vda
  proxy:
    direct: {}
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: rhel-01.lab.example.test
      - name: ip
        address: 198.51.100.11/24
        interface: nic0
      - name: cluster-ip
        address: 203.0.113.11/24
        interface: nic1
  access:
    ssh:
      addressRef: ip
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: rhel-02
spec:
  capabilities:
    - ceph-node
  substrate:
    providerRef: lab-libvirt
    profileRef: mon-mgr
  os:
    provided: false
    installProfileRef: rhel-9-8
    install:
      ntp:
        - serverRef: lab-ntp
          endpointRef: ip
      rootDeviceHints:
        deviceName: /dev/vda
  proxy:
    direct: {}
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
