---
apiVersion: bootwright.io/v1alpha1
kind: MachineImage
metadata:
  name: rhel-9-8-boot
spec:
  bootMedia: local-media:rhel-9.8-x86_64-boot.iso
---
apiVersion: bootwright.io/v1alpha1
kind: MachineInstallProfile
metadata:
  name: rhel-9-8
spec:
  os:
    family: rhel
    version: "9.8"
    architecture: x86_64
  installer:
    anaconda:
      imageRef: rhel-9-8-boot
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
      packageSource:
        hostedTree:
          fromMedia: local-media:rhel-9.8-x86_64-dvd.iso
          artifactServerEndpoint:
            serverRef: lab-artifacts
            endpointRef: ip-http
  customizations:
    localization:
      language: en_US.UTF-8
      formats: en_US.UTF-8
      keyboard: us
      timezone: Etc/UTC
    ssh:
      passwordAuthentication: false
    packages:
      install:
        - chrony
        - qemu-guest-agent
        - podman
        - lvm2
        - cryptsetup
        - tpm2-tools
        - python3
      excludeDocs: true
      installWeakDeps: false
    repositories:
      configure:
        - id: ibm-storage-ceph-9
          baseURL: https://public.dhe.ibm.com/ibmdl/export/pub/storage/ceph/9/rhel9/x86_64/
          displayName: IBM Storage Ceph 9 packages
          enabled: true
          gpgCheck: true
          gpgKeyURL: https://public.dhe.ibm.com/ibmdl/export/pub/storage/ceph/RPM-GPG-KEY-IBM-CEPH
    services:
      enabled:
        - chronyd
        - qemu-guest-agent
        - sshd
    security:
      selinux:
        mode: enforcing
  proxy:
    direct: {}
  ntp:
    - serverRef: lab-ntp
      endpointRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  machineNetwork:
    - cidr: 198.51.100.0/24
    - cidr: 203.0.113.0/24
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: nic0
        state: up
        type: ethernet
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: nic1
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: nic0
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-libvirt
spec:
  libvirt:
    machineRef: controller
    uri: qemu:///system
    capacityReserve:
      cpu: 1
      memoryMiB: 4096
      diskGiB: 10
    bmcEmulationDefaults:
      enabled: true
      protocol: redfish
      emulator: sushy-tools
      bindAddress: 127.0.0.1
      certificateRef: lab-bmc-tls
      port: 8000
      auth:
        credentialsRef: lab-bmc-credentials
    machineProfiles:
      - name: mon-mgr
        cpu: 4
        memoryMiB: 18432
        diskGiB: 60
        dataDisks:
          - name: ssd-data
            sizeGiB: 40
            media: ssd
          - name: hdd-data
            sizeGiB: 40
            media: hdd
          - name: hdd-db
            sizeGiB: 10
            media: ssd
        tpm: {}
      - name: mon
        cpu: 4
        memoryMiB: 15360
        diskGiB: 60
        dataDisks:
          - name: ssd-data
            sizeGiB: 40
            media: ssd
          - name: hdd-data
            sizeGiB: 40
            media: hdd
          - name: hdd-db
            sizeGiB: 10
            media: ssd
        tpm: {}
      - name: osd
        cpu: 4
        memoryMiB: 12288
        diskGiB: 60
        dataDisks:
          - name: ssd-data
            sizeGiB: 40
            media: ssd
          - name: hdd-data
            sizeGiB: 40
            media: hdd
          - name: hdd-db
            sizeGiB: 10
            media: ssd
        tpm: {}
  networkAttachments:
    - name: lab-guests
      libvirt:
        bridge: virbr-lab
        management: managed
        address: 198.51.100.1/24
        forward: nat
---
apiVersion: bootwright.io/v1alpha1
kind: Proxy
metadata:
  name: lab-proxy
spec:
  management: managed
  machineRef: controller
  implementation: squid
  bindAddress: 192.0.2.1
  port: 3128
  endpoints:
    - name: ip
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: StorageCluster
metadata:
  name: ceph-lab
spec:
  type: ceph
  management: managed
  ceph:
    distribution: ibm
    release: 9.9.2.0
    packageVersion: 20.2.2-349.el9cp
    image:
      base: cp.icr.io/cp/ibm-ceph/ceph-9-rhel10
      version: v9.9.2-26947
    ibm:
      callHome: enabled
      packages:
        source: vendor
    entitlementRef: ibm-ceph
    cephadm:
      addressRef: ip
      ansible:
        packageVersion: 5.0.3-1.el9cp
      clusterSSH:
        user: bootwright
        keyRef: ceph-cluster-key
        transport: verified-tunnel
      bootstrap:
        node: rhel-01
        addressRef: ip
    networks:
      publicCIDRs:
        - 198.51.100.0/24
      clusterCIDRs:
        - 203.0.113.0/24
    config:
      osd:
        osd_memory_target: "4294967296"
        osd_memory_target_autotune: "false"
    services:
      - service_type: mon
        placement:
          label: ceph-mon
          count: 5
      - service_type: mgr
        placement:
          hosts:
            - rhel-01.lab.example.test
            - rhel-02.lab.example.test
      - service_type: osd
        service_id: ssd
        placement:
          label: ceph-storage
        spec:
          data_devices:
            paths:
              - /dev/sda
          encrypted: true
      - service_type: osd
        service_id: hdd
        placement:
          label: ceph-storage
        spec:
          data_devices:
            paths:
              - /dev/sdb
          db_devices:
            paths:
              - /dev/sdc
          encrypted: true
          tpm2: true
    topology:
      nodes:
        - name: rhel-01
          fqdn: rhel-01.lab.example.test
          machineRef: rhel-01
          labels:
            - ceph-storage
            - ceph-mon
        - name: rhel-02
          fqdn: rhel-02.lab.example.test
          machineRef: rhel-02
          labels:
            - ceph-storage
            - ceph-mon
        - name: rhel-03
          fqdn: rhel-03.lab.example.test
          machineRef: rhel-03
          labels:
            - ceph-storage
            - ceph-mon
        - name: rhel-04
          fqdn: rhel-04.lab.example.test
          machineRef: rhel-04
          labels:
            - ceph-storage
            - ceph-mon
        - name: rhel-05
          fqdn: rhel-05.lab.example.test
          machineRef: rhel-05
          labels:
            - ceph-storage
            - ceph-mon
        - name: rhel-06
          fqdn: rhel-06.lab.example.test
          machineRef: rhel-06
          labels:
            - ceph-storage
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePlacementPolicy
metadata:
  name: ssd-hosts
spec:
  clusterRef: ceph-lab
  failureDomain: host
  ruleName: ssd-hosts
  crushDeviceClass: ssd
  replicated:
    size: 3
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: ec22-data
spec:
  clusterRef: ceph-lab
  type: erasure
  role: rbd
  erasure:
    dataChunks: 2
    codingChunks: 2
    plugin: isa
    crushDeviceClass: hdd
  autoscale:
    mode: on
    pgNumMin: 8
    pgNumMax: 64
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: ec42-data
spec:
  clusterRef: ceph-lab
  type: erasure
  role: rbd
  erasure:
    dataChunks: 4
    codingChunks: 2
    plugin: isa
    crushDeviceClass: hdd
  autoscale:
    mode: on
    pgNumMin: 8
    pgNumMax: 64
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: rbd-headers
spec:
  clusterRef: ceph-lab
  type: replicated
  role: rbd
  replicated:
    size: 3
    minSize: 2
  autoscale:
    mode: on
---
apiVersion: bootwright.io/v1alpha1
kind: StoragePool
metadata:
  name: rbd-replicated
spec:
  clusterRef: ceph-lab
  placementPolicyRef: ssd-hosts
  type: replicated
  role: rbd
  autoscale:
    mode: on
    pgNumMin: 8
    pgNumMax: 64
  quota:
    maxBytes: 10737418240
    maxObjects: 100000
  compression:
    mode: passive
    algorithm: zstd
    requiredRatio: 0.8
    minBlobSize: 8192
    maxBlobSize: 131072
---
apiVersion: bootwright.io/v1alpha1
kind: StorageRBDImage
metadata:
  name: ec22-disk
spec:
  clusterRef: ceph-lab
  poolRef: rbd-headers
  sizeBytes: 1073741824
  dataPoolRef: ec22-data
---
apiVersion: bootwright.io/v1alpha1
kind: StorageRBDImage
metadata:
  name: ec42-disk
spec:
  clusterRef: ceph-lab
  poolRef: rbd-headers
  sizeBytes: 1073741824
  dataPoolRef: ec42-data
---
apiVersion: bootwright.io/v1alpha1
kind: StorageRBDImage
metadata:
  name: replicated-disk
spec:
  clusterRef: ceph-lab
  poolRef: rbd-replicated
  sizeBytes: 1073741824
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: artifact-server-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: controller.lab.example.test
      dnsNames:
        - controller.lab.example.test
      ipAddresses:
        - 192.0.2.1
      validityDays: 3650
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: bootwright-machine-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: bootwright-machine-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: ceph-cluster-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: ceph-cluster-key
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: ibm-registry
spec:
  type: usernamePassword
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-credentials
spec:
  type: usernamePassword
  source:
    generated:
      username: admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: lab-bmc-tls
spec:
  type: tlsCertificate
  source:
    generated:
      commonName: lab-bmc.example.test
      ipAddresses:
        - 127.0.0.1
      validityDays: 365
