apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-kubevirt-external
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: controller.lab.example.test
      - name: ip
        address: 192.0.2.1
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: kubevirt-01
spec:
  substrate:
    providerRef: lab-kubevirt
    kubevirt:
      profileRef: kubevirt
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: kubevirt-01.lab.example.test
      - name: ip
        address: 198.51.100.21/24
        interface: eth0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: kubevirt-02
spec:
  substrate:
    providerRef: lab-kubevirt
    kubevirt:
      profileRef: kubevirt
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: kubevirt-02.lab.example.test
      - name: ip
        address: 198.51.100.22/24
        interface: eth0
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: kubevirt-03
spec:
  substrate:
    providerRef: lab-kubevirt
    kubevirt:
      profileRef: kubevirt
  hardware:
    rootDevice:
      deviceName: /dev/vda
  os:
    provided: false
  network:
    configRef: lab-guests
    attachmentRef: lab-guests
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: kubevirt-03.lab.example.test
      - name: ip
        address: 198.51.100.23/24
        interface: eth0
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  machineNetwork:
    - cidr: 198.51.100.0/24
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: eth0
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: eth0
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-kubevirt
spec:
  kubevirt:
    kubeconfigRef: host-kubeconfig
    namespace: bootwright-guests
    storageClassRef: guest-block-storage
    machineProfiles:
      - name: kubevirt
        cpu: 6
        memoryMiB: 16384
        diskGiB: 120
  networkAttachments:
    - name: lab-guests
      kubevirt:
        networkRef:
          apiGroup: k8s.cni.cncf.io
          kind: NetworkAttachmentDefinition
          name: guest-l2
          namespace: bootwright-guests
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: OpenShiftCluster
metadata:
  name: kubevirt
spec:
  distribution:
    type: openshift
    release:
      version: 4.21.15
      channel: stable-4.21
  install:
    mode: connected
    platform:
      none: {}
    proxy:
      direct: {}
    ntp:
      - serverRef: lab-ntp
        endpointRef: ip
    endpoints:
      api:
        address: 198.51.100.10
        interfaceNetworks: []
        source:
          type: external
      api-int:
        address: 198.51.100.10
        interfaceNetworks: []
        source:
          type: external
      ingress:
        address: 198.51.100.11
        interfaceNetworks: []
        source:
          type: external
    agent: {}
    pullSecretRef: openshift-pull-secret
    nodeSSH:
      keyPairRef: kubevirt-cluster-admin-ssh-key
    additionalTrustBundleRefs: []
  networking:
    clusterNetwork:
      - cidr: 10.128.0.0/14
        hostPrefix: 23
    serviceNetwork:
      - 172.30.0.0/16
  nodes:
    - name: master-0
      fqdn: master-0.kubevirt.lab.example.test
      role: controlPlane
      machineRef: kubevirt-01
    - name: master-1
      fqdn: master-1.kubevirt.lab.example.test
      role: controlPlane
      machineRef: kubevirt-02
    - name: master-2
      fqdn: master-2.kubevirt.lab.example.test
      role: controlPlane
      machineRef: kubevirt-03
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: host-kubeconfig
spec:
  type: opaque
  source:
    contextStore: {}
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: kubevirt-cluster-admin-ssh-key
spec:
  type: sshKeyPair
  source:
    generated:
      keyType: ed25519
      comment: kubevirt-cluster-admin
---
apiVersion: bootwright.io/v1alpha1
kind: Secret
metadata:
  name: openshift-pull-secret
spec:
  type: dockerConfigJson
  source:
    contextStore: {}
