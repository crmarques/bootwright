---
apiVersion: bootwright.io/v1alpha1
kind: MachineImage
metadata:
  name: rhel-9-8-boot
spec:
  bootMedia: local-media:rhel-9.8-x86_64-boot.iso
---
apiVersion: bootwright.io/v1alpha1
kind: MachineInstallProfile
metadata:
  name: rhel-9-8
spec:
  os:
    family: rhel
    version: "9.8"
    architecture: x86_64
  installer:
    anaconda:
      imageRef: rhel-9-8-boot
      redfishVirtualMedia:
        artifactServerEndpoint:
          serverRef: lab-artifacts
          endpointRef: ip-https
      packageSource:
        hostedTree:
          fromMedia: local-media:rhel-9.8-x86_64-dvd.iso
          artifactServerEndpoint:
            serverRef: lab-artifacts
            endpointRef: ip-http
  customizations:
    localization:
      language: en_US.UTF-8
      formats: en_US.UTF-8
      keyboard: us
      timezone: Etc/UTC
    ssh:
      passwordAuthentication: false
    packages:
      install:
        - chrony
        - qemu-guest-agent
        - podman
        - lvm2
        - python3
        - nfs-utils
      excludeDocs: true
      installWeakDeps: false
    repositories:
      configure:
        - id: ibm-storage-ceph-9
          baseURL: https://public.dhe.ibm.com/ibmdl/export/pub/storage/ceph/9/rhel9/x86_64/
          displayName: IBM Storage Ceph 9 packages
          enabled: true
          gpgCheck: true
          gpgKeyURL: https://public.dhe.ibm.com/ibmdl/export/pub/storage/ceph/RPM-GPG-KEY-IBM-CEPH
    services:
      enabled:
        - chronyd
        - qemu-guest-agent
        - sshd
    security:
      selinux:
        mode: enforcing
  proxy:
    direct: {}
  ntp:
    - serverRef: lab-ntp
      endpointRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: NetworkConfig
metadata:
  name: lab-guests
spec:
  machineNetwork:
    - cidr: 198.51.100.0/24
  dns:
    - serverRef: lab-dns
      endpointRef: ip
  nmstate:
    dns-resolver:
      config:
        search:
          - lab.example.test
    interfaces:
      - ipv4:
          dhcp: false
          enabled: true
        ipv6:
          enabled: false
        mtu: 1500
        name: enp1s0
        state: up
        type: ethernet
    routes:
      config:
        - destination: 0.0.0.0/0
          metric: 100
          next-hop-address: 198.51.100.1
          next-hop-interface: enp1s0
          table-id: 254
---
apiVersion: bootwright.io/v1alpha1
kind: InfraProvider
metadata:
  name: lab-libvirt
spec:
  libvirt:
    machineRef: controller
    uri: qemu:///system
    capacityReserve:
      cpu: 1
      memoryMiB: 4096
      diskGiB: 10
    bmcEmulation:
      bindAddress: 127.0.0.1
      certificateRef: lab-bmc-tls
      port: 8000
      auth:
        credentialsRef: lab-bmc-credentials
    machineProfiles:
      - name: h1
        cpu: 4
        memoryMiB: 16384
        diskGiB: 60
        dataDisks:
          - name: ceph-data
            sizeGiB: 60
            media: ssd
        tpm: {}
      - name: h2
        cpu: 4
        memoryMiB: 16384
        diskGiB: 60
        dataDisks:
          - name: ceph-data
            sizeGiB: 60
            media: ssd
        tpm: {}
      - name: h3
        cpu: 4
        memoryMiB: 11264
        diskGiB: 60
        dataDisks:
          - name: ceph-data
            sizeGiB: 60
            media: ssd
        tpm: {}
      - name: h4
        cpu: 4
        memoryMiB: 12288
        diskGiB: 60
        dataDisks:
          - name: ceph-data
            sizeGiB: 60
            media: ssd
        tpm: {}
      - name: h5
        cpu: 4
        memoryMiB: 12288
        diskGiB: 60
        dataDisks:
          - name: ceph-data
            sizeGiB: 60
            media: ssd
        tpm: {}
      - name: h6
        cpu: 4
        memoryMiB: 12288
        diskGiB: 60
        dataDisks:
          - name: ceph-data
            sizeGiB: 60
            media: ssd
        tpm: {}
      - name: client
        cpu: 2
        memoryMiB: 4096
        diskGiB: 40
        tpm: {}
  networkAttachments:
    - name: lab-guests
      libvirt:
        bridge: virbr-lab
        management: managed
        address: 198.51.100.1/24
        forward: nat
---
apiVersion: bootwright.io/v1alpha1
kind: Proxy
metadata:
  name: lab-proxy
spec:
  management: managed
  machineRef: controller
  implementation: squid
  bindAddress: 192.0.2.1
  port: 3128
  endpoints:
    - name: ip
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: DNSServer
metadata:
  name: lab-dns
spec:
  management: managed
  machineRef: controller
  implementation: dnsmasq
  bindAddress: 192.0.2.1
  port: 53
  endpoints:
    - name: ip
      addressRef: ip
  forwarders:
    - 192.0.2.53
---
apiVersion: bootwright.io/v1alpha1
kind: NTPServer
metadata:
  name: lab-ntp
spec:
  management: managed
  machineRef: controller
  implementation: chrony
  bindAddress: 192.0.2.1
  port: 123
  endpoints:
    - name: ip
      addressRef: ip
  upstreamSources:
    - 192.0.2.123
---
apiVersion: bootwright.io/v1alpha1
kind: ArtifactServer
metadata:
  name: lab-artifacts
spec:
  management: managed
  machineRef: controller
  bindAddress: 192.0.2.1
  retention: persistent
  tls:
    secretRef: artifact-server-tls
    minVersion: TLSv1.2
  listeners:
    - name: https
      protocol: https
      port: 8443
    - name: http
      protocol: http
      port: 8080
  endpoints:
    - name: ip-https
      listenerRef: https
      addressRef: ip
    - name: ip-http
      listenerRef: http
      addressRef: ip
---
apiVersion: bootwright.io/v1alpha1
kind: CephCluster
metadata:
  name: ceph-lab
spec:
  management: managed
  distribution:
    ibm:
      callHome: enabled
      packages:
        source: vendor
  release: 9.9.2.0
  packageVersion: 20.2.2-349.el9cp
  image:
    base: cp.icr.io/cp/ibm-ceph/ceph-9-rhel10
    version: v9.9.2-26947
  images:
    haproxy:
      base: cp.icr.io/cp/synthetic/haproxy
      version: qualification-placeholder
    keepalived:
      base: cp.icr.io/cp/synthetic/keepalived
      version: qualification-placeholder
    samba:
      base: cp.icr.io/cp/synthetic/samba
      version: qualification-placeholder
    samba_metrics:
      base: cp.icr.io/cp/synthetic/samba_metrics
      version: qualification-placeholder
  entitlementRef: ibm-ceph
  cephadm:
    addressRef: ip
    ansible:
      packageVersion: 5.0.3-1.el9cp
    clusterSSH:
      user: bootwright
      keyRef: ceph-cluster-key
      transport: verifiedTunnel
    bootstrap:
      nodeRef: rhel-01
      addressRef: ip
  networks:
    publicCIDRs:
      - 198.51.100.0/24
  config:
    osd:
      osd_memory_target: "4294967296"
      osd_memory_target_autotune: "false"
  services:
    - service_type: mon
      placement:
        hosts:
          - rhel-01.lab.example.test
          - rhel-02.lab.example.test
          - rhel-03.lab.example.test
        count: 3
    - service_type: mgr
      placement:
        hosts:
          - rhel-01.lab.example.test
          - rhel-02.lab.example.test
        count: 2
    - service_type: osd
      service_id: data
      placement:
        label: ceph-core
      spec:
        data_devices:
          paths:
            - /dev/sda
    - service_type: mds
      service_id: files
      placement:
        hosts:
          - rhel-01.lab.example.test
          - rhel-02.lab.example.test
        count: 2
    - service_type: nfs
      service_id: shares
      placement:
        hosts:
          - rhel-04.lab.example.test
          - rhel-05.lab.example.test
          - rhel-06.lab.example.test
        count: 2
      spec:
        enable_haproxy_protocol: true
        port: 12049
    - service_type: ingress
      service_id: nfs.shares
      placement:
        hosts:
          - rhel-04.lab.example.test
          - rhel-05.lab.example.test
        count: 2
      spec:
        backend_service: nfs.shares
        enable_haproxy_protocol: true
        frontend_port: 2049
        monitor_port: 9049
        virtual_ip: 198.51.100.51/24
    - service_type: rgw
      service_id: objects
      placement:
        hosts:
          - rhel-03.lab.example.test
          - rhel-06.lab.example.test
        count: 2
      spec:
        rgw_frontend_port: 8443
        ssl: false
    - service_type: ingress
      service_id: rgw.objects
      placement:
        hosts:
          - rhel-04.lab.example.test
          - rhel-05.lab.example.test
        count: 2
      spec:
        backend_service: rgw.objects
        certificate_source: inline
        first_virtual_router_id: 60
        frontend_port: 443
        monitor_port: 9043
        ssl: true
        virtual_ip: 198.51.100.50/24
  serviceBindings:
    - serviceRef: ingress.rgw.objects
      secrets:
        - path: /spec/ssl_cert
          secretRef: rgw-objects-tls
        - path: /spec/ssl_key
          secretRef: rgw-objects-tls
  topology:
    nodes:
      - name: rhel-01
        fqdn: rhel-01.lab.example.test
        machineRef: rhel-01
        labels:
          - ceph-core
      - name: rhel-02
        fqdn: rhel-02.lab.example.test
        machineRef: rhel-02
        labels:
          - ceph-core
      - name: rhel-03
        fqdn: rhel-03.lab.example.test
        machineRef: rhel-03
        labels:
          - ceph-core
      - name: rhel-04
        fqdn: rhel-04.lab.example.test
        machineRef: rhel-04
        labels:
          - ceph-core
      - name: rhel-05
        fqdn: rhel-05.lab.example.test
        machineRef: rhel-05
        labels:
          - ceph-core
      - name: rhel-06
        fqdn: rhel-06.lab.example.test
        machineRef: rhel-06
        labels:
          - ceph-core
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: cephfs-data
spec:
  clusterRef: ceph-lab
  role: cephfsData
  replicated:
    size: 3
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: cephfs-ec
spec:
  clusterRef: ceph-lab
  role: cephfsData
  erasure:
    dataChunks: 2
    codingChunks: 2
    plugin: isa
    technique: reed_sol_van
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: cephfs-metadata
spec:
  clusterRef: ceph-lab
  role: cephfsMetadata
  replicated:
    size: 3
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: CephClient
metadata:
  name: cephfs-canary
spec:
  clusterRef: ceph-lab
  subvolumeRef: cephfs-canary
  access: readWrite
---
apiVersion: bootwright.io/v1alpha1
kind: CephFilesystem
metadata:
  name: files
spec:
  clusterRef: ceph-lab
  mdsServiceRef: mds.files
  metadataPoolRef: cephfs-metadata
  dataPoolRefs:
    - name: cephfs-data
      default: true
    - cephfs-ec
  mds:
    activeCount: 1
    standbyReplay: true
    standbyCountWanted: 1
  subvolumeGroups:
    - name: apps
      poolLayoutRef: cephfs-data
      mode: "750"
    - name: ec
      poolLayoutRef: cephfs-ec
      mode: "750"
---
apiVersion: bootwright.io/v1alpha1
kind: CephSubvolume
metadata:
  name: cephfs-canary
spec:
  clusterRef: ceph-lab
  filesystemRef: files
  group: ec
  sizeBytes: 1073741824
  uid: 2000
  gid: 2000
  mode: "750"
---
apiVersion: bootwright.io/v1alpha1
kind: CephSubvolume
metadata:
  name: docs
spec:
  clusterRef: ceph-lab
  filesystemRef: files
  group: apps
  sizeBytes: 1073741824
  uid: 2000
  gid: 2000
  mode: "750"
---
apiVersion: bootwright.io/v1alpha1
kind: CephSubvolume
metadata:
  name: smb-archive
spec:
  clusterRef: ceph-lab
  filesystemRef: files
  group: ec
  sizeBytes: 1073741824
  uid: 2000
  gid: 2000
  mode: "750"
---
apiVersion: bootwright.io/v1alpha1
kind: CephSubvolume
metadata:
  name: smb-documents
spec:
  clusterRef: ceph-lab
  filesystemRef: files
  group: apps
  sizeBytes: 1073741824
  uid: 2000
  gid: 2000
  mode: "750"
---
apiVersion: bootwright.io/v1alpha1
kind: CephObjectGateway
metadata:
  name: objects
spec:
  clusterRef: ceph-lab
  serviceRef: rgw.objects
  realm: objects
  zoneGroup: objects
  zone: objects
  endpoint:
    fqdn: s3.lab.example.test
---
apiVersion: bootwright.io/v1alpha1
kind: CephObjectUser
metadata:
  name: services-canary
spec:
  clusterRef: ceph-lab
  objectGatewayRef: objects
  displayName: Services qualification
---
apiVersion: bootwright.io/v1alpha1
kind: CephObjectBucket
metadata:
  name: services-canary-bucket
spec:
  clusterRef: ceph-lab
  objectGatewayRef: objects
  ownerRef: services-canary
---
apiVersion: bootwright.io/v1alpha1
kind: CephNFSExport
metadata:
  name: docs
spec:
  clusterRef: ceph-lab
  serviceID: shares
  subvolumeRef: docs
  native:
    access_type: NONE
    clients:
      - access_type: NONE
        addresses:
          - 198.51.100.13
        squash: root_squash
      - access_type: RW
        addresses:
          - 198.51.100.20
        squash: root_squash
    fsal:
      cmount_path: /
      fs_name: files
      name: CEPH
    protocols:
      - 4
    pseudo: /docs
    security_label: true
    squash: root_squash
    transports:
      - TCP
---
apiVersion: bootwright.io/v1alpha1
kind: CephNFSExport
metadata:
  name: objects
spec:
  clusterRef: ceph-lab
  serviceID: shares
  objectUserRef: services-canary
  native:
    access_type: NONE
    clients:
      - access_type: NONE
        addresses:
          - 198.51.100.13
        squash: root_squash
      - access_type: RW
        addresses:
          - 198.51.100.20
        squash: root_squash
    fsal:
      name: RGW
    path: /
    protocols:
      - 4
    pseudo: /objects
    security_label: true
    squash: root_squash
    transports:
      - TCP
---
apiVersion: bootwright.io/v1alpha1
kind: CephSMBResource
metadata:
  name: files-smb
spec:
  clusterRef: ceph-lab
  resourceRefs:
    - files-users
  native:
    auth_mode: user
    cluster_id: files
    clustering: always
    placement:
      count: 2
      hosts:
        - rhel-04.lab.example.test
        - rhel-05.lab.example.test
    resource_type: ceph.smb.cluster
    user_group_settings:
      - ref: files
        source_type: resource
---
apiVersion: bootwright.io/v1alpha1
kind: CephSMBResource
metadata:
  name: files-users
spec:
  clusterRef: ceph-lab
  secrets:
    - path: /values/users/0/password
      secretRef: files-smb-user
  native:
    resource_type: ceph.smb.usersgroups
    users_groups_id: files
    values:
      groups: []
      users:
        - name: smbuser
---
apiVersion: bootwright.io/v1alpha1
kind: CephSMBResource
metadata:
  name: smb-archive
spec:
  clusterRef: ceph-lab
  smbClusterRef: files-smb
  subvolumeRef: smb-archive
