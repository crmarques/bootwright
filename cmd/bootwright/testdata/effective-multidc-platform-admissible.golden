          type: node
      ingress:
        address: 192.0.2.220
        interfaceNetworks: []
        source:
          type: node
    agent: {}
    pullSecretRef: openshift-pull-secret
    nodeSSH:
      keyPairRef: acceptance-sno-cluster-admin-ssh-key
    additionalTrustBundleRefs: []
  networking:
    clusterNetwork:
      - cidr: 10.128.0.0/14
