apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: multidc
spec:
  domains:
    base: example.com
    machines: example.com
    clusters: clusters.example.com
    containerClusters: clusters.example.com
    storageClusters: clusters.example.com
  sites:
    - name: site-a
    - name: site-b
    - name: site-c
  remoteMachinesAccessKey:
    keyRef: bootwright-machine-key
  defaults:
    MachineInstallProfile:
      proxy:
        proxyRef: default
        noProxy:
          - .example.com
          - 192.0.2.0/24
          - 198.51.100.0/24
          - 203.0.113.0/24
      ntp:
        - serverRef: default-01
        - serverRef: default-02
        - serverRef: default-03
    OpenShiftCluster:
      install:
        proxy:
          proxyRef: default
          noProxy:
            - .example.com
            - 192.0.2.0/24
            - 198.51.100.0/24
            - 203.0.113.0/24
        ntp:
          - serverRef: default-01
          - serverRef: default-02
          - serverRef: default-03
        pullSecretRef: openshift-pull-secret
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Entitlement
metadata:
  name: acceptance-redhat-ceph
spec:
  type: redhatCeph
  rhsm:
    management: external
  registry:
    url: registry.redhat.io
    credentialsRef: acceptance-provider-credentials
---
apiVersion: bootwright.io/v1alpha1
kind: Entitlement
metadata:
  name: ceph-entitlement
spec:
  type: ibmStorageCeph
  registry:
    url: cp.icr.io/cp
    credentialsRef: ceph-registry-credentials
  license:
    accept: true
---
apiVersion: bootwright.io/v1alpha1
kind: Entitlement
metadata:
  name: rhel-satellite
spec:
  type: redhatRhel
  rhsm:
    management: managed
    organizationRef: satellite-org
    activationKeyRef: satellite-activation-key
    connectToInsights: false
    satellite:
      hostname: subscription.example.com
      trustBundleRef: satellite-ca-bundle
      contentBaseURL: https://subscription.example.com/pulp/content
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: acceptance-clone-node
spec:
  substrate:
    providerRef: acceptance-vsphere
    vsphere:
      profileRef: clone
  os:
    provided: false
    installProfileRef: acceptance-clone
    install:
      ntp:
        - serverRef: default-01
        - serverRef: default-02
        - serverRef: default-03
  proxy:
    proxyRef: default
    noProxy:
      - .example.com
      - 192.0.2.0/24
      - 198.51.100.0/24
      - 203.0.113.0/24
  network:
    addresses:
      - name: fqdn
        address: acceptance-clone-node.example.com
  access:
    ssh:
      addressRef: fqdn
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: acceptance-hypervisor
spec:
  os:
    provided: true
  proxy:
    direct: {}
  network:
    addresses:
      - name: fqdn
        address: acceptance-hypervisor.example.com
  access:
    ssh:
      addressRef: fqdn
      port: 22
      auth:
        operatorIdentity: {}
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: acceptance-sno-node
spec:
  substrate:
    providerRef: kubevirt-ocp-multidc-01
    kubevirt:
      profileRef: general
      interfaceAttachments:
        - interface: primary
          attachmentRef: hub-vm-machine
        - interface: ceph-public
          attachmentRef: hub-vm-ceph-public
  os:
    provided: false
  network:
    configRef: hub-vm-network
    installAddressRef: primary
    addresses:
      - name: primary
        address: 192.0.2.220/24
        interface: primary
      - name: storage
        address: 198.51.100.120/25
        interface: ceph-public
      - name: fqdn
        address: acceptance-sno-node.example.com
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: controller
spec:
  os:
    provided: true
  proxy:
    proxyRef: default
    noProxy:
      - .example.com
      - 192.0.2.0/24
      - 198.51.100.0/24
      - 203.0.113.0/24
  network:
    addresses:
      - name: fqdn
        address: utility-01.example.com
      - name: dns-alias
        address: utility-01.example.com
      - name: ip
        address: 192.0.2.127
  access:
    local: true
    rootLogin: keep
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: edge-a-01
  labels:
    datacenter: site-a
spec:
  placement:
    site: site-a
  substrate:
    providerRef: bare-metal
    baremetal:
      bmc:
        address: https://bmc-edge-a-01.example.com/redfish/v1/Systems/1
        protocol: redfish
        credentialsRef: ocp-bmc-credentials
        tls:
          verify: true
        virtualMedia:
          tls:
            trust: established
      nics:
        - nicRef: eth0
          macAddress: 02:00:00:00:00:18
        - nicRef: eth2
          macAddress: 02:00:00:00:00:19
  hardware:
    nics:
      - name: eth0
      - name: eth2
    rootDevice:
      deviceName: /dev/sda
  os:
    provided: false
  network:
    configRef: ocp-bare-metal-network
    attachmentRef: ocp-bare-metal-network
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: edge-a-01.example.com
      - name: ip
        address: 192.0.2.3/24
        interface: bond0.100
      - name: ceph-public
        address: 198.51.100.21/25
        interface: bond0.200
    interfaceBinding:
      - nicRef: eth0
        interfaceName: eth0
      - nicRef: eth2
        interfaceName: eth2
    overrides: {}
---
