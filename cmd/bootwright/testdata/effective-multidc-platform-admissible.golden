apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: storage-a-01
spec:
  placement:
    site: site-a
  substrate:
    providerRef: bare-metal
    baremetal:
      bmc:
        address: https://bmc-storage-a-01.example.com/redfish/v1/Systems/1
        protocol: redfish
        credentialsRef: ceph-bmc-credentials
        tls:
          verify: true
        virtualMedia:
          tls:
            trust: established
      nics:
        - nicRef: nic0
          macAddress: 02:00:00:00:00:00
        - nicRef: nic1
          macAddress: 02:00:00:00:00:01
        - nicRef: nic2
          macAddress: 02:00:00:00:00:02
        - nicRef: nic3
          macAddress: 02:00:00:00:00:03
  hardware:
    nics:
      - name: nic0
      - name: nic1
      - name: nic2
      - name: nic3
    rootDevice:
      deviceName: /dev/disk/by-id/wwn-0x5000c500a1b2c311
  os:
    provided: false
    installProfileRef: rhel-ceph-node
    install:
      hostKeyRef: storage-a-01-host-key
      ntp:
        - serverRef: default-01
        - serverRef: default-02
        - serverRef: default-03
  proxy:
    proxyRef: default
    noProxy:
      - .example.com
      - 192.0.2.0/24
      - 198.51.100.0/24
      - 203.0.113.0/24
  network:
    configRef: ceph-network
    attachmentRef: ceph-network
    installAddressRef: ssh
    addresses:
      - name: fqdn
        address: storage-a-01.example.com
      - name: ssh
        address: 198.51.100.1/25
        interface: bond0.200
      - name: cluster
        address: 203.0.113.1/24
        interface: bond0.300
    interfaceBinding:
      - nicRef: nic0
        interfaceName: nic0
      - nicRef: nic1
        interfaceName: nic1
      - nicRef: nic2
        interfaceName: nic2
      - nicRef: nic3
        interfaceName: nic3
    overrides: {}
  access:
    ssh:
      addressRef: ssh
      port: 22
      user: bootwright
      auth:
        privateKeyRef: bootwright-machine-key
    rootLogin: keep
---
