apiVersion: bootwright.io/v1alpha1
kind: CephCluster
metadata:
  name: acceptance-external-storage
spec:
  management: external
---
apiVersion: bootwright.io/v1alpha1
kind: CephCluster
metadata:
  name: ceph-multidc-01
spec:
  management: managed
  distribution:
    ibm:
      callHome: disabled
      packages:
        source: vendor
  release: 9.9.1.2
  packageVersion: 20.2.1-405.el9cp
  packageRepository: https://packages.example.test/ibm-ceph/9/rhel9/x86_64
  packageRepositoryTrustBundleRef: custom-ca-bundle
  packageRepositoryKey: https://packages.example.test/keys/ibm.asc
  image:
    base: cp.icr.io/cp/ibm-ceph/ceph-9-rhel9
    version: sha256:1111111111111111111111111111111111111111111111111111111111111111
  entitlementRef: ceph-entitlement
  cephadm:
    addressRef: ssh
    ansible:
      packageVersion: 5.0.3-1
    clusterSSH:
      user: cephadm
      keyRef: ceph-multidc-01-cephadm-ssh-key
      transport: verifiedTunnel
    bootstrap:
      nodeRef: node-01
      addressRef: ssh
      singleHostDefaults: false
  networks:
    publicCIDRs:
      - 198.51.100.0/25
    clusterCIDRs:
      - 203.0.113.0/24
  security:
    fips:
      enabled: true
    cephx:
      keyType: aes
  config:
    global:
      osd_pool_default_min_size: "2"
      osd_pool_default_size: "2"
  services:
    - service_type: mon
      placement:
        label: ceph-core
        count: 3
    - service_type: mgr
      placement:
        label: ceph-core
        count: 2
    - service_type: osd
      service_id: data
      placement:
        label: ceph-core
      spec:
        data_devices:
          paths:
            - /dev/sdb
    - service_type: mds
      service_id: odf-cephfs
      placement:
        label: ceph-core
        count: 2
    - service_type: rgw
      service_id: objects
      placement:
        label: ceph-core
        count: 2
      spec:
        rgw_frontend_port: 8080
        rgw_realm: objects
        rgw_zone: objects
        rgw_zonegroup: objects
    - service_type: nfs
      service_id: acceptance-nfs
      placement:
        label: ceph-core
        count: 1
    - service_type: nvmeof
      service_id: block
      placement:
        hosts:
          - node-01.ceph-multidc-01.clusters.example.com
          - node-02.ceph-multidc-01.clusters.example.com
      spec:
        group: block
        pool: odf-hub-multidc-01-rbd
  topology:
    nodes:
      - name: node-01
        fqdn: node-01.ceph-multidc-01.clusters.example.com
        machineRef: storage-a-01
        site: site-a
        labels:
          - ceph-core
      - name: node-02
        fqdn: node-02.ceph-multidc-01.clusters.example.com
        machineRef: storage-a-02
        site: site-a
        labels:
          - ceph-core
      - name: node-03
        fqdn: node-03.ceph-multidc-01.clusters.example.com
        machineRef: storage-a-03
        site: site-a
        labels:
          - ceph-core
---
apiVersion: bootwright.io/v1alpha1
kind: CephPlacementPolicy
metadata:
  name: host-spread
spec:
  clusterRef: ceph-multidc-01
  failureDomain: host
  ruleName: host-rule
  replicated:
    size: 2
    minSize: 2
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: objects-data
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: host-spread
  role: rgw
  replicated: {}
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: odf-cephfs-data
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: host-spread
  role: cephfsData
  application: cephfs
  replicated: {}
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: odf-cephfs-metadata
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: host-spread
  role: cephfsMetadata
  application: cephfs
  replicated: {}
---
apiVersion: bootwright.io/v1alpha1
kind: CephPool
metadata:
  name: odf-hub-multidc-01-rbd
spec:
  clusterRef: ceph-multidc-01
  placementPolicyRef: host-spread
  role: rbd
  application: rbd
  replicated: {}
---
apiVersion: bootwright.io/v1alpha1
kind: CephRBDImage
metadata:
  name: acceptance-rbd-image
spec:
  clusterRef: ceph-multidc-01
  poolRef: odf-hub-multidc-01-rbd
  sizeBytes: 10737418240
  features:
    - layering
    - exclusive-lock
---
apiVersion: bootwright.io/v1alpha1
kind: CephClient
metadata:
  name: acceptance-rbd-client
spec:
  clusterRef: ceph-multidc-01
  poolRef: odf-hub-multidc-01-rbd
  access: readOnly
---
apiVersion: bootwright.io/v1alpha1
kind: CephFilesystem
metadata:
  name: odf-cephfs
spec:
  clusterRef: ceph-multidc-01
  mdsServiceRef: mds.odf-cephfs
  metadataPoolRef: odf-cephfs-metadata
  dataPoolRefs:
    - name: odf-cephfs-data
      default: true
  mds:
    activeCount: 1
    standbyCountWanted: 1
  subvolumeGroups:
    - name: csi
      mode: "755"
---
apiVersion: bootwright.io/v1alpha1
kind: CephSubvolume
metadata:
  name: acceptance-subvolume
spec:
  clusterRef: ceph-multidc-01
  filesystemRef: odf-cephfs
  sizeBytes: 10737418240
---
apiVersion: bootwright.io/v1alpha1
kind: CephObjectGateway
metadata:
  name: objects
spec:
  clusterRef: ceph-multidc-01
  serviceRef: rgw.objects
  realm: objects
  zoneGroup: objects
  zone: objects
  pools:
    dataPoolRef: objects-data
  endpoint:
    fqdn: objects.ceph-multidc-01.clusters.example.com
---
apiVersion: bootwright.io/v1alpha1
kind: CephObjectUser
metadata:
  name: app-writer
spec:
  clusterRef: ceph-multidc-01
  objectGatewayRef: objects
  displayName: App writer
---
apiVersion: bootwright.io/v1alpha1
kind: CephObjectBucket
metadata:
  name: app-data
spec:
  clusterRef: ceph-multidc-01
  objectGatewayRef: objects
  ownerRef: app-writer
  policy:
    Statement:
      - Action:
          - s3:GetObject
        Effect: Allow
        Principal:
          AWS:
            - arn:aws:iam:::user/app-reader
        Resource:
          - arn:aws:s3:::app-data/*
        Sid: ReadOnlyForReader
    Version: "2012-10-17"
---
apiVersion: bootwright.io/v1alpha1
kind: CephNFSExport
metadata:
  name: acceptance-nfs
spec:
  clusterRef: ceph-multidc-01
  serviceID: acceptance-nfs
  filesystemRef: odf-cephfs
  native:
    access_type: RO
    clients:
      - access_type: RW
        addresses:
          - 192.0.2.0/24
        squash: root_squash
    fsal:
      cmount_path: /
      fs_name: odf-cephfs
      name: CEPH
    path: /
    protocols:
      - 4
    pseudo: /acceptance
    security_label: true
    squash: no_root_squash
    transports:
      - TCP
---
apiVersion: bootwright.io/v1alpha1
kind: CephSMBResource
metadata:
  name: acceptance-smb
spec:
  clusterRef: ceph-multidc-01
  resourceRefs:
    - acceptance-smb-users
  native:
    auth_mode: user
    cluster_id: acceptance
    placement:
      count: 1
      hosts:
        - node-03.ceph-multidc-01.clusters.example.com
    resource_type: ceph.smb.cluster
    user_group_settings:
      - ref: acceptance
        source_type: resource
---
apiVersion: bootwright.io/v1alpha1
kind: CephSMBResource
metadata:
  name: acceptance-smb-users
spec:
  clusterRef: ceph-multidc-01
  secrets:
    - path: /values/users/0/password
      secretRef: acceptance-smb-user
  native:
    resource_type: ceph.smb.usersgroups
    users_groups_id: acceptance
    values:
      groups: []
      users:
        - name: smbuser
---
apiVersion: bootwright.io/v1alpha1
kind: CephNVMeoFSubsystem
metadata:
  name: acceptance-nvmeof
spec:
  clusterRef: ceph-multidc-01
  serviceRef: nvmeof.block
  nqn: nqn.2016-06.io.example:acceptance
  listeners:
    - host: node-01
    - host: node-02
  hosts:
    - nqn.2014-08.org.nvmexpress:uuid:00000000-0000-4000-8000-000000000001
  namespaces:
    - nsid: 1
      imageRef: acceptance-rbd-image
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: nmstate
spec:
  provides:
    - nmstate
  requires: []
  inputs: []
  olm:
    namespace:
      name: openshift-nmstate
      management: managed
      labels: {}
    operatorGroup:
      name: openshift-nmstate
      targetNamespaces:
        - openshift-nmstate
    subscription:
      name: kubernetes-nmstate-operator
      package: kubernetes-nmstate-operator
      channel: stable
      source: redhat-operators
      sourceNamespace: openshift-marketplace
      installPlanApproval: Automatic
    customResources:
      - apiVersion: nmstate.io/v1
        kind: NMState
        metadata:
          name: nmstate
  readiness:
    timeout: 30m
    checks:
      - csvSucceeded:
          namespace: openshift-nmstate
          subscription: kubernetes-nmstate-operator
      - resourceExists:
          apiVersion: nmstate.io/v1
          kind: NMState
          name: nmstate
      - condition:
          apiVersion: apps/v1
          kind: Deployment
          name: nmstate-webhook
          namespace: openshift-nmstate
          condition:
            type: Available
            status: "True"
  steps: []
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: openshift-virtualization
spec:
  provides:
    - kubevirt
  requires: []
  inputs: []
  olm:
    namespace:
      name: openshift-cnv
      management: managed
      labels:
        openshift.io/cluster-monitoring: "true"
    operatorGroup:
      name: kubevirt-hyperconverged-group
      targetNamespaces:
        - openshift-cnv
    subscription:
      name: hco-operatorhub
      package: kubevirt-hyperconverged
      channel: stable
      source: redhat-operators
      sourceNamespace: openshift-marketplace
      installPlanApproval: Automatic
    customResources:
      - apiVersion: hco.kubevirt.io/v1beta1
        kind: HyperConverged
        metadata:
          name: kubevirt-hyperconverged
          namespace: openshift-cnv
  readiness:
    timeout: 30m
    checks:
      - csvSucceeded:
          namespace: openshift-cnv
          subscription: hco-operatorhub
      - condition:
          apiVersion: hco.kubevirt.io/v1beta1
          kind: HyperConverged
          name: kubevirt-hyperconverged
          namespace: openshift-cnv
          condition:
            type: Available
            status: "True"
  steps: []
---
apiVersion: bootwright.io/v1alpha1
kind: ClusterAddon
metadata:
  name: virtual-cluster-network
spec:
  provides: []
  requires:
    - nmstate
  inputs: []
  manifestSet:
    manifests:
      - path: manifests/virtual-cluster-network-namespace.yaml
      - path: manifests/virtual-cluster-network-nncp.yaml
      - path: manifests/virtual-cluster-machine-cudn.yaml
      - path: manifests/virtual-cluster-ceph-public-cudn.yaml
  readiness:
    timeout: 5m
    checks:
      - condition:
          apiVersion: nmstate.io/v1
          kind: NodeNetworkConfigurationPolicy
          name: multidc-virtual-cluster-localnet
          condition:
            type: Available
            status: "True"
      - resourceExists:
          apiVersion: k8s.ovn.org/v1
          kind: ClusterUserDefinedNetwork
          name: multidc-virtual-cluster-machine
      - resourceExists:
          apiVersion: k8s.cni.cncf.io/v1
          kind: NetworkAttachmentDefinition
          name: multidc-virtual-cluster-machine
          namespace: bootwright-multidc-virtual-clusters
      - resourceExists:
          apiVersion: k8s.ovn.org/v1
          kind: ClusterUserDefinedNetwork
          name: multidc-virtual-cluster-ceph-public
      - resourceExists:
          apiVersion: k8s.cni.cncf.io/v1
          kind: NetworkAttachmentDefinition
          name: multidc-virtual-cluster-ceph-public
          namespace: bootwright-multidc-virtual-clusters
  steps: []
---
