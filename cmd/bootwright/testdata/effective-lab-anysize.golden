apiVersion: bootwright.io/v1alpha1
kind: Environment
metadata:
  name: lab-anysize
spec:
  domains:
    base: lab.example.test
    machines: lab.example.test
    clusters: lab.example.test
    containerClusters: lab.example.test
    storageClusters: lab.example.test
  controller:
    machineRef: controller
---
apiVersion: bootwright.io/v1alpha1
kind: Machine
metadata:
  name: anysize-01
spec:
  capabilities:
    - openshift-node
  substrate:
    providerRef: lab-libvirt
    profileRef: master
  os:
    provided: false
    install:
      rootDeviceHints:
        deviceName: /dev/vda
  network:
    configRef: lab-guests
    interfaceAttachments:
      - interface: enp1s0
        attachmentRef: lab-guests
      - interface: enp2s0
        attachmentRef: lab-guests
      - interface: enp3s0
        attachmentRef: lab-secondary
    installAddressRef: ip
    addresses:
      - name: fqdn
        address: anysize-01.lab.example.test
      - name: ip
        address: 198.51.100.21/24
        interface: bond0
---
