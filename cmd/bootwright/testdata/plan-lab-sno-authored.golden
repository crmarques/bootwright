[
  {
    "id": "artifact-server-lab-artifacts",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-sno-authored-artifacts-lab-artifacts",
      "create-path /var/lib/bootwright-services/lab-sno-authored/artifact-server/lab-artifacts",
      "open-listener 192.0.2.1:8080",
      "open-listener 192.0.2.1:8443"
    ]
  },
  {
    "id": "controller-prerequisites",
    "stage": "controller",
    "dependencies": [],
    "impacts": [
      "install-host-package libvirt-client",
      "install-host-package libvirt-daemon",
      "install-host-package libvirt-daemon-driver-network",
      "install-host-package libvirt-daemon-driver-qemu",
      "install-host-package libvirt-daemon-driver-storage-core",
      "install-host-package nmstate",
      "install-host-package qemu-img",
      "install-host-package qemu-kvm",
      "install-host-package swtpm",
      "install-host-package swtpm-tools",
      "publish-target-client helm latest",
      "publish-target-client openshift-clients 4.21.15",
      "publish-target-client openshift-install 4.21.15"
    ]
  },
  {
    "id": "dns-lab-dns",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-sno-authored-dns-lab-dns",
      "create-path /var/lib/bootwright-services/lab-sno-authored/dns/lab-dns",
      "open-listener 192.0.2.1:53"
    ]
  },
  {
    "id": "ntp-lab-ntp",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-sno-authored-ntp-lab-ntp",
      "create-path /var/lib/bootwright-services/lab-sno-authored/ntp/lab-ntp",
      "open-listener 192.0.2.1:123"
    ]
  },
  {
    "id": "proxy-lab-proxy",
    "stage": "infrastructure-services",
    "dependencies": [],
    "impacts": [
      "create-container-unit bootwright-lab-sno-authored-proxy-lab-proxy",
      "create-path /var/lib/bootwright-services/lab-sno-authored/proxy/lab-proxy",
      "open-listener 192.0.2.1:3128"
    ]
  },
  {
    "id": "substrate-host-lab-libvirt",
    "stage": "substrates",
    "dependencies": [],
    "impacts": [
      "create-bridge virbr-lab",
      "create-libvirt-network bootwright-lab-sno-authored-lab-guests",
      "create-libvirt-pool bootwright-lab-sno-authored-lab-libvirt-vmedia",
      "create-path /var/lib/libvirt/images/bootwright/lab-sno-authored/providers/lab-libvirt/vmedia"
    ]
  },
  {
    "id": "cluster-media-sno",
    "stage": "clusters",
    "dependencies": [
      "artifact-server-lab-artifacts"
    ],
    "impacts": [
      "create-path /var/lib/bootwright-clusters/lab-sno-authored/sno",
      "publish-content /var/lib/bootwright-services/lab-sno-authored/artifact-server/lab-artifacts/public/private/clusters/sno"
    ]
  },
  {
    "id": "machine-sno-01",
    "stage": "machines",
    "dependencies": [
      "substrate-host-lab-libvirt"
    ],
    "impacts": [
      "create-container-unit bootwright-lab-sno-authored-bmc-sno-01",
      "create-disk /var/lib/libvirt/images/bootwright/lab-sno-authored/machines/sno-01/root.qcow2",
      "create-libvirt-domain bootwright-lab-sno-authored-sno-01",
      "create-path /var/lib/libvirt/images/bootwright/lab-sno-authored/machines/sno-01",
      "open-listener 127.0.0.1:8000"
    ]
  },
  {
    "id": "cluster-install-sno",
    "stage": "clusters",
    "dependencies": [
      "cluster-media-sno",
      "dns-lab-dns",
      "machine-sno-01",
      "ntp-lab-ntp"
    ],
    "impacts": [
      "install-cluster sno-01",
      "power-on sno-01"
    ]
  },
  {
