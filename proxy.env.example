# Container-build proxy credentials, sourced inside each network-bound build
# step via BuildKit's `--mount=type=secret,id=proxy`. The values live only in a
# tmpfs mount during the RUN and never land in an image layer, build-arg, or
# `docker history`. Copy this file to `proxy.env` (git-ignored), fill in the
# real credentials, then build with `--secret id=proxy,src=proxy.env`.
export HTTP_PROXY="https://USER:PASSWORD@proxy.mycompany.net"
export HTTPS_PROXY="${HTTP_PROXY}"
export http_proxy="${HTTP_PROXY}"
export https_proxy="${HTTP_PROXY}"
