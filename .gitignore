# Local runtime files
.env
.env.*
*.log
*.tmp
*.bak

# Credentials and cluster access
*kubeconfig*
!internal/clusteraccess/kubeconfig.go
*pull-secret*
*.pem
*.key
*.crt
*.p12
auth/
secrets/
!internal/secrets/
!internal/secrets/*.go

# Generated output
.cache/
.state/
bin/
dist/
build/
out/
rendered/
site/
tmp/
internal/converge/bundle/ansible_bundle.zip
# Committed golden fixtures mirror rendered output trees, so their inner
# rendered/ directories must escape the generated-output rule above.
!internal/render/testdata/golden/**

# Tooling
.DS_Store
.idea/
.vscode/
.codex/
.claude/

# Python bytecode caches (filter-plugin unit tests run with python3 -m unittest)
__pycache__/
*.pyc

# ansible-lint local cache (created by `make ansible-lint-check`)
.ansible/

# Workspace-local generated output.
.bootwright/

# Local scratch area for work-in-progress example fleets (untracked).
# Kept as a sibling of examples/ (not under it) so example-scoped make checks
# never traverse the placeholder templates here.
examples-wip/
