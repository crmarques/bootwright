#!/bin/sh
set -eu
script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BOOTWRIGHT_CACHE_DIR=$("$script_directory/cache-dir")
export BOOTWRIGHT_CACHE_DIR
interpreter="${BOOTWRIGHT_ANSIBLE_CHECK_PYTHON:-}"
if test -z "$interpreter"; then
    interpreter="$BOOTWRIGHT_CACHE_DIR/ansible-check/venv/bin/python"
    if ! test -x "$interpreter"; then
        bootstrap="${BOOTWRIGHT_ANSIBLE_BOOTSTRAP_PYTHON:-}"
        if test -z "$bootstrap"; then
            # The bootstrap needs CPython 3.12 or newer; take the first one on
            # PATH so a host whose default python3 is older still bootstraps.
            for candidate in python3 python3.14 python3.13 python3.12; do
                if command -v "$candidate" >/dev/null 2>&1 &&
                    "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 12))'; then
                    bootstrap=$candidate
                    break
                fi
            done
        fi
        "${bootstrap:-python3}" "$script_directory/tools/ansible_check_bootstrap.py"
    fi
fi
exec "$interpreter" -I "$script_directory/tools/ansible_check.py" "$@"
