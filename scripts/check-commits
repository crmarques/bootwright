#!/bin/sh
# Check every non-merge commit in BASE..HEAD: a Conventional Commit subject and
# a body that says what was verified. Attribution trailers alone are not a body.
#
# A commit whose diff touches a path below one of contract_paths also carries
# one body line "Contract: unchanged", or "Contract: " and the comma-separated
# implementations whose contract it moved, each of whose contract golden
# (cmd/bootwright/testdata/contracts/<implementation>.golden) the same commit
# changes: the author's answer to whether the change alters what an effect is
# (specs/state-reconciliation.md, "Continuation and removal").
#
# A commit that names a moved contract, or changes the value of a Go store
# format version (a non-test `...Version = <integer>` line), makes this build refuse state an
# earlier build left, so it marks its subject with "!" and carries a
# "BREAKING CHANGE: " footer naming what it refuses and the remedy
# (specs/project.md, "Design priorities and non-goals").
set -euf
# The collection's meta, playbooks, plugins and roles, and every package that
# defines a contract version's implementation, request or evidence type, or a
# value a content digest hashes. TestCheckCommitsContractPathsCoverEveryImplementation
# holds the list to the implementations the contract goldens pin.
contract_paths='
ansible/collections/ansible_collections/bootwright/core/meta/
ansible/collections/ansible_collections/bootwright/core/playbooks/
ansible/collections/ansible_collections/bootwright/core/plugins/
ansible/collections/ansible_collections/bootwright/core/roles/
internal/addons/clusterobjects/
internal/addons/instance/
internal/containercluster/agentinstall/
internal/containercluster/networking/
internal/controller/clients/
internal/infrastructureservices/artifactserver/
internal/infrastructureservices/dnsserver/
internal/infrastructureservices/managedservice/
internal/infrastructureservices/ntpserver/
internal/infrastructureservices/proxy/
internal/machine/power/
internal/managedos/installation/
internal/storage/ceph/
internal/substrate/
'
if test "$#" -ne 2; then
    echo "usage: scripts/check-commits BASE HEAD" >&2
    exit 2
fi
touches_contract() {
    for file in $1; do
        for prefix in $contract_paths; do
            case $file in
            "$prefix"*) return 0 ;;
            esac
        done
    done
    return 1
}
status=0
for commit in $(git rev-list --no-merges "$1..$2"); do
    subject=$(git log -1 --format=%s "$commit")
    if ! printf '%s\n' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9-]+\))?!?: [^ ]'; then
        echo "$commit: subject is not a Conventional Commit: $subject" >&2
        status=1
    fi
    body=$(git log -1 --format=%b "$commit" | grep -Ev '^(Co-Authored-By|Claude-Session|Signed-off-by|Refs|Contract):' | tr -d '[:space:]')
    if test -z "$body"; then
        echo "$commit: body is empty; state the gates that ran and their results" >&2
        status=1
    fi
    changed=$(git -c core.quotePath=false diff-tree --no-commit-id --name-only -r --root "$commit")
    formats=$(git -c core.quotePath=false diff-tree --no-commit-id -p -r --root "$commit" -- 'internal/*.go' ':(exclude)*_test.go' |
        awk '/^--- a\// { file = substr($0, 7) }
            /^\+\+\+ b\// { file = substr($0, 7) }
            match($0, /^[-+][[:space:]]*(const[[:space:]]+)?[A-Za-z]*Version([[:space:]]+[A-Za-z0-9]+)?[[:space:]]*=[[:space:]]*[0-9]+[[:space:]]*(\/\/.*)?$/) {
                line = $0; sub(/[[:space:]]*\/\/.*$/, "", line); sign = substr(line, 1, 1)
                name = line; sub(/^[-+][[:space:]]*(const[[:space:]]+)?/, "", name); sub(/[^A-Za-z].*$/, "", name)
                value = line; sub(/^.*=[[:space:]]*/, "", value); sub(/[[:space:]]*$/, "", value)
                print sign file ":" name "=" value
            }')
    breaking=
    for removed in $(printf '%s\n' "$formats" | sed -n 's/^-//p'); do
        if printf '%s\n' "$formats" | grep -q "^+${removed%%=*}=" && ! printf '%s\n' "$formats" | grep -Fqx "+$removed"; then
            breaking="$breaking ${removed%%=*}"
        fi
    done
    if touches_contract "$changed"; then
        contract=$(git log -1 --format=%b "$commit" | sed -n 's/^Contract: //p')
        if test "$contract" = unchanged; then
            moved=$(git -c core.quotePath=false diff-tree --no-commit-id -p -r --root "$commit" -- 'cmd/bootwright/testdata/contracts/*.golden' |
                grep -E '^[-+]content-digest: ' || true)
            if test -n "$moved"; then
                echo "$commit: says 'Contract: unchanged' but changes a content-digest line of a contract golden; name each implementation whose contract it moved" >&2
                status=1
            fi
        elif test -z "$contract" || test "$(printf '%s\n' "$contract" | wc -l)" -ne 1 ||
            ! printf '%s\n' "$contract" | grep -Eqx '[a-z][a-z0-9-]*(, [a-z][a-z0-9-]*)*'; then
            echo "$commit: touches automation or a capability package; add one body line 'Contract: unchanged' or 'Contract: <implementation>, ...' naming each implementation whose contract it moved" >&2
            status=1
        else
            breaking="$breaking$contract"
            for implementation in $(printf '%s\n' "$contract" | tr -d ','); do
                if ! printf '%s\n' "$changed" | grep -Fqx "cmd/bootwright/testdata/contracts/$implementation.golden"; then
                    echo "$commit: names $implementation in its Contract line but does not change cmd/bootwright/testdata/contracts/$implementation.golden" >&2
                    status=1
                fi
            done
        fi
    fi
    if test -n "$breaking"; then
        if ! printf '%s\n' "$subject" | grep -Eq '^[a-z]+(\([a-z0-9-]+\))?!: ' ||
            ! git log -1 --format=%b "$commit" | grep -Eq '^BREAKING CHANGE: [^ ]'; then
            echo "$commit: moves a contract or a store format version, so this build refuses state an earlier build left; mark the subject with '!' and add a 'BREAKING CHANGE: ' footer naming what it refuses and the remedy" >&2
            status=1
        fi
    fi
done
exit "$status"
