#!/bin/sh
# Advisory end-of-turn check, run by the Stop hook of Claude Code
# (.claude/settings.json) or Codex (.codex/hooks.json) with the hook's JSON
# input on stdin. It runs `make focus` in a task worktree whose content changed
# since the last pass, and asks for one more turn (exit 2, reason on stderr,
# nothing on stdout) only when that fails. Every exit 0 prints {} on stdout,
# which both runtimes accept; nothing else reaches stdout. It never blocks
# twice in a row: not while the input reports stop_hook_active, and, when the
# runtime omits that field, not twice for the same content (stop-check.failed).
# It never runs in the primary checkout and exits 0 whenever it cannot tell
# what to check. A pass is cached in the worktree's Git directory as
# stop-check.ok.
ok() {
    printf '{}\n'
    exit 0
}
input=$(cat)
case "$(printf '%s' "$input" | tr -d ' \t\r\n')" in
*'"stop_hook_active":true'*) ok ;;
esac
gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || ok
cd_=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || ok
test "$gd" = "$cd_" && ok
top=$(git rev-parse --show-toplevel 2>/dev/null) || ok
cd "$top" || ok
if git diff --quiet HEAD -- 2>/dev/null &&
    test -z "$(git ls-files --others --exclude-standard)"; then
    ok
fi
key=$({
    git rev-parse HEAD
    git diff HEAD --binary
    git ls-files --others --exclude-standard
    git ls-files --others --exclude-standard -z | xargs -0r git hash-object --
} 2>/dev/null | git hash-object --stdin) || ok
test "$key" = "$(cat "$gd/stop-check.ok" 2>/dev/null)" && ok
test "$key" = "$(cat "$gd/stop-check.failed" 2>/dev/null)" && ok
make -n focus >/dev/null 2>&1 || ok
if ! make focus >&2; then
    printf '%s\n' "$key" >"$gd/stop-check.failed"
    exit 2
fi
printf '%s\n' "$key" >"$gd/stop-check.ok"
ok
