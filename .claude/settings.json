{
  "permissions": {
    "allow": [
      "Bash(./scripts/go test *)",
      "Bash(./scripts/go vet *)",
      "Bash(./scripts/go build *)",
      "Bash(./scripts/go list *)",
      "Bash(./scripts/go env *)",
      "Bash(./scripts/ansible-check *)",
      "Bash(./scripts/quick-test)",
      "Bash(make focus)",
      "Bash(make quick)",
      "Bash(make docs-check)",
      "Bash(make fmt-check)",
      "Bash(make vet)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make check-offline)",
      "Bash(make check)",
      "Bash(make race)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(*bootwright *apply*)",
      "Bash(*bootwright *destroy*)",
      "Bash(*bootwright *controller install*)",
      "Bash(*bootwright *controller uninstall*)",
      "Bash(*bootwright *media add*)",
      "Bash(*bootwright *machine start*)",
      "Bash(*bootwright *machine stop*)",
      "Bash(*bootwright *machine restart*)",
      "Bash(*bootwright *machine trust*)",
      "Bash(*bootwright *machine rsh*)",
      "Bash(*bootwright *machine exec*)",
      "Bash(*bootwright *cluster rsh*)",
      "Bash(*bootwright *cluster exec*)",
      "Bash(*bootwright *cluster kubeconfig*)",
      "Bash(*bootwright *cluster keyring*)",
      "Bash(*bootwright *secret show*)",
      "Bash(*bootwright *controller rebind*)",
      "Bash(*bootwright *cluster info*--secrets*)",
      "Bash(*bootwright *cluster info*--object-user*)",
      "Bash(*bootwright *render*--sensitive*)",
      "Bash(sudo *)",
      "Bash(*ansible-playbook*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git tag *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check",
            "timeout": 300,
            "statusMessage": "stop-check: make focus"
          }
        ]
      }
    ]
  }
}
