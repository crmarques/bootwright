{
  "schemaVersion": "v1alpha1",
  "command": "add-ons info",
  "ok": true,
  "exitCode": 0,
  "result": {
    "package": {
      "name": "gitops",
      "summary": "OpenShift GitOps (Argo CD) with an optional bootstrap Application, installed last",
      "provides": [],
      "requires": [],
      "requiresMeaning": "another instance selected for the same cluster must provide each required capability",
      "olmPackage": "openshift-gitops-operator",
      "defaultSource": "redhat-operators",
      "secretNamespaces": [
        "openshift-gitops",
        "openshift-gitops-operator"
      ],
      "lookup": "oc get packagemanifest openshift-gitops-operator -n openshift-marketplace -o json",
      "configuration": [
        {
          "path": "subscription.channel",
          "type": "string",
          "required": true,
          "requiredWithin": "",
          "default": "",
          "values": []
        },
        {
