      "binding": "apiVersion: bootwright.io/v1alpha1\nkind: ClusterAddonBinding\nmetadata:\n  name: gitops\nspec:\n  clusterRef: <clusterRef>\n  packages:\n    gitops:\n      subscription:\n        channel: <channel>\n        startingCSV: <startingCSV>\n        source: redhat-operators\n"
