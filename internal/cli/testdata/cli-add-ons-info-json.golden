          "type": "string",
          "required": true,
          "requiredWithin": "",
          "default": "",
          "values": []
        },
        {
          "path": "subscription.source",
          "type": "DNS name",
          "required": false,
          "requiredWithin": "",
          "default": "redhat-operators",
          "values": []
        },
        {
          "path": "subscription.sourceNamespace",
          "type": "name",
          "required": false,
          "requiredWithin": "",
          "default": "openshift-marketplace",
          "values": []
        },
        {
          "path": "subscription.catalogSource.name",
