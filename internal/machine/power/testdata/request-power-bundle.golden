{
  "arm": "baremetal",
  "controller": {
    "credentialsRef": "metal-bmc",
    "endpoint": "https://bmc.example.test/redfish/v1/Systems/1",
    "tlsVerification": "certificate",
    "tlsVerify": true,
    "trustBundleRef": "metal-bmc-ca"
  },
  "force": false,
  "identity": {
    "context": "lab",
    "object": "metal"
  },
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "verb": "stop",
  "version": "machine-power-v2"
}
