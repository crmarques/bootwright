{
  "arm": "kubevirt",
  "controller": {
    "credentialsRef": "",
    "endpoint": "kubevirt:nested/node-0-094f15ed",
    "hostCluster": "host",
    "tlsVerify": true
  },
  "force": false,
  "identity": {
    "context": "lab",
    "object": "node-0"
  },
  "machinePort": {
    "endpoint": "kubevirt:nested/node-0-094f15ed",
    "mediaVolume": "node-0-094f15ed-media",
    "pinnedSerialVariable": "pinnedSerialBase64",
    "pinnedUUIDVariable": "pinnedUUIDBase64",
    "userVariable": "controllerUser",
    "verify": true
  },
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "verb": "restart",
  "version": "machine-power-v1"
}
