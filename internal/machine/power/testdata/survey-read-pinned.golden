{
  "context": "lab",
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "targets": [
    {
      "arm": "kubevirt",
      "controller": {
        "credentialsRef": "ext-kubeconfig",
        "endpoint": "kubevirt:guests/vm-0-3f605b2b",
        "tlsVerify": true
      },
      "object": "vm-0",
      "pinnedSerialVariable": "pinnedSerialBase640",
      "pinnedUUIDVariable": "pinnedUUIDBase640",
      "userVariable": "controllerUser0"
    }
  ],
  "version": "machine-power-read-v4"
}
