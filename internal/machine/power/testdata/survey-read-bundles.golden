{
  "context": "lab",
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "targets": [
    {
      "arm": "baremetal",
      "controller": {
        "credentialsRef": "metal-bmc",
        "endpoint": "https://bmc.example.test/redfish/v1/Systems/1",
        "tlsVerification": "certificate",
        "tlsVerify": true,
        "trustBundleRef": "metal-bmc-ca"
      },
      "machinePort": {
        "caVariable": "controllerCA0",
        "endpoint": "https://bmc.example.test/redfish/v1/Systems/1",
        "passwordVariable": "controllerPassword0",
        "userVariable": "controllerUser0",
        "verification": "certificate",
        "verify": true
      },
      "object": "metal"
    },
    {
      "arm": "baremetal",
      "controller": {
        "credentialsRef": "rack-bmc",
        "endpoint": "https://rack.example.test/redfish/v1/Systems/7",
        "tlsVerify": true,
        "trustBundleRef": "rack-bmc-ca"
      },
      "machinePort": {
        "caVariable": "controllerCA1",
        "endpoint": "https://rack.example.test/redfish/v1/Systems/7",
        "passwordVariable": "controllerPassword1",
        "userVariable": "controllerUser1",
        "verify": true
      },
      "object": "rack"
    },
    {
      "arm": "baremetal",
      "controller": {
        "credentialsRef": "zero-bmc",
        "endpoint": "https://zero.example.test/redfish/v1/Systems/7",
        "tlsVerify": true
      },
      "machinePort": {
        "endpoint": "https://zero.example.test/redfish/v1/Systems/7",
        "passwordVariable": "controllerPassword2",
        "userVariable": "controllerUser2",
        "verify": true
      },
      "object": "zero"
    }
  ],
  "version": "machine-power-read-v1"
}
