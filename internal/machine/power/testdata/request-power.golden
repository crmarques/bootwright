{
  "arm": "baremetal",
  "controller": {
    "credentialsRef": "metal-bmc",
    "endpoint": "https://bmc.example.test/redfish/v1/Systems/1",
    "tlsVerify": true
  },
  "force": false,
  "identity": {
    "context": "lab",
    "object": "metal"
  },
  "machinePort": {
    "endpoint": "https://bmc.example.test/redfish/v1/Systems/1",
    "passwordVariable": "controllerPassword",
    "pinnedSerialVariable": "pinnedSerialBase64",
    "pinnedUUIDVariable": "pinnedUUIDBase64",
    "userVariable": "controllerUser",
    "verify": true
  },
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "verb": "stop",
  "version": "machine-power-v1"
}
