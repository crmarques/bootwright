{
  "context": "lab",
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "targets": [
    {
      "arm": "kubevirt",
      "controller": {
        "credentialsRef": "",
        "endpoint": "kubevirt:nested/node-0-094f15ed",
        "hostCluster": "host",
        "tlsVerify": true
      },
      "machinePort": {
        "endpoint": "kubevirt:nested/node-0-094f15ed",
        "mediaVolume": "node-0-094f15ed-media",
        "pinnedSerialVariable": "pinnedSerialBase640",
        "pinnedUUIDVariable": "pinnedUUIDBase640",
        "userVariable": "controllerUser0",
        "verify": true
      },
      "object": "node-0"
    },
    {
      "arm": "kubevirt",
      "controller": {
        "credentialsRef": "",
        "endpoint": "kubevirt:nested/node-1-302063a4",
        "hostCluster": "host",
        "tlsVerify": true
      },
      "machinePort": {
        "endpoint": "kubevirt:nested/node-1-302063a4",
        "mediaVolume": "node-1-302063a4-media",
        "pinnedSerialVariable": "pinnedSerialBase641",
        "pinnedUUIDVariable": "pinnedUUIDBase641",
        "userVariable": "controllerUser1",
        "verify": true
      },
      "object": "node-1"
    }
  ],
  "version": "machine-power-read-v1"
}
