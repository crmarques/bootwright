  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "pullSecretRef": "openshift-pull-secret",
  "registryMirror": {
    "credentialsRef": "mirror-credentials",
    "credentialsType": "usernamePassword",
    "host": "mirror.example.test"
  },
  "release": {
    "distribution": "openshift",
    "version": "4.21.15"
  },
  "sshKeyRef": "sno-cluster-admin-ssh-key",
  "tlsCertificateRef": "artifact-server-tls",
  "tool": {
    "compatibility": "openshift",
    "kind": "openshift-install",
    "version": "4.21.15"
  },
  "trustBundleRefs": [
    "mirror-ca"
  ],
  "version": "cluster-media-agent-v1",
  "workRoot": "/var/lib/bootwright-hosted/lab/clusters/sno"
}
