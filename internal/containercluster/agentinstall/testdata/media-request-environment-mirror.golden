{
  "agentConfig": {
    "additionalNTPSources": [
      "192.0.2.1"
    ],
    "apiVersion": "v1beta1",
    "hosts": [
      {
        "hostname": "master-0",
        "interfaces": [
          {
            "macAddress": "52:54:00:06:3e:11",
            "name": "enp1s0"
          }
        ],
        "networkConfig": {
          "dns-resolver": {
            "config": {
              "server": [
                "192.0.2.1"
              ]
            }
          },
          "interfaces": [
            {
              "ipv4": {
                "address": [
                  {
                    "ip": "198.51.100.21",
                    "prefix-length": 24
                  }
                ],
                "dhcp": false,
                "enabled": true
              },
              "ipv6": {
                "enabled": false
              },
              "mac-address": "52:54:00:06:3e:11",
              "name": "enp1s0",
              "state": "up",
              "type": "ethernet"
            }
          ],
          "routes": {
            "config": [
              {
                "destination": "0.0.0.0/0",
                "next-hop-address": "198.51.100.1",
                "next-hop-interface": "enp1s0",
                "table-id": 254
              }
            ]
          }
        },
        "role": "master",
        "rootDeviceHints": {
          "deviceName": "/dev/vda"
        }
      }
    ],
    "kind": "AgentConfig",
    "metadata": {
      "name": "sno"
    },
    "rendezvousIP": "198.51.100.21"
  },
  "budgets": {
    "buildSeconds": 1800
  },
  "deliveryKind": "fetch",
  "identity": {
    "block": "cluster-media-sno",
    "cluster": "sno",
    "context": "lab"
  },
  "image": {
    "path": "/var/lib/bootwright-hosted/lab/services/artifact-server/lab-artifacts/public/private/clusters/sno",
    "url": "https://192.0.2.1:8443/private/clusters/sno"
  },
  "installConfig": {
    "additionalTrustBundle": "",
    "apiVersion": "v1",
    "baseDomain": "lab.example.test",
    "compute": [
      {
        "name": "worker",
        "replicas": 0
      }
    ],
    "controlPlane": {
      "name": "master",
      "replicas": 1
    },
    "imageDigestSources": [
      {
        "mirrors": [
          "mirror.example.test/images/quay.io/openshift-release-dev/ocp-release"
        ],
        "source": "quay.io/openshift-release-dev/ocp-release",
        "sourcePolicy": "NeverContactSource"
      },
      {
        "mirrors": [
          "mirror.example.test/images/quay.io/openshift-release-dev/ocp-v4.0-art-dev"
        ],
        "source": "quay.io/openshift-release-dev/ocp-v4.0-art-dev",
        "sourcePolicy": "NeverContactSource"
      }
    ],
    "metadata": {
      "name": "sno"
    },
    "networking": {
      "clusterNetwork": [
        {
          "cidr": "10.128.0.0/14",
          "hostPrefix": 23
        }
      ],
      "machineNetwork": [
        {
          "cidr": "198.51.100.0/24"
        }
      ],
      "serviceNetwork": [
        "172.30.0.0/16"
      ]
    },
    "platform": {
      "none": {}
    },
    "pullSecret": "",
    "sshKey": ""
  },
  "manifests": [
    {
      "apiVersion": "machineconfiguration.openshift.io/v1",
      "content": {
        "apiVersion": "machineconfiguration.openshift.io/v1",
        "kind": "MachineConfig",
        "metadata": {
          "labels": {
            "machineconfiguration.openshift.io/role": "master"
          },
          "name": "99-master-bootwright-chrony"
        },
        "spec": {
          "config": {
            "ignition": {
              "version": "3.2.0"
            },
            "storage": {
              "files": [
                {
                  "contents": {
                    "source": "data:text/plain;charset=utf-8;base64,c2VydmVyIDE5Mi4wLjIuMSBpYnVyc3QKZHJpZnRmaWxlIC92YXIvbGliL2Nocm9ueS9kcmlmdAptYWtlc3RlcCAxLjAgMwpydGNzeW5jCmxvZ2RpciAvdmFyL2xvZy9jaHJvbnkK"
                  },
                  "mode": 420,
                  "overwrite": true,
                  "path": "/etc/chrony.conf"
                }
              ]
            }
          }
        }
      },
      "file": "bootwright-10-master-chrony.yaml",
      "kind": "MachineConfig",
      "name": "99-master-bootwright-chrony"
    },
    {
      "apiVersion": "machineconfiguration.openshift.io/v1",
      "content": {
        "apiVersion": "machineconfiguration.openshift.io/v1",
        "kind": "MachineConfig",
        "metadata": {
          "labels": {
            "machineconfiguration.openshift.io/role": "worker"
          },
          "name": "99-worker-bootwright-chrony"
        },
        "spec": {
          "config": {
            "ignition": {
              "version": "3.2.0"
            },
            "storage": {
              "files": [
                {
                  "contents": {
                    "source": "data:text/plain;charset=utf-8;base64,c2VydmVyIDE5Mi4wLjIuMSBpYnVyc3QKZHJpZnRmaWxlIC92YXIvbGliL2Nocm9ueS9kcmlmdAptYWtlc3RlcCAxLjAgMwpydGNzeW5jCmxvZ2RpciAvdmFyL2xvZy9jaHJvbnkK"
                  },
                  "mode": 420,
                  "overwrite": true,
                  "path": "/etc/chrony.conf"
                }
              ]
            }
          }
        }
      },
      "file": "bootwright-11-worker-chrony.yaml",
      "kind": "MachineConfig",
      "name": "99-worker-bootwright-chrony"
