  "services": [
    {
      "placement": {
        "count": 3,
        "hosts": [
          "node-1",
          "node-2",
          "node-3",
          "node-4",
          "tie"
        ]
      },
      "service_type": "mon",
      "spec": {
        "crush_locations": {
          "node-1": [
            "datacenter=site-a"
          ],
          "node-2": [
            "datacenter=site-a"
          ],
          "node-3": [
            "datacenter=site-b"
          ],
          "node-4": [
            "datacenter=site-b"
          ],
          "tie": [
            "datacenter=site-c"
          ]
        }
      }
    },
    {
      "placement": {
        "count": 2,
        "hosts": [
          "node-1",
          "node-2",
          "node-3",
          "node-4",
          "tie"
        ]
      },
      "service_type": "mgr"
    },
    {
      "placement": {
        "hosts": [
          "node-1",
          "node-2",
          "node-3",
          "node-4"
        ]
      },
      "service_id": "data",
      "service_type": "osd",
      "spec": {
        "data_devices": {
          "paths": [
            "/dev/vdb"
          ]
        }
      }
    }
  ],
  "stretch": {
    "dataSites": [
      "site-a",
      "site-b"
    ],
    "failureDomain": "datacenter",
    "rule": "stretch-rule",
    "tiebreaker": "tie",
    "tiebreakerSite": "site-c"
  },
  "version": "ceph-core-v36"
}
