  "principals": {
    "client.bw-decfe99dd8c77b66-fs-node": {
      "mds": "allow rw",
      "mgr": "allow rw",
      "mon": "allow r, allow command 'osd blocklist'",
      "osd": "allow rw tag cephfs *=files"
    },
    "client.bw-decfe99dd8c77b66-fs-prov": {
      "mds": "allow *",
      "mgr": "allow rw",
      "mon": "allow r, allow command 'osd blocklist'",
      "osd": "allow rw tag cephfs metadata=files"
    },
    "client.bw-decfe99dd8c77b66-health": {
      "mds": "allow *",
      "mgr": "allow command config",
      "mon": "allow r, allow command quorum_status, allow command version",
      "osd": "profile rbd-read-only"
    },
    "client.bw-decfe99dd8c77b66-rbd-node": {
      "mon": "profile rbd, allow command 'osd blocklist'",
      "osd": "profile rbd pool=block"
    },
    "client.bw-decfe99dd8c77b66-rbd-prov": {
      "mgr": "allow rw",
      "mon": "profile rbd, allow command 'osd blocklist'",
      "osd": "profile rbd pool=block"
    }
  },
