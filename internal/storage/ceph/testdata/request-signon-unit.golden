{
  "action": "service",
  "ansiblePackageVersion": "",
  "auxiliary": [
    {
      "image": "cp.icr.io/synthetic/keepalived@sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "name": "keepalived"
    },
    {
      "image": "cp.icr.io/synthetic/nginx@sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "name": "nginx"
    },
    {
      "image": "cp.icr.io/synthetic/oauth2_proxy@sha256:3333333333333333333333333333333333333333333333333333333333333333",
      "name": "oauth2_proxy"
    }
  ],
  "bootstrap": "node-1",
  "callHome": "",
  "cephadm": {
    "packageVersion": "",
    "path": ""
  },
  "cluster": "example",
  "clusterKeyRef": "cluster-key",
  "clusterNetworks": null,
  "clusterSSHTransport": "native",
  "clusterSSHUser": "",
  "controller": "controller",
  "delegated": [
    {
      "hosts": [
        "node-1",
        "node-2",
        "node-3"
      ],
      "name": "oauth2-proxy"
    }
  ],
  "fsid": "5effe704-a878-5cae-8b43-c81f7112832a",
  "hosts": [
    {
      "address": "192.0.2.1",
      "devices": [
        {
          "path": "/dev/vdb",
          "serial": "node-1",
          "sizeBytes": 1073741824
        }
      ],
      "hostKeyRef": "node-1-host-key",
      "labels": [],
      "location": {},
      "machine": "node-1",
      "name": "node-1",
      "port": 22,
      "sshKeyRef": "fleet-key",
      "user": "operator"
    },
    {
      "address": "192.0.2.2",
      "devices": [
        {
          "path": "/dev/vdb",
          "serial": "node-2",
          "sizeBytes": 1073741824
        }
      ],
      "hostKeyRef": "node-2-host-key",
      "labels": [],
      "location": {},
      "machine": "node-2",
      "name": "node-2",
      "port": 22,
      "sshKeyRef": "fleet-key",
      "user": "operator"
    },
    {
      "address": "192.0.2.3",
      "devices": [
        {
          "path": "/dev/vdb",
          "serial": "node-3",
          "sizeBytes": 1073741824
        }
      ],
      "hostKeyRef": "node-3-host-key",
      "labels": [],
      "location": {},
      "machine": "node-3",
      "name": "node-3",
      "port": 22,
      "sshKeyRef": "fleet-key",
      "user": "operator"
    }
  ],
  "image": "cp.icr.io/cp/ibm-ceph/ceph-9-rhel9@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
  "monIP": "",
  "owner": "apply-original",
  "packageRepository": "",
  "packageRepositoryKey": "",
  "publicNetworks": null,
  "registry": "cp.icr.io",
  "registryRef": "registry",
  "release": "",
  "service": {
    "bindings": [
      {
        "path": "/custom_configs/0/content",
        "secretRef": "sso-ca",
        "serviceRef": "oauth2-proxy"
      },
      {
        "path": "/spec/client_secret",
        "secretRef": "sso-client",
        "serviceRef": "oauth2-proxy"
      },
      {
        "path": "/spec/cookie_secret",
        "secretRef": "sso-cookie",
        "serviceRef": "oauth2-proxy"
      },
      {
        "path": "/spec/ssl_cert",
        "secretRef": "sso-tls",
        "serviceRef": "oauth2-proxy"
      },
      {
        "path": "/spec/ssl_key",
        "secretRef": "sso-tls",
        "serviceRef": "oauth2-proxy"
      }
    ],
    "documents": [
      {
        "custom_configs": [
          {
            "mount_path": "/etc/pki/tls/certs/oauth2-proxy-idp-ca.pem"
          }
        ],
        "placement": {
          "count": 1,
          "hosts": [
            "node-1",
            "node-2",
            "node-3"
          ]
        },
        "service_type": "oauth2-proxy",
        "spec": {
          "client_id": "ceph",
          "oidc_issuer_url": "https://idp.example.test/realms/ceph",
          "provider_display_name": "SSO"
        }
      }
    ],
    "id": "",
    "signOn": {
      "certificateSHA256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "count": 2,
      "hosts": [
        "node-1",
        "node-2",
        "node-3"
      ],
      "port": 9443,
      "virtualIP": "192.0.2.60"
    },
    "type": "oauth2-proxy"
  },
  "services": [
    {
      "placement": {
        "hosts": [
          "node-1",
          "node-2",
          "node-3"
        ]
      },
      "service_id": "data",
      "service_type": "osd",
      "spec": {
        "data_devices": {
          "paths": [
            "/dev/vdb"
          ]
        }
      }
    },
    {
      "placement": {
        "hosts": [
          "node-1",
          "node-2",
          "node-3"
        ]
      },
      "service_type": "mon"
    },
    {
      "placement": {
        "count": 2,
        "hosts": [
          "node-1",
          "node-2",
          "node-3"
        ]
      },
      "service_type": "mgr"
    }
  ],
  "version": "ceph-core-v1"
}
