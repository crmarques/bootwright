    "auth": {
      "username": "Administrator"
    },
    "auth_id": "join",
    "resource_type": "ceph.smb.join.auth"
  },
  "object": "smb-join",
  "resourceType": "ceph.smb.join.auth",
  "version": "ceph-smb-v1"
}
