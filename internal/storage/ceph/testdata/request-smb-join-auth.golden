{
  "bindings": [
    {
      "path": "/auth/password",
      "secretRef": "join-password"
    }
  ],
  "cluster": "example",
  "controller": "controller",
  "id": "join",
  "machines": [
    "node-1",
    "node-2",
    "node-3"
  ],
