  "kickstart": "# Generated by Bootwright. Do not edit.\ntext\neula --agreed\npoweroff\n\nurl --url=http://192.0.2.1:8080/os/rhel-9-8/tree\nnetwork --bootproto=static --device=enp1s0 --ip=198.51.100.41 --netmask=255.255.255.0 --hostname=metal-01.lab.example.test --onboot=on --activate --gateway=198.51.100.1 --nameserver=192.0.2.1\n\nlang en_US.UTF-8\nkeyboard --vckeymap=us\ntimezone Etc/UTC --utc --ntpservers=192.0.2.1\n\nrootpw --lock\nuser --name=bootwright --groups=wheel --lock\nsshkey --username=bootwright \"@@BOOTWRIGHT_AUTHORIZED_KEY@@\"\n\n%pre --erroronfail --interpreter=/bin/bash\nset -euo pipefail\nbootwright_observed=$(for bootwright_nic in /sys/class/net/*; do\nif [ ! -e \"${bootwright_nic}/device\" ]; then continue; fi\ncase \"$(basename -- \"$(readlink -f -- \"${bootwright_nic}/device/driver\")\")\" in cdc_ether|cdc_eem|cdc_ncm|rndis_host) continue;; esac\nbootwright_mac=\"${bootwright_nic}/address\"\nif [ -r \"${bootwright_nic}/bonding_slave/perm_hwaddr\" ]; then bootwright_mac=\"${bootwright_nic}/bonding_slave/perm_hwaddr\"; fi\ntr 'A-Z' 'a-z' \u003c \"${bootwright_mac}\" || exit 1\ndone | sort -u)\nif ! printf '%s\\n' \"${bootwright_observed}\" | grep -Fx '52:54:00:9a:1b:01' \u003e/dev/null; then\necho 'Bootwright: this machine does not report 52:54:00:9a:1b:01, which its declaration requires; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nbootwright_undeclared=$(printf '%s\\n' \"${bootwright_observed}\" | grep -Fvx -e '52:54:00:9a:1b:01' | grep -c . || true)\nif [ \"${bootwright_undeclared}\" != 0 ]; then\necho \"Bootwright: this machine reports ${bootwright_undeclared} hardware address(es) its declaration does not name; refusing before any disk is touched.\" \u003e\u00262\nexit 1\nfi\nbootwright_root=$(readlink -f -- '/dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@' || true)\nbootwright_identity() {\nlocal raw value='' byte start=0 end limit=259 form=\"$2\"\nlocal -a bytes\nif [ \"${form}\" = vpd ]; then limit=261; fi\nraw=$(od -An -v -tu1 -N \"${limit}\" -- \"$1\") || return 1\nread -r -a bytes \u003c\u003c\u003c \"${raw//$'\\n'/ }\"\nset -- \"${bytes[@]}\"\nif [ \"${form}\" = vpd ]; then\nif [ \"$#\" -lt 5 ] || [ \"$#\" -gt 260 ] || [ \"${bytes[1]}\" != 128 ] || [ $((bytes[2] * 256 + bytes[3])) != $(($# - 4)) ]; then return 1; fi\nbytes=(\"${bytes[@]:4}\")\nshift 4\nelif [ \"$#\" -gt 258 ]; then return 1\nfi\nend=$#\nwhile [ \"${start}\" -lt \"${end}\" ] \u0026\u0026 [[ \" 9 10 11 12 13 32 \" == *\" ${bytes[start]} \"* ]]; do start=$((start + 1)); done\nwhile [ \"${end}\" -gt \"${start}\" ] \u0026\u0026 [[ \" 9 10 11 12 13 32 \" == *\" ${bytes[end - 1]} \"* ]]; do end=$((end - 1)); done\nif [ \"${end}\" -eq \"${start}\" ] || [ $((end - start)) -gt 256 ]; then return 1; fi\nfor byte in \"${bytes[@]:start:end - start}\"; do\nif [ \"${byte}\" -lt 32 ] || [ \"${byte}\" -gt 126 ]; then return 1; fi\nprintf -v byte '%03o' \"${byte}\"\nprintf -v byte \"\\\\${byte}\"\nvalue+=\"${byte}\"\ndone\nprintf '%s\\n' \"${value}\"\n}\nbootwright_volume_count=0\nfor bootwright_entry in /sys/class/block/*; do\nif [ ! -e \"${bootwright_entry}\" ] || [ -e \"${bootwright_entry}/partition\" ] || [ \"$(cat -- \"${bootwright_entry}/hidden\" 2\u003e/dev/null)\" = 1 ]; then continue; fi\nbootwright_id=\"${bootwright_entry}/device/wwid\"\nif [ -e \"${bootwright_entry}/wwid\" ]; then bootwright_id=\"${bootwright_entry}/wwid\"; fi\nif bootwright_id=$(bootwright_identity \"${bootwright_id}\" text 2\u003e/dev/null) \u0026\u0026 [ \"${bootwright_id}\" = 'naa.@@BOOTWRIGHT_VOLUME_WWN@@' ]; then bootwright_volume_count=$((bootwright_volume_count + 1)); fi\ndone\nif [ \"${bootwright_volume_count}\" != 1 ] || [ \"$(lsblk -ndo RO -- \"${bootwright_root}\")\" != 0 ] || [ \"$(lsblk -ndo RM -- \"${bootwright_root}\")\" != 0 ]; then\necho 'Bootwright: the root volume is ambiguous, read-only or removable; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nif [ -z \"${bootwright_root}\" ] || [ ! -b \"${bootwright_root}\" ]; then\necho 'Bootwright: the declared root device /dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@ is not a block device here; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nif [ \"$(lsblk -ndo TYPE -- \"${bootwright_root}\")\" != disk ]; then\necho 'Bootwright: the declared root device /dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@ is not a whole disk; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nbootwright_disk=\"/sys/class/block/$(basename -- \"${bootwright_root}\")\"\nbootwright_wwid=\"${bootwright_disk}/device/wwid\"\nif [ -e \"${bootwright_disk}/wwid\" ]; then bootwright_wwid=\"${bootwright_disk}/wwid\"; fi\nif ! bootwright_wwid=$(bootwright_identity \"${bootwright_wwid}\" text); then\necho 'Bootwright: the declared root device /dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@ reports no readable WWN; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nif [ \"${bootwright_wwid}\" != 'naa.@@BOOTWRIGHT_VOLUME_WWN@@' ]; then\necho 'Bootwright: the declared root device /dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@ reports a WWN other than 0x@@BOOTWRIGHT_VOLUME_WWN@@; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nif ! bootwright_size=$(blockdev --getsize64 \"${bootwright_root}\"); then\necho 'Bootwright: the declared root device /dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@ reports no readable size; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nif [ \"${bootwright_size}\" != '@@BOOTWRIGHT_VOLUME_SIZE@@' ]; then\necho 'Bootwright: the declared root device /dev/disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@ reports a size other than @@BOOTWRIGHT_VOLUME_SIZE@@ bytes; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\n%end\n\nignoredisk --only-use=disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@\nclearpart --all --initlabel --drives=disk/by-id/wwn-0x@@BOOTWRIGHT_VOLUME_WWN@@\nautopart --type=lvm\n\nselinux --enforcing\n\nservices --enabled=chronyd,sshd\n\n%packages --excludedocs --exclude-weakdeps\n@^minimal-environment\nchrony\nnmstate\n%end\n\n%post --erroronfail\nset -eu\ninstall -d -m 0755 /etc/bootwright\ncat \u003e /etc/bootwright/install-marker.json \u003c\u003c'BOOTWRIGHT_MARKER_EOF'\n@@BOOTWRIGHT_MARKER@@\nBOOTWRIGHT_MARKER_EOF\nchmod 0444 /etc/bootwright/install-marker.json\ninstall -d -m 0755 /etc/ssh\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\ncurl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem --output /etc/ssh/ssh_host_ed25519_key '@@BOOTWRIGHT_PRIVATE_URL@@/identity'\ncurl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem --output /etc/ssh/ssh_host_ed25519_key.pub '@@BOOTWRIGHT_PRIVATE_URL@@/identity.pub'\nchmod 0600 /etc/ssh/ssh_host_ed25519_key\nchmod 0644 /etc/ssh/ssh_host_ed25519_key.pub\ntest -s /etc/ssh/ssh_host_ed25519_key\ntest \"$(cut -d' ' -f1 /etc/ssh/ssh_host_ed25519_key.pub)\" = 'ssh-ed25519'\ntest \"$(/usr/bin/ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key | cut -d' ' -f1,2)\" = \"$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)\"\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'HostKey /etc/ssh/ssh_host_ed25519_key' \u003e /etc/ssh/sshd_config.d/40-bootwright-host-key.conf\nchmod 0600 /etc/ssh/sshd_config.d/40-bootwright-host-key.conf\n/usr/bin/ssh-keygen -A\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\ninstall -d -m 0750 /etc/sudoers.d\nprintf '%s\\n' 'bootwright ALL=(ALL) NOPASSWD: ALL' \u003e /etc/sudoers.d/60-bootwright\nchmod 0440 /etc/sudoers.d/60-bootwright\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'PasswordAuthentication no' 'PermitRootLogin prohibit-password' \u003e /etc/ssh/sshd_config.d/60-bootwright.conf\nchmod 0600 /etc/ssh/sshd_config.d/60-bootwright.conf\nrm -f /root/anaconda-ks.cfg /root/original-ks.cfg /run/install/ks.cfg\n%end\n",
