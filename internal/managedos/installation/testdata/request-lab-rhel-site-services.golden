  "fleetKeyRef": "bootwright-machine-key",
  "hostKeyPath": "/etc/bootwright/host-key.pub",
  "hostname": "rhel-01.lab.example.test",
  "identity": {
    "block": "os-install-rhel-01",
    "context": "lab",
    "object": "rhel-01",
    "profile": "rhel-9-8"
