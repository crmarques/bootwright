  "image": {
    "path": "/var/lib/bootwright-services/lab/artifact-server/lab-artifacts/public/os/rhel-01/install.iso",
    "url": "https://192.0.2.1:8443/os/rhel-01/install.iso"
  },
  "kickstart": "# Generated by Bootwright. Do not edit.\ntext\neula --agreed\npoweroff\n\nurl --url=http://192.0.2.1:8080/os/rhel-9-8/tree\nnetwork --bootproto=static --device=enp1s0 --ip=198.51.100.11 --netmask=255.255.255.0 --hostname=rhel-01.lab.example.test --onboot=on --activate --gateway=198.51.100.1 --nameserver=203.0.113.53\n\nlang en_US.UTF-8\nkeyboard --vckeymap=us\ntimezone Etc/UTC --utc --ntpservers=ntp.example.test\n\nrootpw --lock\nuser --name=bootwright --groups=wheel --lock\nsshkey --username=bootwright \"@@BOOTWRIGHT_AUTHORIZED_KEY@@\"\n\nignoredisk --only-use=vda\nclearpart --all --initlabel --drives=vda\nautopart --type=lvm\n\nselinux --enforcing\n\nservices --enabled=chronyd,sshd\n\n%packages --excludedocs --exclude-weakdeps\n@^minimal-environment\nchrony\nqemu-guest-agent\n%end\n\n%post --erroronfail\nset -eu\ninstall -d -m 0755 /etc/bootwright\ncat \u003e /etc/bootwright/install-marker.json \u003c\u003c'BOOTWRIGHT_MARKER_EOF'\n@@BOOTWRIGHT_MARKER@@\nBOOTWRIGHT_MARKER_EOF\nchmod 0444 /etc/bootwright/install-marker.json\n/usr/bin/ssh-keygen -A\ninstall -m 0444 /etc/ssh/ssh_host_ed25519_key.pub /etc/bootwright/host-key.pub\ntest -s /etc/bootwright/host-key.pub\nif grep -q '^FILTER_RPC_ARGS=.*--allow-rpcs=' /etc/sysconfig/qemu-ga; then\nsed -i '/^FILTER_RPC_ARGS=/s/--allow-rpcs=/--allow-rpcs=guest-file-open,guest-file-close,guest-file-read,/' /etc/sysconfig/qemu-ga\ngrep -q '^FILTER_RPC_ARGS=.*--allow-rpcs=guest-file-open,guest-file-close,guest-file-read,' /etc/sysconfig/qemu-ga\nelif grep -q '^FILTER_RPC_ARGS=.*--block-rpcs=' /etc/sysconfig/qemu-ga; then\nsed -i '/^FILTER_RPC_ARGS=/s/guest-file-open,//;/^FILTER_RPC_ARGS=/s/guest-file-close,//;/^FILTER_RPC_ARGS=/s/guest-file-read,//' /etc/sysconfig/qemu-ga\n! grep -q '^FILTER_RPC_ARGS=.*guest-file-open' /etc/sysconfig/qemu-ga\nfi\ninstall -d -m 0750 /etc/sudoers.d\nprintf '%s\\n' 'bootwright ALL=(ALL) NOPASSWD: ALL' \u003e /etc/sudoers.d/60-bootwright\nchmod 0440 /etc/sudoers.d/60-bootwright\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'PasswordAuthentication no' 'PermitRootLogin prohibit-password' \u003e /etc/ssh/sshd_config.d/60-bootwright.conf\nchmod 0600 /etc/ssh/sshd_config.d/60-bootwright.conf\nrm -f /root/anaconda-ks.cfg /root/original-ks.cfg /run/install/ks.cfg\n%end\n",
  "markerPath": "/etc/bootwright/install-marker.json",
  "placement": {
    "connection": "local",
    "machine": "controller"
  },
  "target": {
    "channel": "guest-agent",
    "controller": {
      "credentialsRef": "lab-bmc-credentials",
      "endpoint": "http://192.0.2.1:8000/redfish/v1/Systems/7b9ec716-85d4-8e28-84d3-f0d571d55f15",
      "tlsVerify": true,
      "virtualMedia": {
        "removeCertificate": false,
        "restoreVerification": false,
        "trust": "established"
      }
    },
    "domain": "bootwright-lab-rhel-01",
    "physical": false,
    "substrate": "libvirt",
    "uri": "qemu:///system"
  },
  "tree": {
    "path": "/var/lib/bootwright-services/lab/artifact-server/lab-artifacts/public/os/rhel-9-8/tree",
    "url": "http://192.0.2.1:8080/os/rhel-9-8/tree"
