  "kickstart": "# Generated by Bootwright. Do not edit.\ntext\neula --agreed\npoweroff\n\nurl --url=http://192.0.2.1:8080/os/rhel-9-8/tree\nnetwork --bootproto=static --device=enp1s0 --ip=198.51.100.11 --netmask=255.255.255.0 --hostname=rhel-01.lab.example.test --onboot=on --activate --gateway=198.51.100.1 --nameserver=192.0.2.1\n\nlang en_US.UTF-8\nkeyboard --vckeymap=us\ntimezone Etc/UTC --utc --ntpservers=192.0.2.1\n\nrootpw --lock\nuser --name=bootwright --groups=wheel --lock\nsshkey --username=bootwright \"@@BOOTWRIGHT_AUTHORIZED_KEY@@\"\n\n%pre --erroronfail --interpreter=/bin/bash\nset -euo pipefail\numask 077\nexport LC_ALL=C\nif [ ! -c /dev/tpmrm0 ]; then\necho 'Bootwright: this machine presents no TPM 2.0 device at /dev/tpmrm0, which its root-disk encryption binds to; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\nbootwright_recovery=$(curl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem '@@BOOTWRIGHT_PRIVATE_URL@@/recovery')\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\nbootwright_class='^[]!$%\u0026(-[^-~]+$'\nif [ ${#bootwright_recovery} -lt 8 ] || [ ${#bootwright_recovery} -gt 256 ] || [[ ! ${bootwright_recovery} =~ ${bootwright_class} ]]; then\necho 'Bootwright: the recovery passphrase this installation fetched is not 8 to 256 printable characters free of spaces, quotes, backslashes and #; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nprintf '%s%s\\n' 'autopart --type=lvm --encrypted --luks-version=luks2 --passphrase=' \"${bootwright_recovery}\" \u003e /tmp/bootwright-storage.ks\nunset bootwright_recovery\n%end\n\nignoredisk --only-use=vda\nclearpart --all --initlabel --drives=vda\n%include /tmp/bootwright-storage.ks\n\nselinux --enforcing\n\nservices --enabled=chronyd,sshd\n\n%packages --excludedocs --exclude-weakdeps\n@^minimal-environment\nchrony\nclevis-dracut\nclevis-luks\nclevis-systemd\nnmstate\nqemu-guest-agent\n%end\n\n%post --erroronfail --interpreter=/bin/bash\nset -euo pipefail\numask 077\nexport LC_ALL=C\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\nbootwright_recovery=$(curl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem '@@BOOTWRIGHT_PRIVATE_URL@@/recovery')\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\nbootwright_bound=0\nfor bootwright_device in $(lsblk -rpno NAME,FSTYPE | awk '$2 == \"crypto_LUKS\" {print $1}'); do\nprintf '%s' \"${bootwright_recovery}\" | clevis luks bind -y -d \"${bootwright_device}\" -k - tpm2 '{}'\nbootwright_slot=$(clevis luks list -d \"${bootwright_device}\" | awk -F': ' '$2 ~ /^tpm2 / \u0026\u0026 !found {print $1; found=1}')\ntest -n \"${bootwright_slot}\"\nclevis luks pass -d \"${bootwright_device}\" -s \"${bootwright_slot}\" | cryptsetup open --test-passphrase --key-slot \"${bootwright_slot}\" --key-file - \"${bootwright_device}\"\nbootwright_bound=$((bootwright_bound + 1))\ndone\nunset bootwright_recovery\nif [ \"${bootwright_bound}\" -eq 0 ]; then\necho 'Bootwright: the installed system holds no LUKS device to bind to the TPM; refusing to finish an installation whose root disk is not encrypted.' \u003e\u00262\nexit 1\nfi\n/usr/bin/dracut -f --regenerate-all\n%end\n\n%post --erroronfail\nset -eu\ninstall -d -m 0755 /etc/bootwright\ncat \u003e /etc/bootwright/install-marker.json \u003c\u003c'BOOTWRIGHT_MARKER_EOF'\n@@BOOTWRIGHT_MARKER@@\nBOOTWRIGHT_MARKER_EOF\nchmod 0444 /etc/bootwright/install-marker.json\n/usr/bin/ssh-keygen -A\ninstall -m 0444 /etc/ssh/ssh_host_ed25519_key.pub /etc/bootwright/host-key.pub\ntest -s /etc/bootwright/host-key.pub\nif grep -q '^FILTER_RPC_ARGS=.*--allow-rpcs=' /etc/sysconfig/qemu-ga; then\nsed -i '/^FILTER_RPC_ARGS=/s/--allow-rpcs=/--allow-rpcs=guest-file-open,guest-file-close,guest-file-read,/' /etc/sysconfig/qemu-ga\ngrep -q '^FILTER_RPC_ARGS=.*--allow-rpcs=guest-file-open,guest-file-close,guest-file-read,' /etc/sysconfig/qemu-ga\nelif grep -q '^FILTER_RPC_ARGS=.*--block-rpcs=' /etc/sysconfig/qemu-ga; then\nsed -i '/^FILTER_RPC_ARGS=/s/guest-file-open,//;/^FILTER_RPC_ARGS=/s/guest-file-close,//;/^FILTER_RPC_ARGS=/s/guest-file-read,//' /etc/sysconfig/qemu-ga\n! grep -q '^FILTER_RPC_ARGS=.*guest-file-open' /etc/sysconfig/qemu-ga\nfi\ninstall -d -m 0750 /etc/sudoers.d\nprintf '%s\\n' 'bootwright ALL=(ALL) NOPASSWD: ALL' \u003e /etc/sudoers.d/60-bootwright\nchmod 0440 /etc/sudoers.d/60-bootwright\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'PasswordAuthentication no' 'PermitRootLogin prohibit-password' \u003e /etc/ssh/sshd_config.d/60-bootwright.conf\nchmod 0600 /etc/ssh/sshd_config.d/60-bootwright.conf\nrm -f /root/anaconda-ks.cfg /root/original-ks.cfg /run/install/ks.cfg\n%end\n",
