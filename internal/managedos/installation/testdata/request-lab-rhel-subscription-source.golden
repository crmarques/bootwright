  "kickstart": "# Generated by Bootwright. Do not edit.\ntext\neula --agreed\npoweroff\n\n%include /tmp/bootwright-rhsm.ks\nnetwork --bootproto=static --device=enp1s0 --ip=198.51.100.11 --netmask=255.255.255.0 --hostname=rhel-01.lab.example.test --onboot=on --activate --gateway=198.51.100.1 --nameserver=192.0.2.1\n\nlang en_US.UTF-8\nkeyboard --vckeymap=us\ntimezone Etc/UTC --utc\ntimesource --ntp-server=192.0.2.1\n\nrootpw --lock\nuser --name=bootwright --groups=wheel --lock\nsshkey --username=bootwright \"@@BOOTWRIGHT_AUTHORIZED_KEY@@\"\n\n%pre --erroronfail --interpreter=/bin/bash\nset -euo pipefail\numask 077\nexport LC_ALL=C\nmkdir -p /run/NetworkManager/system-connections\nchmod 0700 /run/NetworkManager/system-connections\ncat \u003e /run/NetworkManager/system-connections/bootwright-installer-0.nmconnection \u003c\u003c'BOOTWRIGHT_NETWORK_EOF'\n[connection]\nid=enp1s0\nuuid=290c06fa-8bd9-8b1d-a85b-8f3174224c75\ntype=ethernet\ninterface-name=enp1s0\nautoconnect=false\n\n[ipv4]\nmethod=manual\naddress1=198.51.100.11/24\ngateway=198.51.100.1\ndns=192.0.2.1;\nmay-fail=false\n\n[ipv6]\nmethod=auto\nmay-fail=true\nBOOTWRIGHT_NETWORK_EOF\nchmod 0600 /run/NetworkManager/system-connections/bootwright-installer-0.nmconnection\nnmcli --wait 60 connection load /run/NetworkManager/system-connections/bootwright-installer-0.nmconnection\nnmcli --wait 60 connection up uuid 290c06fa-8bd9-8b1d-a85b-8f3174224c75\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\nbootwright_organization=$(curl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem '@@BOOTWRIGHT_PRIVATE_URL@@/rhsm-organization')\nbootwright_activation_key=$(curl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem '@@BOOTWRIGHT_PRIVATE_URL@@/rhsm-activation-key')\nmkdir -p /etc/rhsm/ca\ncurl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem --output /etc/rhsm/ca/bootwright-satellite.pem '@@BOOTWRIGHT_PRIVATE_URL@@/rhsm-satellite-ca'\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\nchmod 0644 /etc/rhsm/ca/bootwright-satellite.pem\ntest -s /etc/rhsm/ca/bootwright-satellite.pem\nbootwright_class='^[]!$%\u0026(-[^-~]{1,255}$'\nif [[ ! ${bootwright_organization} =~ ${bootwright_class} || ! ${bootwright_activation_key} =~ ${bootwright_class} ]]; then\necho 'Bootwright: the organization or activation key this installation fetched is not 1 to 255 printable characters free of spaces, quotes, backslashes and #; refusing before it registers.' \u003e\u00262\nexit 1\nfi\n/usr/bin/python3 -I - \u003c\u003c'BOOTWRIGHT_RHSM_TRUST_EOF'\nfrom dasbus.connection import SystemMessageBus\nfrom dasbus.typing import Str, get_variant\nsettings = {\"server.prefix\": \"/rhsm\", \"server.port\": \"443\", \"server.insecure\": \"0\", \"rhsm.repo_ca_cert\": \"/etc/rhsm/ca/bootwright-satellite.pem\"}\nconfig = SystemMessageBus().get_proxy(\"com.redhat.RHSM1\", \"/com/redhat/RHSM1/Config\")\nconfig.SetAll({key: get_variant(Str, value) for key, value in settings.items()}, \"\")\nfor key, value in settings.items():\n    if config.Get(key, \"\").unpack() != value:\n        raise SystemExit(\"Bootwright: the installer's subscription service did not take the Satellite setting \" + key + \"; refusing before it registers.\")\nBOOTWRIGHT_RHSM_TRUST_EOF\nprintf 'rhsm --organization=%s --activation-key=%s --server-hostname=%s --rhsm-baseurl=%s\\n' \"${bootwright_organization}\" \"${bootwright_activation_key}\" 'not-satellite:satellite.example.test' 'https://capsule.example.test/pulp/content' \u003e /tmp/bootwright-rhsm.ks\nunset bootwright_organization bootwright_activation_key\n%end\n\nignoredisk --only-use=vda\nclearpart --all --initlabel --drives=vda\nautopart --type=lvm\n\nselinux --enforcing\n\nservices --enabled=chronyd,sshd\n\n%packages --excludedocs --exclude-weakdeps\n@^minimal-environment\nchrony\nnmstate\nqemu-guest-agent\nsubscription-manager\n%end\n\n%post --erroronfail\nset -eu\ninstall -d -m 0755 /etc/bootwright\ncat \u003e /etc/bootwright/install-marker.json \u003c\u003c'BOOTWRIGHT_MARKER_EOF'\n@@BOOTWRIGHT_MARKER@@\nBOOTWRIGHT_MARKER_EOF\nchmod 0444 /etc/bootwright/install-marker.json\n/usr/bin/ssh-keygen -A\ninstall -m 0444 /etc/ssh/ssh_host_ed25519_key.pub /etc/bootwright/host-key.pub\ntest -s /etc/bootwright/host-key.pub\nif grep -q '^FILTER_RPC_ARGS=.*--allow-rpcs=' /etc/sysconfig/qemu-ga; then\nsed -i '/^FILTER_RPC_ARGS=/s/--allow-rpcs=/--allow-rpcs=guest-file-open,guest-file-close,guest-file-read,/' /etc/sysconfig/qemu-ga\ngrep -q '^FILTER_RPC_ARGS=.*--allow-rpcs=guest-file-open,guest-file-close,guest-file-read,' /etc/sysconfig/qemu-ga\nelif grep -q '^FILTER_RPC_ARGS=.*--block-rpcs=' /etc/sysconfig/qemu-ga; then\nsed -i '/^FILTER_RPC_ARGS=/s/guest-file-open,//;/^FILTER_RPC_ARGS=/s/guest-file-close,//;/^FILTER_RPC_ARGS=/s/guest-file-read,//' /etc/sysconfig/qemu-ga\n! grep -q '^FILTER_RPC_ARGS=.*guest-file-open' /etc/sysconfig/qemu-ga\nfi\ntest -s /etc/pki/consumer/cert.pem\nprintf '{\"consumer\":\"\",\"request\":\"%s\"}\\n' '@@BOOTWRIGHT_REQUEST_DIGEST@@' \u003e /etc/bootwright/registration.json\nchmod 0600 /etc/bootwright/registration.json\ninstall -d -m 0750 /etc/sudoers.d\nprintf '%s\\n' 'bootwright ALL=(ALL) NOPASSWD: ALL' \u003e /etc/sudoers.d/60-bootwright\nchmod 0440 /etc/sudoers.d/60-bootwright\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'PasswordAuthentication no' 'PermitRootLogin prohibit-password' \u003e /etc/ssh/sshd_config.d/60-bootwright.conf\nchmod 0600 /etc/ssh/sshd_config.d/60-bootwright.conf\nrm -f /root/anaconda-ks.cfg /root/original-ks.cfg /run/install/ks.cfg\n%end\n%post --nochroot --erroronfail\nset -eu\nmkdir -p /mnt/sysimage/etc/rhsm/ca\ncat /etc/rhsm/ca/bootwright-satellite.pem \u003e /mnt/sysimage/etc/rhsm/ca/bootwright-satellite.pem\nchmod 0644 /mnt/sysimage/etc/rhsm/ca/bootwright-satellite.pem\n%end\n",
