  "kickstart": "# Generated by Bootwright. Do not edit.\ntext\neula --agreed\npoweroff\n\nurl --url=http://192.0.2.1:8080/os/rhel-9-8/tree\nnetwork --bootproto=static --device=enp1s0 --ip=198.51.100.41 --netmask=255.255.255.0 --hostname=metal-01.lab.example.test --onboot=on --activate --gateway=198.51.100.1 --nameserver=192.0.2.1\n\nlang en_US.UTF-8\nkeyboard --vckeymap=us\ntimezone Etc/UTC --utc --ntpservers=192.0.2.1\n\nrootpw --lock\nuser --name=bootwright --groups=wheel --lock\nsshkey --username=bootwright \"@@BOOTWRIGHT_AUTHORIZED_KEY@@\"\n\n%pre --erroronfail --interpreter=/bin/bash\nset -euo pipefail\nbootwright_observed=$(cat /sys/class/net/*/address | tr 'A-Z' 'a-z' | sort -u)\nif ! printf '%s\\n' \"${bootwright_observed}\" | grep -Fqx '52:54:00:9a:1b:01'; then\necho 'Bootwright: this machine does not report 52:54:00:9a:1b:01, which its declaration requires; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nbootwright_root=$(readlink -f -- '/dev/sda' || true)\nif [ -z \"${bootwright_root}\" ] || [ ! -b \"${bootwright_root}\" ]; then\necho 'Bootwright: the declared root device /dev/sda is not a block device here; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nif [ \"$(lsblk -ndo TYPE -- \"${bootwright_root}\")\" != disk ]; then\necho 'Bootwright: the declared root device /dev/sda is not a whole disk; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\n%end\n\n%pre --erroronfail --interpreter=/bin/bash\nset -euo pipefail\numask 077\nexport LC_ALL=C\nif [ ! -c /dev/tpmrm0 ]; then\necho 'Bootwright: this machine presents no TPM 2.0 device at /dev/tpmrm0, which its root-disk encryption binds to; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\nbootwright_recovery=$(curl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem '@@BOOTWRIGHT_PRIVATE_URL@@/recovery')\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\nbootwright_class='^[]!$%\u0026(-[^-~]+$'\nif [ ${#bootwright_recovery} -lt 8 ] || [ ${#bootwright_recovery} -gt 256 ] || [[ ! ${bootwright_recovery} =~ ${bootwright_class} ]]; then\necho 'Bootwright: the recovery passphrase this installation fetched is not 8 to 256 printable characters free of spaces, quotes, backslashes and #; refusing before any disk is touched.' \u003e\u00262\nexit 1\nfi\nprintf '%s%s\\n' 'autopart --type=lvm --encrypted --luks-version=luks2 --pbkdf=pbkdf2 --passphrase=' \"${bootwright_recovery}\" \u003e /tmp/bootwright-storage.ks\nunset bootwright_recovery\n%end\n\nignoredisk --only-use=sda\nclearpart --all --initlabel --drives=sda\n%include /tmp/bootwright-storage.ks\n\nselinux --enforcing\n\nservices --enabled=chronyd,sshd\n\n%packages --excludedocs --exclude-weakdeps\n@^minimal-environment\nchrony\nclevis-dracut\nclevis-luks\nclevis-systemd\nnmstate\nsubscription-manager\n%end\n\n%post --erroronfail --interpreter=/bin/bash\nset -euo pipefail\numask 077\nexport LC_ALL=C\nbootwright_root=$(readlink -f -- '/dev/sda')\ntest -n \"${bootwright_root}\"\ntest \"$(lsblk -dnro TYPE -- \"${bootwright_root}\")\" = disk\nbootwright_root_source=$(findmnt -nvo SOURCE /)\ntest -n \"${bootwright_root_source}\"\nbootwright_parents=$(lsblk -srpn -o NAME,TYPE -- \"${bootwright_root_source}\" | awk '$2 == \"disk\" {print $1}' | sort -u)\ntest \"${bootwright_parents}\" = \"${bootwright_root}\"\nbootwright_tree=$(lsblk -rpn -o NAME,TYPE,FSTYPE -- \"${bootwright_root}\")\nbootwright_luks=$(printf '%s\\n' \"${bootwright_tree}\" | awk '$3 == \"crypto_LUKS\" {print $1}' | sort -u)\ntest -n \"${bootwright_luks}\"\nmapfile -t bootwright_devices \u003c\u003c\u003c \"${bootwright_luks}\"\nfor bootwright_device in \"${bootwright_devices[@]}\"; do\nbootwright_parents=$(lsblk -srpn -o NAME,TYPE -- \"${bootwright_device}\" | awk '$2 == \"disk\" {print $1}' | sort -u)\ntest \"${bootwright_parents}\" = \"${bootwright_root}\"\ndone\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\nbootwright_recovery=$(curl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem '@@BOOTWRIGHT_PRIVATE_URL@@/recovery')\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\nbootwright_bound=0\nfor bootwright_device in \"${bootwright_devices[@]}\"; do\nprintf '%s' \"${bootwright_recovery}\" | clevis luks bind -y -d \"${bootwright_device}\" -k - tpm2 '{}'\nbootwright_slot=$(clevis luks list -d \"${bootwright_device}\" | awk -F': ' '$2 ~ /^tpm2 / \u0026\u0026 !found {print $1; found=1}')\ntest -n \"${bootwright_slot}\"\nclevis luks pass -d \"${bootwright_device}\" -s \"${bootwright_slot}\" | cryptsetup open --test-passphrase --key-slot \"${bootwright_slot}\" --key-file - \"${bootwright_device}\"\nbootwright_bound=$((bootwright_bound + 1))\ndone\nunset bootwright_recovery\nif [ \"${bootwright_bound}\" -eq 0 ]; then\necho 'Bootwright: the installed system holds no LUKS device to bind to the TPM; refusing to finish an installation whose root disk is not encrypted.' \u003e\u00262\nexit 1\nfi\n/usr/bin/dracut -f --regenerate-all\n%end\n\n%post --erroronfail\nset -eu\ninstall -d -m 0755 /etc/bootwright\ncat \u003e /etc/bootwright/install-marker.json \u003c\u003c'BOOTWRIGHT_MARKER_EOF'\n@@BOOTWRIGHT_MARKER@@\nBOOTWRIGHT_MARKER_EOF\nchmod 0444 /etc/bootwright/install-marker.json\ninstall -d -m 0755 /etc/ssh\ncat \u003e /tmp/bootwright-artifact-ca.pem \u003c\u003c'BOOTWRIGHT_ARTIFACT_CA_EOF'\n@@BOOTWRIGHT_ARTIFACT_CERTIFICATE@@\nBOOTWRIGHT_ARTIFACT_CA_EOF\ncurl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem --output /etc/ssh/ssh_host_ecdsa_key '@@BOOTWRIGHT_PRIVATE_URL@@/identity'\ncurl --fail --silent --show-error --cacert /tmp/bootwright-artifact-ca.pem --output /etc/ssh/ssh_host_ecdsa_key.pub '@@BOOTWRIGHT_PRIVATE_URL@@/identity.pub'\nchmod 0600 /etc/ssh/ssh_host_ecdsa_key\nchmod 0644 /etc/ssh/ssh_host_ecdsa_key.pub\ntest -s /etc/ssh/ssh_host_ecdsa_key\ntest \"$(cut -d' ' -f1 /etc/ssh/ssh_host_ecdsa_key.pub)\" = 'ecdsa-sha2-nistp256'\ntest \"$(/usr/bin/ssh-keygen -y -f /etc/ssh/ssh_host_ecdsa_key | cut -d' ' -f1,2)\" = \"$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ecdsa_key.pub)\"\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'HostKey /etc/ssh/ssh_host_ecdsa_key' \u003e /etc/ssh/sshd_config.d/40-bootwright-host-key.conf\nchmod 0600 /etc/ssh/sshd_config.d/40-bootwright-host-key.conf\n/usr/bin/ssh-keygen -A\nshred -u /tmp/bootwright-artifact-ca.pem 2\u003e/dev/null || rm -f /tmp/bootwright-artifact-ca.pem\ninstall -d -m 0750 /etc/sudoers.d\nprintf '%s\\n' 'bootwright ALL=(ALL) NOPASSWD: ALL' \u003e /etc/sudoers.d/60-bootwright\nchmod 0440 /etc/sudoers.d/60-bootwright\ninstall -d -m 0755 /etc/ssh/sshd_config.d\nprintf '%s\\n' 'PasswordAuthentication no' 'PermitRootLogin prohibit-password' \u003e /etc/ssh/sshd_config.d/60-bootwright.conf\nchmod 0600 /etc/ssh/sshd_config.d/60-bootwright.conf\nrm -f /root/anaconda-ks.cfg /root/original-ks.cfg /run/install/ks.cfg\n%end\n",
