[Unit]
Description=Bootwright management controller for rhel-01
After=network-online.target libvirtd.service

[Container]
ContainerName=bootwright-lab-rhel-rhel-01-bmc
Image=registry.example.test/sushy-tools@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
Network=host
User=0
SecurityLabelDisable=true
Entrypoint=/usr/local/bin/sushy-emulator
Exec=--config /etc/sushy/conf.py
StopSignal=SIGINT
Volume=/var/lib/bootwright-substrate/lab-rhel/rhel-01/conf.py:/etc/sushy/conf.py:ro
Volume=/var/lib/bootwright-substrate/lab-rhel/rhel-01/htpasswd:/etc/sushy/htpasswd:ro
Volume=/run/libvirt:/run/libvirt:rw

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
