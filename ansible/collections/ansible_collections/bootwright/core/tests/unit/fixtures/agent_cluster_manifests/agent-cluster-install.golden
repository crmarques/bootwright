apiVersion: extensions.hive.openshift.io/v1beta1
kind: AgentClusterInstall
metadata:
  name: sno
spec:
  clusterDeploymentRef:
    name: sno
  imageSetRef:
    name: openshift-4.21.10
  networking:
    clusterNetwork:
    - cidr: 10.128.0.0/14
      hostPrefix: 23
    machineNetwork:
    - cidr: 198.51.100.0/24
    networkType: OVNKubernetes
    serviceNetwork:
    - 172.30.0.0/16
    userManagedNetworking: true
  platformType: None
  provisionRequirements:
    controlPlaneAgents: 1
status:
  debugInfo:
    eventsURL: ""
    logsURL: ""
  progress:
    totalPercentage: 0
