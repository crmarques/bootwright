---
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: {{ bootwright_current_cluster.name }}-{{ bootwright_component.name }}
  namespace: {{ bootwright_component.kubevirt.namespace }}
  labels:
    bootwright.io/context: {{ bootwright_clusters_dir | dirname | basename }}
    bootwright.io/cluster: {{ bootwright_current_cluster.name }}
    bootwright.io/node: {{ bootwright_component.name }}
    bootwright.io/role: {{ bootwright_kubevirt_node.value.role }}
    bootwright.io/managed-by: bootwright
spec:
  running: false
  template:
    metadata:
      labels:
        bootwright.io/context: {{ bootwright_clusters_dir | dirname | basename }}
        bootwright.io/cluster: {{ bootwright_current_cluster.name }}
        bootwright.io/node: {{ bootwright_component.name }}
        kubevirt.io/vm: {{ bootwright_current_cluster.name }}-{{ bootwright_component.name }}
    spec:
      domain:
        cpu:
          cores: {{ bootwright_component.profile.cpu | default(1, true) }}
        memory:
          guest: {{ bootwright_component.profile.memoryMiB | default(4096, true) }}Mi
        devices:
          disks:
            # Boot the installed root disk first. On the very first boot it is
            # blank and unbootable, so firmware falls through to the agent-iso
            # cdrom and the agent install runs. Once RHCOS is written, the root
            # disk boots directly; the still-attached ISO is never re-entered.
            # (KubeVirt bootOrder is persistent, unlike one-time BMC media, so a
            # cdrom-first order would re-run the live ISO on every reboot.)
            - name: root
              disk:
                bus: virtio
              bootOrder: 1
            - name: agent-iso
              cdrom:
                bus: sata
              bootOrder: 2
          interfaces:
{% for iface in bootwright_component.interfaces | default([]) %}
            - name: {{ iface.name }}
              bridge: {}
{% if iface.macAddress | default('') | length > 0 %}
              macAddress: "{{ iface.macAddress }}"
{% endif %}
{% endfor %}
      networks:
{% for iface in bootwright_component.interfaces | default([]) %}
        - name: {{ iface.name }}
          multus:
            networkName: {{ bootwright_kubevirt_nad }}
{% endfor %}
      volumes:
        - name: agent-iso
          dataVolume:
            name: {{ bootwright_current_cluster.name }}-{{ bootwright_component.name }}-agent-iso
        - name: root
          dataVolume:
            name: {{ bootwright_current_cluster.name }}-{{ bootwright_component.name }}-root
