---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ network.name }}
  namespace: {{ network_namespace }}
  labels:
    bootwright.io/context: {{ bootwright_clusters_dir | dirname | basename }}
    bootwright.io/cluster: {{ bootwright_current_cluster.name }}
    bootwright.io/network: {{ network.name }}
    bootwright.io/managed-by: bootwright
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "{{ network.name }}",
      "type": "bridge",
      "bridge": "{{ network.bridge }}",
      "macspoofchk": false,
      "preserveDefaultVlan": false
    }
