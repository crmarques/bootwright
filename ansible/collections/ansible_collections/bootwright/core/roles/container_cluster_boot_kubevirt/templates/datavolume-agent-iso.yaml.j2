---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataVolume
metadata:
  name: {{ bootwright_kubevirt_iso_dv_name }}
  namespace: {{ bootwright_kubevirt_namespace }}
  annotations:
    cdi.kubevirt.io/storage.bind.immediate.requested: "true"
  labels:
    bootwright.io/context: {{ bootwright_kubevirt_context_name }}
    bootwright.io/cluster: {{ bootwright_current_cluster.name }}
    bootwright.io/node: {{ bootwright_component.name }}
    bootwright.io/role: agent-iso
    bootwright.io/agent-iso-generation: {{ bootwright_kubevirt_iso_generation }}
    bootwright.io/managed-by: bootwright
spec:
  source:
    pvc:
      namespace: {{ bootwright_kubevirt_namespace }}
      name: {{ bootwright_kubevirt_iso_source_dv_name }}
  # Ask for the target through spec.storage, never spec.pvc, and name neither
  # accessModes nor volumeMode. CDI copies spec.pvc through verbatim but fills
  # spec.storage in from the StorageProfile of the class — the same inference
  # virtctl image-upload used to build the shared source. That symmetry is what
  # keeps the pair clonable: a hand-written target lands on Filesystem at exactly
  # the requested size, and cloning a Block source into it disqualifies both
  # smart-clone strategies and then stalls the host-assisted copy at
  # CloneInProgress, which CDI never resolves into Failed.
  storage:
    resources:
      requests:
        storage: {{ bootwright_kubevirt_agent_iso_size }}
{% if bootwright_kubevirt_storage_class | default('') | length > 0 %}
    storageClassName: {{ bootwright_kubevirt_storage_class }}
{% endif %}
