{#
  Quadlet definition for one managed proxy. The container runs as root so
  the declared port is served exactly as authored, and the image entrypoint is
  never used: the frozen request alone decides what runs.
#}
[Unit]
Description=Bootwright managed proxy {{ bootwright_proxy_request.identity.service }}
After=network-online.target
Wants=network-online.target

[Container]
Image={{ bootwright_proxy_request.image }}
ContainerName={{ bootwright_proxy_request.unit }}
Network=host
User=0
Entrypoint=/usr/sbin/squid
Exec=-f /etc/squid/squid.conf -N
Volume={{ infra_proxy_squid_config_dir }}/squid.conf:/etc/squid/squid.conf:ro,Z

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
