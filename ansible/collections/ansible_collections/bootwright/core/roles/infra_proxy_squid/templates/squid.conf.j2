{#
  The client set is derived from the selected graph, never authored, so a
  managed proxy is never planned open to the world. Caching is disabled: this
  proxy exists to reach a publisher, not to store what it fetched.
#}
http_port {{ infra_proxy_squid_listen }}:{{ bootwright_proxy_request.port }}

{% for client in bootwright_proxy_request.clients | default([]) %}
acl bootwright_clients src {{ client }}
{% endfor %}
http_access allow bootwright_clients
http_access deny all

cache deny all
access_log none
pid_filename none
via off
forwarded_for delete
