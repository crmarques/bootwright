# Generated by Bootwright.
text
eula --agreed
firstboot --disable
skipx
reboot --eject
{% set installer = bootwright_component.osInstall.installer | default({}) %}
{% set rhsm = installer.rhsm | default({}) %}
{% if rhsm.enabled | default(false) %}
rhsm --organization="{{ lookup('ansible.builtin.file', rhsm.organizationPath) | trim }}" --activation-key="{{ lookup('ansible.builtin.file', rhsm.activationKeyPath) | trim }}"{% if rhsm.connectToInsights | default(false) %} --connect-to-insights{% endif %}
{% elif installer.sourceURL | default('') | length > 0 %}
url --url={{ installer.sourceURL }}
{% else %}
cdrom
{% endif %}
lang en_US.UTF-8
keyboard us
timezone UTC --utc
rootpw --lock

{% set ks = bootwright_component.osInstall.kickstart %}
{% set net = ks.network | default({}) %}
{% if (net.bootproto | default('dhcp')) == 'static' %}
network --device={{ net.device | default('link') }} --bootproto=static --ip={{ net.ip }}{% if net.netmask | default('') | length > 0 %} --netmask={{ net.netmask }}{% endif %}{% if net.gateway | default('') | length > 0 %} --gateway={{ net.gateway }}{% endif %}{% if net.dnsServers | default([]) | length > 0 %} --nameserver={{ net.dnsServers | join(',') }}{% endif %} --activate --onboot=yes --hostname={{ ks.hostname }}
{% else %}
network --device={{ net.device | default('link') }} --bootproto=dhcp{% if net.dnsServers | default([]) | length > 0 %} --nameserver={{ net.dnsServers | join(',') }}{% endif %} --activate --onboot=yes --hostname={{ ks.hostname }}
{% endif %}

{% for repo in installer.repositories | default([]) %}
repo --name="{{ repo.id }}" --baseurl={{ repo.baseURL }}
{% endfor %}

{% set storage = ks.storage | default({}) %}
{% if storage.rootDisk | default('') | length > 0 %}
ignoredisk --only-use={{ storage.rootDisk }}
zerombr
clearpart --all --initlabel --drives={{ storage.rootDisk }}
bootloader --location=mbr --boot-drive={{ storage.rootDisk }}
reqpart --add-boot
part swap --recommended --ondisk={{ storage.rootDisk }}
part / --fstype=xfs --size=10240 --grow --ondisk={{ storage.rootDisk }}
{% else %}
zerombr
clearpart --all --initlabel
autopart --type=lvm --fstype=xfs
{% endif %}

{% if ks.services | default([]) | length > 0 %}
services --enabled={{ ks.services | join(',') }}
{% endif %}

{% set ssh_key = '' %}
{% if (ks.authorizeMachineSSHKey | default(false)) and (ks.sshPublicKeyPath | default('') | length > 0) %}
{% set ssh_key = lookup('ansible.builtin.file', ks.sshPublicKeyPath) %}
{% endif %}
{% if (ks.sshUser | default('root')) != 'root' %}
user --name={{ ks.sshUser }} --groups=wheel --lock
{% endif %}
{% if ssh_key | length > 0 %}
sshkey --username={{ ks.sshUser | default('root') }} "{{ ssh_key | trim }}"
{% endif %}

%packages
@^minimal-environment
{% for package in ks.packages | default([]) %}
{{ package }}
{% endfor %}
%end

%post --log=/root/bootwright-ks-post.log
{% if (ks.sshUser | default('root')) != 'root' %}
echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/99-bootwright-wheel
chmod 0440 /etc/sudoers.d/99-bootwright-wheel
{% endif %}
{% if not (ks.passwordAuthentication | default(false)) %}
sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication no/' /etc/ssh/sshd_config
{% endif %}
systemctl enable sshd
%end
