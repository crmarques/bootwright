{% if encrypted %}
# Bind every LUKS container Anaconda just created to this machine's TPM 2.0 so it
# unlocks unattended, then rebuild the initramfs so the clevis dracut module is in
# it. This runs before the %post that writes the install marker: --erroronfail
# halts the install on failure, and because the marker is never written the next
# apply sees an uninstalled machine rather than an installed-but-unencrypted one.
# The passphrase keyslot is deliberately kept — Red Hat's policy-based decryption
# guidance is that a TPM whose PCRs move must still have a human way in.
%post --erroronfail --interpreter=/bin/bash --log=/root/bootwright-ks-luks.log
set -euo pipefail

if [[ ! -e /dev/tpmrm0 && ! -e /dev/tpm0 ]]; then
    echo 'Bootwright: no TPM 2.0 device in the installed system' >&2
    exit 1
fi
tpm2_getcap properties-fixed >/dev/null

bootwright_luks_key=$(mktemp)
chmod 0600 "${bootwright_luks_key}"
trap 'shred -u "${bootwright_luks_key}" 2>/dev/null || true' EXIT
cat > "${bootwright_luks_key}" <<'BOOTWRIGHT_LUKS_PASSPHRASE'
{{ luks_passphrase }}
BOOTWRIGHT_LUKS_PASSPHRASE
truncate -s -1 "${bootwright_luks_key}"

# lsblk rather than blkid: the %post chroot can inherit a stale blkid cache from
# the installer runtime. The devices are counted in the loop rather than held in
# a bash array, whose length operator would open a Jinja comment here.
bootwright_luks_seen=0
for bootwright_luks_device in $(lsblk -p -n -l -o NAME,FSTYPE | awk '$2 == "crypto_LUKS" { print $1 }'); do
    bootwright_luks_seen=$((bootwright_luks_seen + 1))
    if clevis luks list -d "${bootwright_luks_device}" 2>/dev/null | grep -q '{{ clevis.pin }}'; then
        continue
    fi
    clevis luks bind -y -d "${bootwright_luks_device}" -k "${bootwright_luks_key}" {{ clevis.pin }} '{{ clevis.config }}'
    clevis luks list -d "${bootwright_luks_device}"
done

if [ "${bootwright_luks_seen}" -eq 0 ]; then
    echo 'Bootwright: partitioning produced no crypto_LUKS device to bind' >&2
    exit 1
fi

dracut -fv --regenerate-all
%end

