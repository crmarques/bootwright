    echo 'Bootwright: this MachineInstallProfile enables disk encryption unlocked by TPM 2.0, but the kernel exposed no /dev/tpmrm0 or /dev/tpm0 on this machine. Enable the TPM in firmware, or drop customizations.security.diskEncryption from the profile.' >&2
