{#
  Serving configuration for one managed artifact server. The worker identity is
  the image's own application user and its root group, because the image's
  writable runtime paths are group-0 owned and no group named for that user
  exists.
#}
user default root;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format fetch '$remote_addr [$time_iso8601] $ssl_protocol $ssl_cipher $request_method $status $body_bytes_sent';
    access_log /dev/stdout fetch;
    server_tokens off;
    sendfile on;
    keepalive_timeout 30;

{% for listener in bootwright_artifact_server_request.listeners %}
    server {
        listen {{ infra_artifact_server_nginx_listen }}:{{ listener.port }}{% if listener.protocol == 'https' %} ssl{% endif %};

{% if listener.protocol == 'https' %}
        ssl_certificate {{ infra_artifact_server_nginx_tls_dir }}/server.crt;
        ssl_certificate_key {{ infra_artifact_server_nginx_tls_dir }}/server.key;
        ssl_protocols {{ infra_artifact_server_nginx_protocols }};
        ssl_prefer_server_ciphers off;
        ssl_session_timeout 10m;
{% endif %}
{% if bootwright_artifact_server_request.receiptRoot is defined %}
        # Request parsing errors must not log a private callback route.
        error_log /dev/null crit;
{% if listener.protocol == 'https' %}
        location ~ "^/_bootwright/inventory/(?<receipt_id>[0-9a-f]{32})$" {
            access_log off;
            if ($request_method != POST) { return 405; }
            if ($http_transfer_encoding != "") { return 400; }
            if ($http_content_length = "") { return 411; }
            client_max_body_size 48k;
            client_body_buffer_size 64k;
            client_body_in_single_buffer on;
            client_body_timeout 10s;
            proxy_request_buffering on;
            proxy_buffering off;
            proxy_connect_timeout 2s;
            proxy_send_timeout 10s;
            proxy_read_timeout 10s;
            proxy_pass_request_headers off;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Content-Length $http_content_length;
            proxy_pass http://unix:{{ bootwright_artifact_server_request.receiptRoot }}/$receipt_id:/report;
        }
{% endif %}
        location /_bootwright/ { return 404; }
{% endif %}
        root {{ infra_artifact_server_nginx_served_dir }};
        autoindex off;

        location / {
            try_files $uri =404;
        }
    }

{% endfor %}
}
