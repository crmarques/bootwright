{#
  chronyd runs with -x, so it serves time without disciplining the host clock
  and coexists with the controller's own time service. A local stratum keeps the
  lab answering when no upstream is reachable; orphan mode would answer
  stratum 0 until peers agree, which is not an answer a client can use.
#}
bindaddress {{ bootwright_managed_service_request.bindAddress }}
port {{ bootwright_managed_service_request.port }}
cmdport 0

{% for client in bootwright_managed_service_request.clients | default([]) %}
allow {{ client }}
{% endfor %}
{% for source in bootwright_managed_service_request.sources | default([]) %}
server {{ source }} iburst
{% endfor %}
local stratum 10
