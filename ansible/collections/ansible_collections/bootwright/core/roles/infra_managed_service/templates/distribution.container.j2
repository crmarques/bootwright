{#
  Quadlet definition for one managed registry. The container runs as root so
  the declared port is served exactly as authored, and the image entrypoint is
  never used: the frozen request alone decides what runs. Its certificate and
  password file are mounted read-only from their private directories, and its
  storage from the content root, which a removal takes back with the rest. The
  level is pinned and the storage keeps the label the apply gave it once, so no
  start relabels a store that may be large.
#}
[Unit]
Description=Bootwright managed registry {{ bootwright_managed_service_request.identity.service }}
After=network-online.target
Wants=network-online.target

[Container]
Image={{ bootwright_managed_service_request.image }}
ContainerName={{ bootwright_managed_service_request.unit }}
Network=host
User=0
Entrypoint=/bin/registry
Exec=serve /etc/distribution/config.yml
Environment=OTEL_TRACES_EXPORTER=none
SecurityLabelLevel={{ infra_managed_service_label_level }}
Volume={{ infra_managed_service_config_dir }}/config.yml:/etc/distribution/config.yml:ro,Z
Volume={{ infra_managed_service_tls_dir }}:/etc/distribution/tls:ro,Z
Volume={{ infra_managed_service_auth_dir }}:/etc/distribution/auth:ro,Z
Volume={{ infra_managed_service_data_dir }}:/var/lib/registry

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
