{#- The unit sets Entrypoint and Exec explicitly and never runs the image's own
    wrapper, because that wrapper starts the emulator with its debugger active.
    Host networking is what makes the declared bind address the real socket.
    The emulator uploads inserted media into the provider's pool through the
    libvirt socket, so beside its own configuration and password file that
    socket directory is the only host path it mounts, and connecting to it is
    why its SELinux confinement is disabled. The emulator runs as PID 1 with no
    SIGTERM handler, so SIGTERM would wait for podman's timeout and SIGKILL and
    leave the unit failed; Python's SIGINT handler ends werkzeug's server, so
    the unit stops it with SIGINT and stops cleanly. -#}
[Unit]
Description=Bootwright management controller for {{ bootwright_substrate_machine_request.identity.object }}
After=network-online.target libvirtd.service

[Container]
ContainerName={{ bootwright_substrate_machine_request.controller.unit }}
Image={{ bootwright_substrate_machine_request.controller.image }}
Network=host
User=0
SecurityLabelDisable=true
Entrypoint=/usr/local/bin/sushy-emulator
Exec=--config /etc/sushy/conf.py
StopSignal=SIGINT
Volume={{ substrate_libvirt_machine_state }}/conf.py:/etc/sushy/conf.py:ro
Volume={{ substrate_libvirt_machine_state }}/htpasswd:/etc/sushy/htpasswd:ro
Volume=/run/libvirt:/run/libvirt:rw

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
