{#
  Quadlet definition for one managed name resolution. The container runs as root so
  the declared port is served exactly as authored, and the image entrypoint is
  never used: the frozen request alone decides what runs.
#}
[Unit]
Description=Bootwright managed name resolution {{ bootwright_dns_server_request.identity.service }}
After=network-online.target
Wants=network-online.target

[Container]
Image={{ bootwright_dns_server_request.image }}
ContainerName={{ bootwright_dns_server_request.unit }}
Network=host
User=0
Entrypoint=/usr/sbin/dnsmasq
Exec=--keep-in-foreground --conf-file=/etc/dnsmasq.conf
Volume={{ infra_dns_server_dnsmasq_config_dir }}/dnsmasq.conf:/etc/dnsmasq.conf:ro,Z

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
