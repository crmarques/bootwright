{# Extract the IP-shaped ntpSources entries; DHCP option 42 (RFC 2132)
   carries IPv4 addresses only, so any hostname-only entries are skipped
   here and reach the host via agent-config's additionalNTPSources
   instead. #}
{% set _ntp_ips = ((bootwright_environment.infraComponents | default({})).ntpSources | default([])) | select('match', '^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$') | list %}
<network{% if _ntp_ips %} xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'{% endif %}>
  <name>{{ bootwright_libvirt_network_name }}</name>
  <uuid>{{ bootwright_libvirt_network_uuid }}</uuid>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='{{ bootwright_libvirt_bridge }}' stp='on' delay='0'/>
  {# Disable libvirt's built-in dnsmasq DNS server (sets port=0 in the
     spawned dnsmasq). DHCP still works. Without this, libvirt's
     bind-dynamic dnsmasq grabs :53 on every address aliased onto the
     bridge (gateway + LB VIPs from cluster_infra/network_vips) and
     blocks our podman dnsmasq container, which serves the cluster's
     api/api-int/ingress records. #}
  <dns enable='no'/>
  <ip address='{{ bootwright_libvirt_network.gateway }}' prefix='{{ bootwright_libvirt_network.cidr.split("/") | last }}'>
    <dhcp>
{% for machine in bootwright_current_machines %}
{% set primary = machine.networkConfig.addresses | default([]) | first | default({}) %}
{% set primary_ipv4 = primary.ipv4 | default([]) | first | default({}) %}
{% if (primary.macAddress | default('') | length > 0) and (primary_ipv4.ip | default('') | length > 0) %}
      <host mac='{{ primary.macAddress }}' name='{{ bootwright_current_cluster.name }}-{{ machine.name }}' ip='{{ primary_ipv4.ip }}'/>
{% endif %}
{% endfor %}
    </dhcp>
  </ip>
{% if _ntp_ips %}
  <dnsmasq:options>
    <dnsmasq:option value='dhcp-option=option:ntp-server,{{ _ntp_ips | join(",") }}'/>
  </dnsmasq:options>
{% endif %}
</network>
