---
offline: true

skip_list:
  - yaml
  - var-naming[no-role-prefix]
  - name[play]
  - name[template]
  - run-once[play]
  - run-once[task]
  - no-handler
  - jinja[invalid]
  - meta-runtime[unsupported-version]
  - galaxy[no-changelog]
  - galaxy[no-license]
  - galaxy[no-repository]
  - key-order[task]

warn_list:
  - jinja[spacing]
