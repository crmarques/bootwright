prefix_rule(
    pattern = ["ansible-playbook"],
    decision = "prompt",
    justification = "a playbook run changes a host; the owner asks for it (AGENTS.md)",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "prompt",
    justification = "privileged commands wait for the owner",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "a push waits for the owner (AGENTS.md)",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "a force push is never run by an agent",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "a force push is never run by an agent",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "a hard reset discards work",
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "forbidden",
    justification = "a tag is a release step the owner takes",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "git clean deletes untracked files",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "a rebase rewrites history",
)
