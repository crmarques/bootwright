# Codex approval rules for the commands AGENTS.md forbids an agent to run
# unasked. Codex loads this file from <repo>/.codex/rules/ once the project's
# .codex/ layer is trusted; a session that does not trust the project copies it
# to ~/.codex/rules/. Prefix rules match only the leading words of a command:
#   - the repository binary matches as bootwright, ./bin/bootwright or
#     bin/bootwright; an absolute path, a global flag between the binary and
#     the command, and a flag between a group and its command (render --context
#     c effective) do not match;
#   - a command that is effectful only with a flag (cluster info --secrets,
#     render effective --sensitive) prompts whenever it runs, because a flag
#     after the command cannot be told apart by prefix;
#   - git -C <dir> forms cannot be matched, because a directory is not a literal.
# TestDocsAskRulesCoverEveryEffectfulCommand keeps this file complete against
# the command catalog in specs/cli/commands.md, as it does .claude/settings.json.

prefix_rule(
    pattern = [["bootwright", "./bin/bootwright", "bin/bootwright"], "apply"],
    decision = "prompt",
    justification = "bootwright apply acts beyond a read of local state; the owner asks for it (AGENTS.md)",
)

prefix_rule(
    pattern = [["bootwright", "./bin/bootwright", "bin/bootwright"], "destroy"],
    decision = "prompt",
    justification = "bootwright destroy acts beyond a read of local state; the owner asks for it (AGENTS.md)",
)

prefix_rule(
    pattern = [["bootwright", "./bin/bootwright", "bin/bootwright"], "controller", "install"],
